@section Scripts {
    <script>
        // ── Switch Hero Experience Image & Badges ──
        function switchHeroExperience(type, btn) {
            document.querySelectorAll('.exp-pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');

            const heroCard = document.getElementById('heroVisualCard');
            const badgeTitle1 = document.getElementById('badgeTitle1');
            const badgeDesc1 = document.getElementById('badgeDesc1');
            const badgeTitle2 = document.getElementById('badgeTitle2');
            const badgeDesc2 = document.getElementById('badgeDesc2');

            heroCard.style.opacity = '0.5';

            setTimeout(() => {
                if (type === 'reception') {
                    heroCard.style.backgroundImage = "url('/images/luxury_salon_hero.png')";
                    badgeTitle1.innerText = "Top Rated Salon 2026";
                    badgeDesc1.innerText = "International Beauty Excellence";
                    badgeTitle2.innerText = "100% Organic Therapies";
                    badgeDesc2.innerText = "Pure Botanical Formulations";
                } else if (type === 'hair') {
                    heroCard.style.backgroundImage = "url('/images/stylonyx_hair_hero.png')";
                    badgeTitle1.innerText = "Master Hair Stylist";
                    badgeDesc1.innerText = "Custom Color & Precision Cuts";
                    badgeTitle2.innerText = "Silk Glow Therapy";
                    badgeDesc2.innerText = "Keratin Rejuvenation Finish";
                } else if (type === 'facial') {
                    heroCard.style.backgroundImage = "url('/images/stylonyx_facial_hero.png')";
                    badgeTitle1.innerText = "24K Gold Hydra Facial";
                    badgeDesc1.innerText = "Deep Cellular Rejuvenation";
                    badgeTitle2.innerText = "Aromatherapy Calm";
                    badgeDesc2.innerText = "Volcanic Stone & Oils";
                }
                heroCard.style.opacity = '1';
            }, 200);
        }

        // ── Interactive Addon Price Recalculation ──
        function recalculateServicePrice(cardId, basePrice, checkbox, addonVal) {
            const priceTag = document.getElementById('priceTag' + cardId);
            let currentPrice = parseInt(priceTag.innerText.replace('$', ''));
            if (checkbox.checked) {
                currentPrice += addonVal;
            } else {
                currentPrice -= addonVal;
            }
            priceTag.innerText = '$' + currentPrice;
        }

        // ── Specialist Detail Modal ──
        function viewStylistModal(name, role, rating, imgUrl) {
            Swal.fire({
                title: name,
                text: role + ' • ⭐ ' + rating,
                imageUrl: imgUrl,
                imageWidth: 120,
                imageHeight: 120,
                imageAlt: name,
                html: `
                    <p style="color: var(--teal-light); margin-top: 10px;">Specializes in haute couture styling & organic treatments.</p>
                    <p style="color: #94a3b8; font-size: 0.85rem;">Available slots open for today & tomorrow.</p>
                `,
                showCancelButton: true,
                confirmButtonText: 'Book with ' + name.split(' ')[0],
                cancelButtonText: 'Close',
                background: '#131924',
                color: '#fff',
                confirmButtonColor: '#d4af37'
            }).then((result) => {
                if (result.isConfirmed) {
                    selectStylist(name);
                }
            });
        }

        // ── Gift Card Generator Controls ──
        let currentGiftAmount = 100;
        function updateGiftAmount(amount, btn) {
            document.querySelectorAll('#giftcards .exp-pill').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            currentGiftAmount = amount;
            document.getElementById('cardAmountText').innerText = '$' + amount;
        }

        function updateGiftName(val) {
            document.getElementById('cardRecipientText').innerText = val.trim() ? val : 'Valued Guest';
        }

        function updateGiftTheme(theme, btn) {
            document.querySelectorAll('#giftcards .tab-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const card = document.getElementById('giftCardPreview');
            card.className = 'giftcard-preview-box ' + (theme === 'gold' ? '' : theme);
        }

        function generateGiftPass() {
            const recipient = document.getElementById('cardRecipientText').innerText;
            Swal.fire({
                icon: 'success',
                title: '🎁 VIP Gift Pass Issued!',
                html: `
                    <div style="text-align:left; background:#0b0e14; padding:15px; border-radius:12px; border:1px solid rgba(212,175,55,0.3); margin-top:10px;">
                        <p style="color:#fff; margin-bottom:6px;"><strong>Recipient:</strong> ${recipient}</p>
                        <p style="color:#fff; margin-bottom:6px;"><strong>Pass Value:</strong> $${currentGiftAmount}</p>
                        <p style="color:#2dd4bf; margin-bottom:0;"><strong>Digital Voucher Code:</strong> #STYL-GIFT-${Math.floor(1000 + Math.random() * 9000)}</p>
                    </div>
                `,
                background: '#131924',
                color: '#fff',
                confirmButtonColor: '#d4af37'
            });
        }

        // ── Billing Cycle Switcher ──
        function switchBilling(cycle, btn) {
            document.querySelectorAll('.billing-toggle-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            if (cycle === 'annual') {
                document.getElementById('priceVal1').innerHTML = '$63 <span>/ month</span>';
                document.getElementById('priceVal2').innerHTML = '$119 <span>/ month</span>';
                document.getElementById('priceVal3').innerHTML = '$239 <span>/ month</span>';
            } else {
                document.getElementById('priceVal1').innerHTML = '$79 <span>/ month</span>';
                document.getElementById('priceVal2').innerHTML = '$149 <span>/ month</span>';
                document.getElementById('priceVal3').innerHTML = '$299 <span>/ month</span>';
            }
        }

        // ── Interactive Badge Detail Popups ──
        function showBadgeDetails(badgeType) {
            if (badgeType === 'award') {
                Swal.fire({
                    icon: 'success',
                    title: '🏆 Top Rated Salon 2026',
                    html: '<p style="color:#94a3b8">StylOnyx has been awarded <strong>#1 VIP Salon & Spa</strong> for 2026 by International Beauty Review.</p>',
                    background: '#131924',
                    color: '#fff',
                    confirmButtonColor: '#d4af37'
                });
            } else if (badgeType === 'organic') {
                Swal.fire({
                    icon: 'info',
                    title: '🌿 100% Organic Botanical Guarantee',
                    html: '<p style="color:#94a3b8">All serums, oils, and hair masks at StylOnyx are 100% cruelty-free and certified organic.</p>',
                    background: '#131924',
                    color: '#fff',
                    confirmButtonColor: '#0d9488'
                });
            }
        }

        // ── 3D Tilt Effect on Mouse Movement ──
        document.addEventListener("DOMContentLoaded", function () {
            const heroRight = document.querySelector('.hero-right');
            const heroVisualCard = document.getElementById('heroVisualCard');

            if (heroRight && heroVisualCard) {
                heroRight.addEventListener('mousemove', (e) => {
                    const rect = heroRight.getBoundingClientRect();
                    const x = e.clientX - rect.left - rect.width / 2;
                    const y = e.clientY - rect.top - rect.height / 2;

                    const rotateX = (y / rect.height) * -12;
                    const rotateY = (x / rect.width) * 12;

                    heroVisualCard.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale(1.02)`;
                });

                heroRight.addEventListener('mouseleave', () => {
                    heroVisualCard.style.transform = 'rotateX(0deg) rotateY(0deg) scale(1)';
                });
            }

            // ── Scroll-triggered Number Counter Animation ──
            const statNumbers = document.querySelectorAll(".stat-number");
            let animated = false;

            function animateCounters() {
                statNumbers.forEach(counter => {
                    const target = parseFloat(counter.getAttribute("data-target"));
                    const suffix = counter.getAttribute("data-suffix") || "";
                    const decimals = parseInt(counter.getAttribute("data-decimals") || "0");
                    const formatComma = counter.getAttribute("data-format") === "comma";
                    const duration = 2000;
                    const startTime = performance.now();

                    counter.innerText = (decimals > 0 ? (0).toFixed(decimals) : "0") + suffix;

                    function updateNumber(currentTime) {
                        const elapsedTime = currentTime - startTime;
                        const progress = Math.min(elapsedTime / duration, 1);
                        const easeProgress = 1 - Math.pow(1 - progress, 3);
                        const currentValue = easeProgress * target;

                        let formattedVal = currentValue.toFixed(decimals);
                        if (formatComma) {
                            formattedVal = Math.floor(currentValue).toLocaleString('en-US');
                        }

                        counter.innerText = formattedVal + suffix;

                        if (progress < 1) {
                            requestAnimationFrame(updateNumber);
                        } else {
                            let finalVal = decimals > 0 ? target.toFixed(decimals) : (formatComma ? Math.floor(target).toLocaleString('en-US') : target);
                            counter.innerText = finalVal + suffix;
                        }
                    }

                    requestAnimationFrame(updateNumber);
                });
            }

            const statsSection = document.getElementById("stats");
            if (statsSection) {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting && !animated) {
                            animated = true;
                            animateCounters();
                        }
                    });
                }, { threshold: 0.15 });

                observer.observe(statsSection);
            }
        });

        function filterServices(category, btn) {
            const tabs = document.querySelectorAll('.tab-btn');
            tabs.forEach(t => t.classList.remove('active'));
            btn.classList.add('active');

            const cards = document.querySelectorAll('.service-card');
            cards.forEach(card => {
                if (category === 'all' || card.getAttribute('data-category') === category) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function openBookingModal() {
            document.getElementById('bookingModal').classList.add('active');
        }

        function closeBookingModal() {
            document.getElementById('bookingModal').classList.remove('active');
        }

        function quickBook(serviceName, price) {
            document.getElementById('modalService').value = serviceName;
            openBookingModal();
        }

        function selectStylist(stylistName) {
            document.getElementById('modalStylist').value = stylistName;
            openBookingModal();
        }

        function joinMembership(tierName) {
            Swal.fire({
                icon: 'info',
                title: 'Join ' + tierName,
                text: 'To activate your VIP membership perks, please log into your account or register.',
                showCancelButton: true,
                confirmButtonText: 'Log In Now',
                cancelButtonText: 'Close',
                background: '#131924',
                color: '#fff',
                confirmButtonColor: '#d4af37'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/Login';
                }
            });
        }

        function handleBookingSubmit(e) {
            e.preventDefault();
            const name = document.getElementById('modalName').value;
            const service = document.getElementById('modalService').value;
            const date = document.getElementById('modalDate').value;
            const code = '#STYL-' + Math.floor(1000 + Math.random() * 9000);

            closeBookingModal();

            Swal.fire({
                icon: 'success',
                title: 'VIP Appointment Confirmed!',
                html: `
                    <div style="text-align:left; background:#0b0e14; padding:15px; border-radius:12px; border:1px solid rgba(212,175,55,0.3); margin-top:10px;">
                        <p style="margin-bottom:6px; color:#fff;"><strong>Guest Name:</strong> ${name}</p>
                        <p style="margin-bottom:6px; color:#fff;"><strong>Treatment:</strong> ${service}</p>
                        <p style="margin-bottom:6px; color:#fff;"><strong>Date:</strong> ${date}</p>
                        <p style="margin-bottom:0; color:#2dd4bf;"><strong>Booking Ref:</strong> ${code}</p>
                    </div>
                    <p style="font-size:0.85rem; color:#94a3b8; margin-top:12px;">A confirmation reminder has been prepared for your appointment.</p>
                `,
                background: '#131924',
                color: '#fff',
                confirmButtonColor: '#d4af37'
            });
        }
    </script>
}
