@{
    Layout = "~/Views/Shared/_LandingLayout.cshtml";
    ViewData["Title"] = "StylOnyx &mdash; Haute Beauty & VIP Spa Experience";
}

@section Styles {
    <style>
        /* ── Hero Section ── */
        .hero-section {
            padding: 160px 0 100px 0;
            max-width: 1280px;
            margin: 0 auto;
            padding-left: 24px;
            padding-right: 24px;
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: 60px;
            align-items: center;
            min-height: 90vh;
            position: relative;
        }

        .hero-left {
            position: relative;
            z-index: 2;
        }

        .vip-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(20, 184, 166, 0.12);
            border: 1px solid var(--border-teal);
            padding: 8px 18px;
            border-radius: 50px;
            color: var(--teal-light);
            font-family: var(--font-sans);
            font-size: 0.82rem;
            font-weight: 600;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 24px;
            box-shadow: 0 0 15px rgba(20, 184, 166, 0.15);
        }

        .pulse-dot {
            width: 8px;
            height: 8px;
            background-color: var(--teal-glow);
            border-radius: 50%;
            box-shadow: 0 0 10px var(--teal-light);
            animation: pulseGlow 2s infinite;
        }

        @@keyframes pulseGlow {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(45, 212, 191, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(45, 212, 191, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(45, 212, 191, 0); }
        }

        .hero-title {
            font-family: var(--font-display);
            font-size: 3.8rem;
            font-weight: 700;
            line-height: 1.15;
            margin-bottom: 24px;
            background: linear-gradient(135deg, #ffffff 20%, var(--gold-primary) 70%, var(--gold-light) 100%);
            background-size: 200% auto;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: goldShimmer 6s ease-in-out infinite alternate;
            letter-spacing: -0.5px;
        }

        @@keyframes goldShimmer {
            0% { background-position: 0% 50%; }
            100% { background-position: 100% 50%; }
        }

        .hero-subtitle {
            font-size: 1.15rem;
            color: var(--text-body);
            margin-bottom: 36px;
            max-width: 540px;
            line-height: 1.7;
        }

        .hero-actions {
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 48px;
            flex-wrap: wrap;
        }

        .btn-hero-primary {
            padding: 16px 36px;
            border-radius: 50px;
            background: linear-gradient(135deg, var(--gold-primary) 0%, var(--gold-accent) 100%);
            color: #0b0e14;
            font-family: var(--font-sans);
            font-size: 1rem;
            font-weight: 700;
            text-decoration: none;
            border: none;
            cursor: pointer;
            box-shadow: 0 8px 30px rgba(212, 175, 55, 0.4);
            transition: all 0.4s ease;
            display: inline-flex;
            align-items: center;
            gap: 12px;
        }

        .btn-hero-primary:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 12px 35px rgba(20, 184, 166, 0.5);
            background: linear-gradient(135deg, #ffffff 0%, var(--teal-light) 100%);
            color: #0b0e14;
        }

        .btn-hero-glass {
            padding: 15px 32px;
            border-radius: 50px;
            background: rgba(19, 25, 36, 0.6);
            border: 1px solid var(--border-gold);
            color: var(--text-heading);
            font-family: var(--font-sans);
            font-size: 1rem;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .btn-hero-glass:hover {
            border-color: var(--teal-glow);
            background: rgba(20, 184, 166, 0.15);
            color: var(--teal-light);
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(20, 184, 166, 0.2);
        }

        .social-proof-bar {
            display: flex;
            align-items: center;
            gap: 16px;
            background: rgba(19, 25, 36, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 12px 24px;
            border-radius: 50px;
            width: fit-content;
        }

        .avatar-stack {
            display: flex;
            align-items: center;
        }

        .avatar-stack img {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            border: 2px solid var(--bg-deep-dark);
            margin-left: -12px;
            object-fit: cover;
        }

        .avatar-stack img:first-child {
            margin-left: 0;
        }

        .proof-text {
            font-size: 0.88rem;
            color: var(--text-body);
        }

        .proof-text strong {
            color: var(--gold-light);
        }

        .proof-text i {
            color: var(--gold-primary);
        }

        /* ── Right Column & Interactive 3D Card Showcase ── */
        .hero-right {
            position: relative;
            perspective: 1000px;
        }

        .experience-switcher-bar {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 16px;
            z-index: 15;
            position: relative;
        }

        .exp-pill {
            background: rgba(19, 25, 36, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border-gold);
            color: var(--text-body);
            padding: 8px 18px;
            border-radius: 50px;
            font-family: var(--font-sans);
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .exp-pill.active, .exp-pill:hover {
            background: linear-gradient(135deg, var(--gold-primary), var(--gold-accent));
            color: #0b0e14;
            border-color: var(--gold-light);
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.4);
        }

        .hero-visual-card {
            position: relative;
            width: 100%;
            height: 520px;
            border-radius: 24px;
            overflow: hidden;
            border: 1px solid var(--border-gold);
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7), 0 0 35px rgba(212, 175, 55, 0.2);
            background-size: cover;
            background-position: center;
            transition: transform 0.2s ease-out, opacity 0.3s ease, background-image 0.4s ease;
            transform-style: preserve-3d;
        }

        .hero-visual-card::after {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(11, 14, 20, 0.15) 0%, rgba(11, 14, 20, 0.8) 100%);
            pointer-events: none;
        }

        /* Floating Badges with Micro-Interactions */
        .floating-badge {
            position: absolute;
            z-index: 10;
            background: rgba(19, 25, 36, 0.88);
            backdrop-filter: blur(16px);
            border: 1px solid var(--border-gold);
            padding: 12px 20px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
            transition: all 0.3s ease;
            cursor: pointer;
            animation: floatSlow 4s ease-in-out infinite alternate;
        }

        .floating-badge:hover {
            transform: scale(1.05) translateY(-4px);
            border-color: var(--teal-glow);
            box-shadow: 0 15px 35px rgba(20, 184, 166, 0.3);
        }

        .badge-1 { top: 24px; left: 24px; }
        .badge-2 { bottom: 24px; right: 24px; animation-delay: 2s; }
        .badge-3 { top: 24px; right: 24px; animation-delay: 1s; }

        @@keyframes floatSlow {
            0% { transform: translateY(0px); }
            100% { transform: translateY(-10px); }
        }

        .badge-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: rgba(212, 175, 55, 0.15);
            color: var(--gold-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
        }

        .badge-info h5 {
            font-size: 0.88rem;
            color: #fff;
            margin: 0;
        }

        .badge-info p {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin: 0;
        }

        /* ── Animated Stats Ribbon ── */
        .stats-ribbon {
            background: linear-gradient(90deg, #0d131e 0%, #131924 50%, #0d131e 100%);
            border-top: 1px solid var(--border-gold);
            border-bottom: 1px solid var(--border-gold);
            padding: 40px 0;
            margin: 60px 0;
            position: relative;
        }

        .stats-grid {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 30px;
        }

        .stat-card {
            background: rgba(19, 25, 36, 0.4);
            border: 1px solid rgba(212, 175, 55, 0.15);
            border-radius: 16px;
            padding: 24px;
            text-align: center;
            transition: all 0.3s ease;
        }

        .stat-card:hover {
            border-color: var(--teal-glow);
            transform: translateY(-5px);
            background: rgba(20, 184, 166, 0.08);
            box-shadow: 0 10px 25px rgba(20, 184, 166, 0.15);
        }

        .stat-number {
            font-family: var(--font-display);
            font-size: 2.8rem;
            font-weight: 700;
            color: var(--gold-primary);
            margin-bottom: 6px;
            background: linear-gradient(135deg, var(--gold-fixed) 0%, var(--gold-accent) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .stat-label {
            font-family: var(--font-sans);
            font-size: 0.85rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        /* ── Bespoke Services Showcase Grid ── */
        .section-padding {
            padding: 80px 0;
            max-width: 1280px;
            margin: 0 auto;
            padding-left: 24px;
            padding-right: 24px;
        }

        .section-header {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title-sub {
            font-family: var(--font-sans);
            color: var(--teal-light);
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 2px;
            text-transform: uppercase;
            display: block;
            margin-bottom: 10px;
        }

        .section-title {
            font-family: var(--font-display);
            font-size: 2.8rem;
            color: var(--text-heading);
            margin-bottom: 16px;
        }

        .section-desc {
            color: var(--text-muted);
            font-size: 1.05rem;
            max-width: 600px;
            margin: 0 auto;
        }

        .filter-tabs {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-bottom: 40px;
            flex-wrap: wrap;
        }

        .tab-btn {
            background: rgba(19, 25, 36, 0.6);
            border: 1px solid var(--border-gold);
            color: var(--text-body);
            padding: 10px 22px;
            border-radius: 50px;
            font-family: var(--font-sans);
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .tab-btn.active, .tab-btn:hover {
            background: var(--teal-primary);
            border-color: var(--teal-glow);
            color: #fff;
            box-shadow: 0 0 15px rgba(20, 184, 166, 0.4);
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
        }

        .service-card {
            background: var(--bg-card-dark);
            border: 1px solid var(--border-gold);
            border-radius: 20px;
            overflow: hidden;
            transition: all 0.4s ease;
            display: flex;
            flex-direction: column;
            position: relative;
        }

        .service-card:hover {
            border-color: var(--teal-glow);
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(20, 184, 166, 0.2);
        }

        .service-img {
            height: 200px;
            width: 100%;
            object-fit: cover;
            position: relative;
        }

        .service-price-tag {
            position: absolute;
            top: 16px;
            right: 16px;
            background: rgba(11, 14, 20, 0.85);
            backdrop-filter: blur(10px);
            border: 1px solid var(--gold-accent);
            color: var(--gold-fixed);
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 1.1rem;
            padding: 6px 14px;
            border-radius: 50px;
        }

        .service-body {
            padding: 24px;
            display: flex;
            flex-direction: column;
            flex-grow: 1;
        }

        .service-meta {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
            font-size: 0.8rem;
            color: var(--teal-light);
            font-family: var(--font-sans);
        }

        .service-title {
            font-family: var(--font-display);
            font-size: 1.4rem;
            color: var(--text-heading);
            margin-bottom: 10px;
        }

        .service-desc {
            color: var(--text-muted);
            font-size: 0.9rem;
            margin-bottom: 20px;
            line-height: 1.6;
        }

        .service-addon-list {
            margin-bottom: 16px;
            background: rgba(11, 14, 20, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 12px;
            padding: 10px 14px;
        }

        .addon-label {
            font-size: 0.75rem;
            color: var(--gold-primary);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 6px;
            display: block;
        }

        .addon-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.82rem;
            color: var(--text-body);
            cursor: pointer;
            margin-bottom: 4px;
        }

        .btn-service-book {
            width: 100%;
            background: transparent;
            border: 1px solid var(--border-gold);
            color: var(--gold-primary);
            padding: 12px;
            border-radius: 12px;
            font-family: var(--font-sans);
            font-size: 0.88rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-service-book:hover {
            background: var(--gold-accent);
            color: #0b0e14;
            box-shadow: 0 0 20px rgba(212, 175, 55, 0.4);
        }

        /* ── Specialist Showcase ── */
        .specialist-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 24px;
        }

        .specialist-card {
            background: var(--bg-card-dark);
            border: 1px solid var(--border-gold);
            border-radius: 20px;
            padding: 24px;
            text-align: center;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .specialist-card:hover {
            border-color: var(--teal-glow);
            transform: translateY(-6px);
            box-shadow: 0 10px 30px rgba(20, 184, 166, 0.2);
        }

        .specialist-avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            margin: 0 auto 16px auto;
            border: 2px solid var(--gold-accent);
            padding: 4px;
            background: var(--bg-surface);
            object-fit: cover;
        }

        .specialist-name {
            font-family: var(--font-display);
            font-size: 1.25rem;
            color: #fff;
            margin-bottom: 4px;
        }

        .specialist-role {
            color: var(--teal-light);
            font-size: 0.82rem;
            font-family: var(--font-sans);
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 12px;
        }

        .specialist-rating {
            color: var(--gold-primary);
            font-size: 0.85rem;
            margin-bottom: 16px;
        }

        /* ── Interactive Gift Card Generator ── */
        .giftcard-container {
            background: linear-gradient(135deg, #131924 0%, #0d131e 100%);
            border: 1px solid var(--border-gold);
            border-radius: 28px;
            padding: 48px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            align-items: center;
            box-shadow: 0 20px 50px rgba(0,0,0,0.6);
        }

        .giftcard-preview-box {
            background: linear-gradient(135deg, var(--gold-primary) 0%, var(--gold-accent) 100%);
            border-radius: 24px;
            height: 260px;
            padding: 28px;
            color: #0b0e14;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 15px 35px rgba(212, 175, 55, 0.4);
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
        }

        .giftcard-preview-box.emerald {
            background: linear-gradient(135deg, var(--teal-glow) 0%, #064e3b 100%);
            color: #fff;
            box-shadow: 0 15px 35px rgba(20, 184, 166, 0.4);
        }

        .giftcard-preview-box.obsidian {
            background: linear-gradient(135deg, #1f2937 0%, #0b0e14 100%);
            color: var(--gold-primary);
            border: 1px solid var(--border-gold-bright);
            box-shadow: 0 15px 35px rgba(0,0,0,0.8);
        }

        /* ── VIP Membership Section ── */
        .billing-toggle-bar {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 16px;
            margin-bottom: 40px;
        }

        .billing-toggle-btn {
            background: rgba(19, 25, 36, 0.8);
            border: 1px solid var(--border-gold);
            color: var(--text-body);
            padding: 10px 24px;
            border-radius: 50px;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .billing-toggle-btn.active {
            background: var(--gold-accent);
            color: #0b0e14;
            font-weight: 700;
            box-shadow: 0 0 15px rgba(212,175,55,0.4);
        }

        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 30px;
        }

        .price-card {
            background: var(--bg-card-dark);
            border: 1px solid var(--border-gold);
            border-radius: 24px;
            padding: 36px 28px;
            position: relative;
            transition: all 0.3s ease;
        }

        .price-card.popular {
            border-color: var(--gold-accent);
            background: linear-gradient(180deg, #18202d 0%, #131924 100%);
            box-shadow: 0 0 35px rgba(212, 175, 55, 0.25);
            transform: scale(1.03);
        }

        .popular-badge {
            position: absolute;
            top: -14px;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(135deg, var(--gold-primary), var(--gold-accent));
            color: #0b0e14;
            font-family: var(--font-sans);
            font-size: 0.75rem;
            font-weight: 800;
            padding: 4px 16px;
            border-radius: 50px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .price-title {
            font-family: var(--font-display);
            font-size: 1.6rem;
            color: #fff;
            margin-bottom: 8px;
        }

        .price-val {
            font-family: var(--font-display);
            font-size: 3rem;
            color: var(--gold-primary);
            font-weight: 700;
            margin-bottom: 20px;
        }

        .price-val span {
            font-size: 1rem;
            color: var(--text-muted);
            font-family: var(--font-body);
        }

        /* ── Modal Popup ── */
        .modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(6, 8, 13, 0.85);
            backdrop-filter: blur(16px);
            z-index: 2000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal-container {
            background: var(--bg-card-dark);
            border: 1px solid var(--border-gold-bright);
            border-radius: 24px;
            width: 100%;
            max-width: 600px;
            padding: 36px;
            position: relative;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.8);
        }

        .modal-close {
            position: absolute;
            top: 20px;
            right: 20px;
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-size: 1.4rem;
            cursor: pointer;
        }

        .modal-close:hover { color: #fff; }

        /* Responsive Adjustments */
        @@media (max-width: 992px) {
            .hero-section { grid-template-columns: 1fr; padding-top: 130px; }
            .stats-grid { grid-template-columns: repeat(2, 1fr); }
            .services-grid { grid-template-columns: 1fr 1fr; }
            .specialist-grid { grid-template-columns: 1fr 1fr; }
            .pricing-grid { grid-template-columns: 1fr; }
            .giftcard-container { grid-template-columns: 1fr; }
            .badge-1, .badge-2, .badge-3 { display: none; }
        }
        @@media (max-width: 600px) {
            .hero-title { font-size: 2.6rem; }
            .stats-grid { grid-template-columns: 1fr; }
            .services-grid { grid-template-columns: 1fr; }
            .specialist-grid { grid-template-columns: 1fr; }
        }
    </style>
}

<!-- ── HERO SECTION ── -->
<section class="hero-section" id="hero">
    <div class="hero-left">
        <div class="vip-badge">
            <span class="pulse-dot"></span>
            Haute Beauty & Spa Experience
        </div>
        <h1 class="hero-title">
            Unveil Your Timeless Radiance & Elegance
        </h1>
        <p class="hero-subtitle">
            Indulge in bespoke hair couture, luxury facial rejuvenation, and organic spa therapies administered by world-class specialists in a private sanctuary.
        </p>

        <div class="hero-actions">
            <button class="btn-hero-primary" onclick="openBookingModal()">
                <i class="fa-solid fa-sparkles"></i> Instant VIP Booking
            </button>
            <a href="#services" class="btn-hero-glass">
                <i class="fa-solid fa-compass"></i> Explore Services
            </a>
        </div>

        <div class="social-proof-bar">
            <div class="avatar-stack">
                <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80" alt="Client" />
                <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=100&auto=format&fit=crop&q=80" alt="Client" />
