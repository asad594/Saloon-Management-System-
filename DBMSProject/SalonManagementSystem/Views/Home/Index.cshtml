@section Scripts {
    <script>
        function updateEstimate() {
            const select = document.getElementById('quickServiceSelect');
            const val = select.value.split('|');
            document.getElementById('quickEstPrice').innerText = '$' + val[0];
            document.getElementById('quickEstDuration').innerText = val[1] + ' Mins';
        }

        function filterServices(category, btn) {
            const tabs = document.querySelectorAll('.tab-btn');
            tabs.forEach(t => t.classList.remove('active'));
            btn.classList.add('active');

            const cards = document.querySelectorAll('.service-card');
            cards.forEach(card => {
                if (category === 'all' || card.getAttribute('data-category') === category) {
                    card.style.display = 'flex';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        function openBookingModal() {
            document.getElementById('bookingModal').classList.add('active');
        }

        function closeBookingModal() {
            document.getElementById('bookingModal').classList.remove('active');
        }

        function quickBook(serviceName, price) {
            document.getElementById('modalService').value = serviceName;
            openBookingModal();
        }

        function selectStylist(stylistName) {
            document.getElementById('modalStylist').value = stylistName;
            openBookingModal();
        }

        function joinMembership(tierName) {
            Swal.fire({
                icon: 'info',
                title: 'Join ' + tierName,
                text: 'To activate your VIP membership perks, please log into your account or register.',
                showCancelButton: true,
                confirmButtonText: 'Log In Now',
                cancelButtonText: 'Close',
                background: '#131924',
                color: '#fff',
                confirmButtonColor: '#d4af37'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '/Login';
                }
            });
        }

        function confirmQuickBooking() {
            const serviceText = document.getElementById('quickServiceSelect').options[document.getElementById('quickServiceSelect').selectedIndex].text;
            const date = document.getElementById('quickDate').value;

            Swal.fire({
                icon: 'success',
                title: 'Slot Reserved!',
                html: `<p style="color:#94a3b8">Your quick slot for <strong style="color:#d4af37">${serviceText}</strong> on <strong>${date}</strong> has been tentatively held.</p><p style="color:#2dd4bf; margin-top:10px;">Reference Code: #STYL-${Math.floor(1000 + Math.random() * 9000)}</p>`,
                background: '#131924',
                color: '#fff',
