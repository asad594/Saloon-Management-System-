<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>StylOnyx Luxury Salon &mdash; Timeless Radiance & Bespoke Spa Experience</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;0,800;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <!-- FontAwesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- SweetAlert2 CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg-deep-dark: #0b0e14;
            --bg-surface: #0d131e;
            --bg-card-dark: #131924;
            --bg-card-hover: #1a202b;
            --teal-primary: #0d9488;
            --teal-glow: #14b8a6;
            --teal-light: #2dd4bf;
            --gold-primary: #f2ca50;
            --gold-accent: #d4af37;
            --gold-light: #fef08a;
            --gold-fixed: #ffe088;
            --border-gold: rgba(212, 175, 55, 0.25);
            --border-gold-bright: rgba(212, 175, 55, 0.5);
            --border-teal: rgba(20, 184, 166, 0.3);
            --text-heading: #ffffff;
            --text-body: #dde2f2;
            --text-muted: #94a3b8;
            --text-gold: #f2ca50;
            --font-display: 'Playfair Display', serif;
            --font-body: 'Plus Jakarta Sans', sans-serif;
            --font-sans: 'Montserrat', sans-serif;
        }

        html {
            scroll-behavior: smooth;
            font-size: 17.5px;
        }

        body {
            font-family: var(--font-body);
            background-color: var(--bg-deep-dark);
            color: var(--text-body);
            overflow-x: hidden;
            line-height: 1.6;
            font-size: 1.02rem;
        }

        input, select, textarea {
            font-size: 1.08rem !important;
            font-weight: 600 !important;
            color: #ffffff !important;
        }

        input::placeholder, select::placeholder, textarea::placeholder {
            color: rgba(255, 255, 255, 0.45) !important;
            font-size: 0.98rem !important;
            font-weight: 400 !important;
        }

        /* ── Ambient Background Glows ── */
        .ambient-orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(140px);
            pointer-events: none;
            z-index: 0;
            opacity: 0.35;
        }
        .orb-1 {
            top: -10%;
            left: -10%;
            width: 50vw;
            height: 50vw;
            background: radial-gradient(circle, rgba(13,148,136,0.4) 0%, rgba(11,14,20,0) 70%);
        }
        .orb-2 {
            top: 40%;
            right: -15%;
            width: 45vw;
            height: 45vw;
            background: radial-gradient(circle, rgba(212,175,55,0.25) 0%, rgba(11,14,20,0) 70%);
        }
        .orb-3 {
            bottom: -10%;
            left: 20%;
            width: 40vw;
            height: 40vw;
            background: radial-gradient(circle, rgba(20,184,166,0.25) 0%, rgba(11,14,20,0) 70%);
        }

        /* ── Floating Navbar ── */
        .navbar-floating {
            position: fixed;
            top: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: 90%;
            max-width: 1280px;
            z-index: 1000;
            background: rgba(19, 25, 36, 0.75);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid var(--border-gold);
            border-radius: 100px;
            padding: 12px 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4), 0 0 20px rgba(212, 175, 55, 0.1);
            transition: all 0.4s ease;
        }
        .navbar-floating.scrolled {
            top: 10px;
            background: rgba(13, 19, 30, 0.92);
            border-color: var(--teal-primary);
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6), 0 0 25px rgba(20, 184, 166, 0.2);
        }

        .brand-logo {
            display: flex;
            align-items: center;
            gap: 14px;
            text-decoration: none;
            color: var(--text-heading);
        }
        .brand-logo .logo-icon {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: linear-gradient(135deg, var(--teal-primary) 0%, var(--gold-accent) 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 1.25rem;
            box-shadow: 0 0 18px rgba(13, 148, 136, 0.5), 0 0 10px rgba(212, 175, 55, 0.3);
        }
        .brand-logo .brand-text {
            font-family: var(--font-display);
            font-size: 1.55rem;
            font-weight: 700;
            letter-spacing: 0.5px;
        }
        .brand-logo .brand-text-styl {
            color: #ffffff;
        }
        .brand-logo .brand-text-onyx {
            color: var(--gold-primary);
        }
        .brand-logo .brand-sub {
            font-family: var(--font-sans);
            font-size: 0.62rem;
            letter-spacing: 2px;
            color: var(--teal-light);
            text-transform: uppercase;
            display: block;
            margin-top: -4px;
        }

        .nav-menu {
            display: flex;
            align-items: center;
            gap: 32px;
            list-style: none;
        }
        .nav-link-custom {
            text-decoration: none;
            color: var(--text-body);
            font-family: var(--font-sans);
            font-size: 0.9rem;
            font-weight: 500;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
            position: relative;
            padding: 6px 0;
        }
        .nav-link-custom::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: linear-gradient(90deg, var(--gold-accent), var(--teal-glow));
            transition: width 0.3s ease;
            border-radius: 2px;
        }
        .nav-link-custom:hover {
            color: var(--gold-light);
        }
        .nav-link-custom:hover::after {
            width: 100%;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 14px;
        }
        .btn-portal {
            text-decoration: none;
            color: var(--text-heading);
            border: 1px solid var(--border-gold);
            padding: 9px 20px;
            border-radius: 50px;
            font-family: var(--font-sans);
            font-size: 0.85rem;
            font-weight: 600;
            transition: all 0.3s ease;
            background: rgba(212, 175, 55, 0.08);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn-portal:hover {
            border-color: var(--gold-primary);
            background: rgba(212, 175, 55, 0.2);
            color: var(--gold-light);
            box-shadow: 0 0 15px rgba(212, 175, 55, 0.3);
            transform: translateY(-2px);
        }

        .btn-book-now {
            text-decoration: none;
            color: #0b0e14;
            background: linear-gradient(135deg, var(--gold-primary) 0%, var(--gold-accent) 100%);
            padding: 10px 24px;
            border-radius: 50px;
            font-family: var(--font-sans);
            font-size: 0.88rem;
            font-weight: 700;
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px rgba(212, 175, 55, 0.35);
            display: inline-flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            border: none;
        }
        .btn-book-now:hover {
            background: linear-gradient(135deg, #ffffff 0%, var(--teal-light) 100%);
            box-shadow: 0 6px 25px rgba(45, 212, 191, 0.5);
            transform: translateY(-2px);
            color: #0b0e14;
        }

        /* ── Floating Quick Action Pill ── */
        .floating-action-bar {
            position: fixed;
            bottom: 30px;
            right: 30px;
            z-index: 1500;
            display: flex;
            flex-direction: column;
            gap: 12px;
            align-items: flex-end;
        }

        .action-circle-btn {
            width: 50px;
            height: 50px;
            border-radius: 50%;
            background: rgba(19, 25, 36, 0.9);
            border: 1px solid var(--border-gold);
            color: var(--gold-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(16px);
            transition: all 0.3s ease;
        }

        .action-circle-btn:hover {
            transform: scale(1.1) translateY(-3px);
            border-color: var(--teal-glow);
            color: var(--teal-light);
            box-shadow: 0 0 20px rgba(20, 184, 166, 0.4);
        }

        /* ── Main Container ── */
        main {
            position: relative;
            z-index: 1;
        }

        /* ── Footer ── */
        .luxury-footer {
            background: linear-gradient(180deg, #0d131e 0%, #06080d 100%);
            border-top: 1px solid var(--border-gold);
            padding: 80px 0 30px 0;
            position: relative;
            z-index: 1;
        }
        .footer-container {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1.5fr;
            gap: 40px;
        }
        .footer-col h4 {
            font-family: var(--font-display);
            color: var(--gold-primary);
            font-size: 1.2rem;
            margin-bottom: 20px;
            position: relative;
        }
        .footer-col p {
            color: var(--text-muted);
            font-size: 0.95rem;
            margin-bottom: 16px;
        }
        .footer-links {
            list-style: none;
        }
        .footer-links li {
            margin-bottom: 12px;
        }
        .footer-links a {
            color: var(--text-body);
            text-decoration: none;
            font-size: 0.9rem;
            transition: color 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .footer-links a:hover {
            color: var(--teal-light);
        }
        .newsletter-box {
            display: flex;
            margin-top: 15px;
            background: var(--bg-card-dark);
            border: 1px solid var(--border-gold);
            border-radius: 50px;
            padding: 4px 6px 4px 18px;
        }
        .newsletter-box input {
            background: transparent;
            border: none;
            outline: none;
            color: var(--text-heading);
            font-family: var(--font-body);
            font-size: 0.88rem;
            width: 100%;
        }
        .newsletter-box button {
            background: var(--teal-primary);
            border: none;
            color: #fff;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            cursor: pointer;
            transition: background 0.3s ease;
        }
        .newsletter-box button:hover {
            background: var(--teal-glow);
        }
        .footer-bottom {
            max-width: 1280px;
            margin: 60px auto 0 auto;
            padding: 24px;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: var(--text-muted);
            font-size: 0.85rem;
        }

        /* ── Responsive adjustments ── */
        @@media (max-width: 992px) {
            .nav-menu { display: none; }
            .footer-container { grid-template-columns: 1fr 1fr; }
        }
        @@media (max-width: 600px) {
            .navbar-floating { padding: 10px 16px; width: 94%; }
            .footer-container { grid-template-columns: 1fr; }
            .footer-bottom { flex-direction: column; gap: 12px; text-align: center; }
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    @{
        var userId = Context.Session.GetInt32("UserID");
        var userRole = Context.Session.GetString("Role");
        var userName = Context.Session.GetString("UserName");
        bool isLoggedIn = userId.HasValue;
    }

    <!-- Ambient Background Lighting -->
    <div class="ambient-orb orb-1"></div>
    <div class="ambient-orb orb-2"></div>
    <div class="ambient-orb orb-3"></div>

    <!-- HTML5 Particle Canvas -->
    <canvas id="globalCanvas" style="position:fixed; top:0; left:0; width:100%; height:100%; pointer-events:none; z-index:0;"></canvas>

    <!-- Floating Quick Action Bar -->
    <div class="floating-action-bar">
        <button class="action-circle-btn" onclick="scrollToTop()" title="Scroll to Top">
            <i class="fa-solid fa-arrow-up"></i>
        </button>
    </div>

    <!-- Floating Glass Navbar -->
    <nav class="navbar-floating" id="mainNav">
        <a href="#hero" class="brand-logo">
            <div class="logo-icon">
                <i class="fa-solid fa-scissors"></i>
            </div>
            <div>
                <span class="brand-text"><span class="brand-text-styl">Styl</span><span class="brand-text-onyx">Onyx</span></span>
                <span class="brand-sub">LUXURY & SPA STUDIO</span>
            </div>
        </a>

        <ul class="nav-menu">
            <li><a href="#hero" class="nav-link-custom">Home</a></li>
            <li><a href="#services" class="nav-link-custom">Bespoke Services</a></li>
            <li><a href="#specialists" class="nav-link-custom">Specialists</a></li>
            <li><a href="#giftcards" class="nav-link-custom">Gift Cards</a></li>
            <li><a href="#vip-lounge" class="nav-link-custom">VIP Membership</a></li>
            <li><a href="#testimonials" class="nav-link-custom">Reviews</a></li>
        </ul>

        <div class="nav-actions">
            @if (isLoggedIn)
            {
                <span style="color: var(--teal-light); font-size: 0.88rem; font-weight: 600; display: inline-flex; align-items: center; gap: 6px;">
                    <i class="fa-solid fa-circle-user" style="font-size: 1.1rem; color: var(--gold-primary);"></i> @userName
                </span>
                <a href="@(userRole == "Admin" ? "/Admin/Home" : "/Staff/Home")" class="btn-portal" style="border-color: var(--teal-glow);">
                    <i class="fa-solid fa-gauge"></i> Dashboard
                </a>
                <a href="/Login/Logout" class="btn-portal" style="border-color: rgba(239, 68, 68, 0.4); color: #f87171;">
                    <i class="fa-solid fa-right-from-bracket"></i> Logout
                </a>
            }
            else
            {
                <a href="/Login" class="btn-portal">
                    <i class="fa-solid fa-user-lock"></i> Portal Login
                </a>
                <button class="btn-book-now" onclick="openBookingModal()">
                    <i class="fa-solid fa-calendar-check"></i> Book VIP
                </button>
            }
        </div>
    </nav>

    <!-- Main Render Body -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Luxury Footer -->
    <footer class="luxury-footer">
        <div class="footer-container">
            <div class="footer-col">
                <div class="brand-logo" style="margin-bottom: 20px;">
                    <div class="logo-icon"><i class="fa-solid fa-scissors"></i></div>
                    <div>
                        <span class="brand-text"><span class="brand-text-styl">Styl</span><span class="brand-text-onyx">Onyx</span></span>
                        <span class="brand-sub">HAUTE BEAUTY & SPA</span>
                    </div>
                </div>
                <p>Redefining luxury salon management & VIP treatment experiences. Crafting timeless beauty with master artistry and organic spa therapies.</p>
                <p style="color: var(--gold-primary); font-size: 0.9rem;"><i class="fa-solid fa-clock"></i> Mon &ndash; Sun: 09:00 AM &ndash; 10:00 PM</p>
            </div>

            <div class="footer-col">
                <h4>Quick Links</h4>
                <ul class="footer-links">
                    <li><a href="#services"><i class="fa-solid fa-angle-right"></i> Hair Styling & Color</a></li>
                    <li><a href="#services"><i class="fa-solid fa-angle-right"></i> Skincare & Facials</a></li>
                    <li><a href="#services"><i class="fa-solid fa-angle-right"></i> Nail Couture</a></li>
                    <li><a href="#services"><i class="fa-solid fa-angle-right"></i> Aromatherapy Spa</a></li>
                    <li><a href="/Login"><i class="fa-solid fa-angle-right"></i> Staff & Admin Portal</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>VIP Concierge</h4>
                <ul class="footer-links">
                    <li><a href="tel:+18005557895"><i class="fa-solid fa-phone" style="color: var(--teal-light);"></i> +1 (800) 555-STYL</a></li>
                    <li><a href="mailto:vip@stylonyx.com"><i class="fa-solid fa-envelope" style="color: var(--teal-light);"></i> vip@stylonyx.com</a></li>
                    <li><a href="#"><i class="fa-solid fa-location-dot" style="color: var(--gold-accent);"></i> 740 Fifth Avenue, Suite 12, NYC</a></li>
                    <li><a href="/Login/Register"><i class="fa-solid fa-user-plus"></i> Join Staff Portal</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Inner Circle Newsletter</h4>
                <p>Receive exclusive VIP offers, seasonal luxury treatments, and wellness insights.</p>
                <div class="newsletter-box">
                    <input type="email" id="newsletterEmail" placeholder="Enter your email..." />
                    <button onclick="subscribeNewsletter()"><i class="fa-solid fa-paper-plane"></i></button>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div>&copy; 2026 StylOnyx Luxury Salon Management System. All Rights Reserved.</div>
            <div style="display: flex; gap: 20px;">
                <a href="#" style="color: var(--text-muted); text-decoration: none;">Privacy Policy</a>
                <a href="#" style="color: var(--text-muted); text-decoration: none;">Terms of Service</a>
                <a href="#" style="color: var(--text-muted); text-decoration: none;">VIP Concierge</a>
            </div>
        </div>
    </footer>

    <!-- SweetAlert2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Navbar scroll effect
        window.addEventListener('scroll', function () {
            const nav = document.getElementById('mainNav');
            if (window.scrollY > 50) {
                nav.classList.add('scrolled');
            } else {
                nav.classList.remove('scrolled');
            }
        });

        function scrollToTop() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        let isPlayingAudio = false;
        function toggleSpaAudio() {
            const icon = document.getElementById('audioIcon');
            isPlayingAudio = !isPlayingAudio;
            if (isPlayingAudio) {
                icon.className = "fa-solid fa-volume-high";
                icon.style.color = "#2dd4bf";
                Swal.fire({
                    toast: true,
                    position: 'bottom-start',
                    icon: 'info',
                    title: '🎵 Spa Soundscape Active',
                    text: 'Ambient lounge frequency enabled.',
                    showConfirmButton: false,
                    timer: 2500,
                    background: '#131924',
                    color: '#fff'
                });
            } else {
                icon.className = "fa-solid fa-music";
                icon.style.color = "var(--gold-primary)";
            }
        }

        function openConciergeModal() {
            Swal.fire({
                icon: 'question',
                title: '👑 StylOnyx VIP Concierge',
                html: `
                    <div style="text-align:left; background:#0b0e14; padding:15px; border-radius:12px; border:1px solid rgba(212,175,55,0.3); margin-top:10px;">
                        <p style="color:#fff; margin-bottom:8px;"><i class="fa-solid fa-phone" style="color:#2dd4bf;"></i> Direct Line: <strong>+1 (800) 555-STYL</strong></p>
                        <p style="color:#fff; margin-bottom:8px;"><i class="fa-brands fa-whatsapp" style="color:#2dd4bf;"></i> WhatsApp: <strong>+1 (800) 555-9988</strong></p>
                        <p style="color:#94a3b8; font-size:0.85rem; margin-bottom:0;">Our VIP concierge team is online 24/7 to assist with private bookings and custom packages.</p>
                    </div>
                `,
                background: '#131924',
                color: '#fff',
                confirmButtonColor: '#d4af37',
                confirmButtonText: 'Call Now'
            });
        }

        function subscribeNewsletter() {
            const email = document.getElementById('newsletterEmail').value;
            if (!email || email.indexOf('@@') === -1) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Invalid Email',
                    text: 'Please enter a valid email address.',
                    background: '#131924',
                    color: '#fff',
                    confirmButtonColor: '#0d9488'
                });
                return;
            }
            Swal.fire({
                icon: 'success',
                title: 'Welcome to StylOnyx Inner Circle!',
                text: 'Thank you for subscribing. Check your inbox for your 15% VIP welcome voucher.',
                background: '#131924',
                color: '#fff',
                confirmButtonColor: '#d4af37'
            });
            document.getElementById('newsletterEmail').value = '';
        }

        // ── Particle Canvas Background ──
        const canvas = document.getElementById('globalCanvas');
        if (canvas) {
            const ctx = canvas.getContext('2d');
            let width = canvas.width = window.innerWidth;
            let height = canvas.height = window.innerHeight;

            window.addEventListener('resize', () => {
                width = canvas.width = window.innerWidth;
                height = canvas.height = window.innerHeight;
            });

            const particles = [];
            const particleCount = 45;

            for (let i = 0; i < particleCount; i++) {
                particles.push({
                    x: Math.random() * width,
                    y: Math.random() * height,
                    radius: Math.random() * 2 + 1,
                    color: Math.random() > 0.5 ? 'rgba(212, 175, 55, ' : 'rgba(45, 212, 191, ',
                    alpha: Math.random() * 0.5 + 0.2,
                    speedY: Math.random() * 0.4 + 0.1,
                    speedX: Math.random() * 0.2 - 0.1
                });
            }

            function renderParticles() {
                ctx.clearRect(0, 0, width, height);

                particles.forEach(p => {
                    p.y -= p.speedY;
                    p.x += p.speedX;

                    if (p.y < 0) p.y = height;
                    if (p.x < 0) p.x = width;
                    if (p.x > width) p.x = 0;

                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                    ctx.fillStyle = p.color + p.alpha + ')';
                    ctx.fill();
                });

                requestAnimationFrame(renderParticles);
            }

            renderParticles();
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
