@{
    Layout = null;
    var currentPage = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Staff Dashboard - StylOnyx</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <style>
        body { margin: 0; font-family: 'Segoe UI', sans-serif; display: flex; background: linear-gradient(135deg, #131924, #0b0e14); min-height: 100vh; color: #ffffff; }
        .sidebar { 
            width: 250px; 
            height: 100vh; 
            background: linear-gradient(180deg, #131924, #0b0e14); 
            border-right: 1px solid rgba(212, 175, 55, 0.25);
            color: white; 
            padding: 20px 14px; 
            position: fixed; 
            top: 0; bottom: 0; left: 0;
            z-index: 100;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: #d4af37 rgba(15, 23, 42, 0.6);
            box-sizing: border-box;
            transition: transform 0.3s ease;
        }
        .sidebar::-webkit-scrollbar { width: 6px; }
        .sidebar::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.6); }
        .sidebar::-webkit-scrollbar-thumb { background: linear-gradient(180deg, #d4af37, #0d9488); border-radius: 10px; }
        .sidebar h2 { text-align: center; margin-bottom: 24px; color: #d4af37; font-family: 'Playfair Display', serif; }
        .sidebar a { display: flex; align-items: center; gap: 10px; padding: 12px 16px; margin: 6px 0; border-radius: 10px; text-decoration: none; color: #e2e8f0; font-weight: 600; transition: 0.3s; }
        .sidebar a:hover, .sidebar a.active { background: rgba(212, 175, 55, 0.18); color: #d4af37 !important; border: 1px solid rgba(212, 175, 55, 0.3); }
        
        .mobile-header {
            display: none;
            position: sticky;
            top: 0;
            z-index: 90;
            background: #131924;
            border-bottom: 1px solid rgba(212, 175, 55, 0.25);
            padding: 12px 16px;
            align-items: center;
            justify-content: space-between;
            width: 100%;
        }

        .mobile-toggle-btn {
            background: transparent;
            border: 1px solid #d4af37;
            color: #d4af37;
            width: 38px;
            height: 38px;
            border-radius: 8px;
            font-size: 1.1rem;
            cursor: pointer;
        }

        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.7);
            z-index: 95;
        }
        .sidebar-overlay.active { display: block; }

        .main { margin-left: 250px; padding: 30px; width: calc(100% - 250px); box-sizing: border-box; }
        .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; }
        .card { padding: 25px; border-radius: 15px; color: white; font-size: 18px; box-shadow: 0 8px 20px rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); }
        .card h3 { margin: 0; font-size: 28px; }
        .card p { margin: 5px 0 0; }
        .blue { background: linear-gradient(135deg, #1e293b, #0f172a); } 
        .pink { background: linear-gradient(135deg, #be123c, #881337); } 
        .orange { background: linear-gradient(135deg, #c2410c, #7c2d12); }
        .green { background: linear-gradient(135deg, #15803d, #14532d); } 
        .purple { background: linear-gradient(135deg, #6b21a8, #581c87); } 
        .teal { background: linear-gradient(135deg, #0f766e, #115e59); }
        .form-control { display: block; width: 100%; box-sizing: border-box; padding: 12px; margin: 10px 0; border-radius: 8px; border: 1px solid rgba(255,255,255,0.2); background: rgba(255,255,255,0.05); color: #fff; }
        button, .btn { background: linear-gradient(90deg, #0d9488, #d4af37); color: #fff; border: none; padding: 12px 20px; border-radius: 8px; text-decoration: none; cursor: pointer; font-weight: 700; }

        @@media (max-width: 992px) {
            body { flex-direction: column; }
            .sidebar { transform: translateX(-100%); }
            .sidebar.mobile-open { transform: translateX(0); }
            .mobile-header { display: flex; }
            .main { margin-left: 0; width: 100%; padding: 16px; }
        }
    </style>
</head>
<body>
    <div class="mobile-header">
        <button class="mobile-toggle-btn" id="staffMobileBtn"><i class="fa-solid fa-bars"></i></button>
        <span style="font-weight:700; color:#d4af37;">StylOnyx Staff</span>
    </div>
    <div class="sidebar-overlay" id="staffOverlay"></div>
    <div class="sidebar" id="staffSidebar">
        <h2>StylOnyx Staff</h2>
        <a href="/Staff/Home" class="@(currentPage == "Home" ? "active" : "")"><i class="fa-solid fa-house"></i> Home</a>
        <a href="/Staff/BookAppointment" class="@(currentPage == "BookAppointment" ? "active" : "")"><i class="fa-solid fa-calendar-plus"></i> Book Appointment</a>
        <a href="/Staff/GenerateBill" class="@(currentPage == "GenerateBill" ? "active" : "")"><i class="fa-solid fa-receipt"></i> Generate Bill</a>
        <a href="/Staff/Attendance" class="@(currentPage == "Attendance" ? "active" : "")"><i class="fa-solid fa-clock"></i> Attendance</a>
        <a href="/Login/Logout" style="margin-top:20px; color:#fca5a5;"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
    </div>
    <main class="main">
        @RenderBody()
    </main>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        const btn = document.getElementById('staffMobileBtn');
        const sidebar = document.getElementById('staffSidebar');
        const overlay = document.getElementById('staffOverlay');
        if (btn && sidebar && overlay) {
            btn.onclick = () => { sidebar.classList.toggle('mobile-open'); overlay.classList.toggle('active'); };
            overlay.onclick = () => { sidebar.classList.remove('mobile-open'); overlay.classList.remove('active'); };
        }
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
            Swal.fire({
                icon: 'success',
                title: 'Success!',
                text: '@TempData["SuccessMessage"]',
                timer: 3000,
                showConfirmButton: false,
                background: '#131924',
                color: '#fff'
            });
            </text>
        }
    </script>
</body>
</html>
