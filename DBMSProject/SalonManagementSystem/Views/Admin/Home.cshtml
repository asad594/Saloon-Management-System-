@model DashboardModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        /* ── Hero Welcome Banner ── */
        .dashboard-hero {
            background: linear-gradient(135deg, rgba(19, 25, 36, 0.9) 0%, rgba(14, 18, 25, 0.95) 100%);
            border: 1px solid var(--border-gold);
            border-radius: 20px;
            padding: 32px;
            margin-bottom: 32px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .dashboard-hero::before {
            content: '';
            position: absolute;
            top: -50%; right: -10%;
            width: 350px; height: 350px;
            background: radial-gradient(circle, rgba(212, 175, 55, 0.15) 0%, transparent 70%);
            pointer-events: none;
        }

        .hero-text h1 {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 6px;
        }

        .hero-text p {
            font-size: 0.9rem;
            color: var(--text-body);
        }

        .hero-actions-grid {
            display: flex;
            gap: 12px;
            z-index: 2;
        }

        .btn-action-pill {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-gold);
            color: #ffffff;
            padding: 10px 18px;
            border-radius: 50px;
            font-size: 0.84rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

        .btn-action-pill:hover {
            background: linear-gradient(135deg, #d4af37, #0d9488);
            color: #0b0e14;
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(212, 175, 55, 0.3);
        }

        /* ── Metric KPI Cards Grid ── */
        .kpi-cards-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 36px;
        }

        .kpi-card {
            background: rgba(19, 25, 36, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 18px;
            padding: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.35s ease;
            position: relative;
            overflow: hidden;
        }

        .kpi-card:hover {
            transform: translateY(-4px);
            border-color: var(--border-gold);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
        }

        .kpi-card::after {
            content: '';
            position: absolute;
            bottom: 0; left: 0; right: 0;
            height: 3px;
            background: linear-gradient(90deg, #d4af37, #0d9488);
            opacity: 0.8;
        }

        .kpi-data-title {
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--text-body);
            margin-bottom: 8px;
        }

        .kpi-data-value {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            font-weight: 800;
            color: #ffffff;
            line-height: 1;
        }

        .kpi-icon-box {
            width: 52px;
            height: 52px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
        }

        .icon-sales {
            background: rgba(212, 175, 55, 0.15);
            color: #d4af37;
            border: 1px solid rgba(212, 175, 55, 0.3);
        }

        .icon-appts {
            background: rgba(20, 184, 166, 0.15);
            color: #2dd4bf;
            border: 1px solid rgba(20, 184, 166, 0.3);
        }

        .icon-staff {
            background: rgba(168, 85, 247, 0.15);
            color: #c084fc;
            border: 1px solid rgba(168, 85, 247, 0.3);
        }

        .icon-health {
            background: rgba(34, 197, 94, 0.15);
            color: #4ade80;
            border: 1px solid rgba(34, 197, 94, 0.3);
        }

        /* ── Analytics Chart Container ── */
        .chart-panel-card {
            background: rgba(19, 25, 36, 0.7);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border-gold);
            border-radius: 20px;
            padding: 28px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .chart-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
        }

        .chart-title-group h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.3rem;
            font-weight: 700;
            color: #ffffff;
        }

        .chart-title-group p {
            font-size: 0.8rem;
            color: var(--text-body);
        }

        .chart-wrapper {
            position: relative;
            height: 320px;
            width: 100%;
        }

        @@media (max-width: 1200px) {
            .kpi-cards-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
}

<!-- Hero Welcome Header -->
<div class="dashboard-hero">
    <div class="hero-text">
        <h1>Executive Dashboard</h1>
        <p>Real-time analytics and management controls for Salon Management System.</p>
    </div>
    <div class="hero-actions-grid">
        <a href="/Admin/AddStaff" class="btn-action-pill">
            <i class="fa-solid fa-user-plus"></i> Add Staff
        </a>
        <a href="/Admin/AddService" class="btn-action-pill">
            <i class="fa-solid fa-wand-magic-sparkles"></i> Add Service
        </a>
        <a href="/Admin/AddProduct" class="btn-action-pill">
            <i class="fa-solid fa-box-open"></i> Add Product
        </a>
    </div>
</div>

<!-- KPI Cards -->
<div class="kpi-cards-grid">
    <a href="/Admin/DayRevenue" class="kpi-card" style="text-decoration: none;">
        <div>
            <div class="kpi-data-title">Active Day Sales</div>
            <div class="kpi-data-value">PKR @((Model?.TodaySales ?? 0).ToString("N0"))</div>
            <div style="font-size:0.75rem; color:var(--gold-primary); margin-top:4px; font-weight:600;"><i class="fa-solid fa-lock"></i> Close Day & Revenue &rarr;</div>
        </div>
        <div class="kpi-icon-box icon-sales">
            <i class="fa-solid fa-sack-dollar"></i>
        </div>
    </a>

    <div class="kpi-card">
        <div>
            <div class="kpi-data-title">Today's Appointments</div>
            <div class="kpi-data-value">@(Model?.TodayAppointments ?? 0)</div>
        </div>
        <div class="kpi-icon-box icon-appts">
            <i class="fa-solid fa-calendar-check"></i>
        </div>
    </div>

    <div class="kpi-card">
        <div>
            <div class="kpi-data-title">Staff Members Available</div>
            <div class="kpi-data-value">@(Model?.StaffAvailable ?? 0)</div>
        </div>
        <div class="kpi-icon-box icon-staff">
            <i class="fa-solid fa-users"></i>
        </div>
    </div>

    <div class="kpi-card">
        <div>
            <div class="kpi-data-title">System Status</div>
            <div class="kpi-data-value">Active 🟢</div>
        </div>
        <div class="kpi-icon-box icon-health">
            <i class="fa-solid fa-server"></i>
        </div>
    </div>
</div>

<!-- Sales Analytics Chart -->
<div class="chart-panel-card">
    <div class="chart-header">
        <div class="chart-title-group">
            <h3>Weekly Sales Revenue Analytics</h3>
            <p>Monitored daily earnings breakdown</p>
        </div>
    </div>
    <div class="chart-wrapper">
        <canvas id="weeklyChart"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        fetch('/Admin/GetWeeklySales')
        .then(res => res.json())
        .then(data => {
            const labels = data.map(x => x.day);
            const values = data.map(x => x.total);

            const ctx = document.getElementById('weeklyChart').getContext('2d');
            
            // Create smooth gradient line fill
            const gradient = ctx.createLinearGradient(0, 0, 0, 300);
            gradient.addColorStop(0, 'rgba(212, 175, 55, 0.4)');
            gradient.addColorStop(1, 'rgba(13, 148, 136, 0.0)');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Sales Revenue (Rs)',
                        data: values,
                        borderColor: '#d4af37',
                        borderWidth: 3,
                        backgroundColor: gradient,
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: '#2dd4bf',
                        pointBorderColor: '#ffffff',
                        pointRadius: 5,
                        pointHoverRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            labels: {
                                color: '#94a3b8',
                                font: { family: 'Plus Jakarta Sans', size: 12 }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { color: 'rgba(255, 255, 255, 0.05)' },
                            ticks: { color: '#94a3b8' }
                        },
                        y: {
                            grid: { color: 'rgba(255, 255, 255, 0.05)' },
                            ticks: { color: '#94a3b8' }
                        }
                    }
                }
            });
        });
    </script>
}