@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        .form-card-container {
            max-width: 680px;
            margin: 20px auto;
            background: linear-gradient(145deg, #131924 0%, #0e1219 100%);
            border: 1px solid var(--border-gold);
            border-radius: 20px;
            padding: 36px;
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
            position: relative;
        }

        .form-card-container::before {
            content: '';
            position: absolute;
            top: 16px; left: 16px; bottom: 16px; right: 16px;
            border: 1px solid rgba(212, 175, 55, 0.12);
            border-radius: 16px;
            pointer-events: none;
        }

        .form-header {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 28px;
        }

        .form-header-icon {
            width: 48px; height: 48px;
            border-radius: 14px;
            background: linear-gradient(135deg, #d4af37, #0d9488);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            color: #ffffff;
            box-shadow: 0 6px 20px rgba(212, 175, 55, 0.3);
        }

        .form-header-text h2 {
            font-family: 'Playfair Display', serif;
            font-size: 1.6rem;
            color: #ffffff;
        }

        .form-header-text p {
            font-size: 0.82rem;
            color: var(--text-body);
        }

        .form-grid-2col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        @@media (max-width: 600px) {
            .form-card-container { padding: 22px 16px !important; margin: 10px auto !important; }
            .form-grid-2col { grid-template-columns: 1fr !important; gap: 0 !important; }
            .form-header-text h2 { font-size: 1.35rem !important; }
        }

        .form-group-custom {
            margin-bottom: 20px;
        }

        .form-label-custom {
            font-size: 0.82rem;
            font-weight: 600;
            color: #e2e8f0;
            margin-bottom: 8px;
            display: block;
        }

        .form-input-wrapper {
            position: relative;
        }

        .form-input-wrapper input {
            width: 100%;
            padding: 14px 16px 14px 44px;
            background: rgba(255, 255, 255, 0.04);
            border: 1.5px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            color: #ffffff;
            font-size: 0.95rem;
            outline: none;
            transition: all 0.3s ease;
        }

        .form-input-wrapper input:focus {
            border-color: #d4af37;
            background: rgba(212, 175, 55, 0.05);
            box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.15);
        }

        .form-input-wrapper i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #d4af37;
            font-size: 0.95rem;
        }

        .btn-submit-gold {
            width: 100%;
            padding: 16px;
            background: linear-gradient(90deg, #0d9488 0%, #14b8a6 40%, #d4af37 100%);
            border: none;
            border-radius: 50px;
            color: #ffffff;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.35s ease;
            box-shadow: 0 10px 28px rgba(13, 148, 136, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 10px;
        }

        .btn-submit-gold:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 36px rgba(212, 175, 55, 0.45);
        }
    </style>
}

<div class="form-card-container">
    <div class="form-header">
        <div class="form-header-icon">
            <i class="fa-solid fa-user-plus"></i>
        </div>
        <div class="form-header-text">
            <h2>Add New Staff Specialist</h2>
            <p>Register a new staff member to your salon roster</p>
        </div>
    </div>

    <form method="post">
        <div class="form-grid-2col">
            <div class="form-group-custom">
                <label class="form-label-custom">Staff Full Name</label>
                <div class="form-input-wrapper">
                    <input name="name" placeholder="e.g. Ayesha Khan" required />
                    <i class="fa-solid fa-user"></i>
                </div>
            </div>

            <div class="form-group-custom">
                <label class="form-label-custom">Phone Number</label>
                <div class="form-input-wrapper">
                    <input name="phone" placeholder="e.g. 03001234567" required />
                    <i class="fa-solid fa-phone"></i>
                </div>
            </div>
        </div>

        <div class="form-grid-2col">
            <div class="form-group-custom">
                <label class="form-label-custom">Email Address</label>
                <div class="form-input-wrapper">
                    <input name="email" type="email" placeholder="ayesha@salon.com" required />
                    <i class="fa-solid fa-envelope"></i>
                </div>
            </div>

            <div class="form-group-custom">
                <label class="form-label-custom">Monthly Salary (PKR)</label>
                <div class="form-input-wrapper">
                    <input name="salary" type="number" placeholder="e.g. 35000" required />
                    <i class="fa-solid fa-money-check-dollar"></i>
                </div>
            </div>
        </div>

        <div class="form-group-custom">
            <label class="form-label-custom">Speciality / Role</label>
            <div class="form-input-wrapper">
                <input name="speciality" placeholder="e.g. Senior Hair Stylist / Makeup Artist" required />
                <i class="fa-solid fa-star"></i>
            </div>
        </div>

        <div class="form-group-custom">
            <label class="form-label-custom">Address</label>
            <div class="form-input-wrapper">
                <input name="address" placeholder="e.g. Karachi, Pakistan" required />
                <i class="fa-solid fa-location-dot"></i>
            </div>
        </div>

        <!-- ── Staff Login Credentials Section ── -->
        <div style="background:rgba(20,184,166,0.08); border:1px solid rgba(20,184,166,0.25); border-radius:16px; padding:20px; margin-bottom:24px;">
            <div style="font-size:0.85rem; font-weight:700; color:var(--teal-light); margin-bottom:14px; display:flex; align-items:center; gap:8px;">
                <i class="fa-solid fa-key" style="color:var(--gold-primary);"></i> Staff Login Credentials Setup
            </div>
            
            <div class="form-grid-2col" style="margin-bottom:0;">
                <div class="form-group-custom" style="margin-bottom:0;">
                    <label class="form-label-custom">Staff Login Username</label>
                    <div class="form-input-wrapper">
                        <input name="username" placeholder="e.g. staff_ayesha" required />
                        <i class="fa-solid fa-user-lock"></i>
                    </div>
                </div>

                <div class="form-group-custom" style="margin-bottom:0;">
                    <label class="form-label-custom">Staff Login Password</label>
                    <div class="form-input-wrapper">
                        <input name="password" type="password" placeholder="••••••••" required />
                        <i class="fa-solid fa-lock"></i>
                    </div>
                </div>
            </div>
        </div>

        <button class="btn-submit-gold">
            <span>Register Staff Specialist & Create Credentials</span>
            <i class="fa-solid fa-user-check"></i>
        </button>
    </form>
</div>