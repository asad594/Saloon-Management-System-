@model List<dynamic>
@{
    Layout = "_AdminLayout";
}

<div class="table-box">
    <h2>System Activity Logs (Database Triggers)</h2>
    <p>This table displays actions logged by SQL Triggers and the application.</p>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>User ID</th>
                <th>Role</th>
                <th>Action Type</th>
                <th>Status Message (From Trigger)</th>
                <th>Timestamp</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var log in Model)
            {
                <tr>
                    <td>@log.id</td>
                    <td>@log.userId</td>
                    <td>@log.role</td>
                    <td>
                        <span style="padding: 4px 8px; border-radius: 4px; background: @(log.action == "LOGIN" ? "#e1f5fe" : "#fff3e0"); color: @(log.action == "LOGIN" ? "#0288d1" : "#ef6c00"); font-weight: bold;">
                            @log.action
                        </span>
                    </td>
                    <td style="color: #2e7d32; font-weight: 500;">
                        <i class="fas fa-bolt"></i> @log.message
                    </td>
                    <td>@log.time</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .table-box {
        animation: fadeIn 0.5s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    table th {
        background: #f8f9fa;
        text-align: left;
    }

    tr:hover {
        background-color: #f1f1f1;
    }
</style>
