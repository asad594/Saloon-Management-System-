@model TotalRevenueViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        .revenue-header-panel {
            background: linear-gradient(135deg, rgba(19, 25, 36, 0.95) 0%, rgba(11, 14, 20, 0.98) 100%);
            border: 1px solid var(--border-gold);
            border-radius: 20px;
            padding: 28px 32px;
            margin-bottom: 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        }

        .header-title-box h1 {
            font-family: 'Playfair Display', serif;
            font-size: 1.85rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-title-box p {
            font-size: 0.9rem;
            color: var(--text-body);
        }

        .status-pill {
            background: rgba(212, 175, 55, 0.15);
            border: 1px solid rgba(212, 175, 55, 0.3);
            color: var(--gold-primary);
            padding: 6px 14px;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        /* KPI Grid */
        .kpi-cards-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 32px;
        }

        .revenue-kpi-card {
            background: rgba(19, 25, 36, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(212, 175, 55, 0.25);
            border-radius: 20px;
            padding: 24px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            transition: transform 0.3s ease;
        }

        .revenue-kpi-card:hover {
            transform: translateY(-4px);
            border-color: var(--teal-glow);
        }

        .kpi-label {
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--gold-primary);
            margin-bottom: 8px;
        }

        .kpi-value {
            font-family: 'Playfair Display', serif;
            font-size: 2.2rem;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 4px;
        }

        .kpi-subtitle {
            font-size: 0.82rem;
            color: var(--text-muted);
        }

        /* Tables Panel */
        .table-panel-card {
            background: rgba(19, 25, 36, 0.8);
            border: 1px solid var(--border-gold);
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 32px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            padding-bottom: 14px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .panel-header h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.3rem;
            font-weight: 700;
            color: #ffffff;
        }

        .custom-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 8px;
        }

        .custom-table th {
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--gold-primary);
            padding: 12px 16px;
            text-align: left;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .custom-table td {
            background: rgba(255, 255, 255, 0.03);
            padding: 14px 16px;
            font-size: 0.9rem;
            color: #ffffff;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .custom-table tr td:first-child {
            border-top-left-radius: 12px;
            border-bottom-left-radius: 12px;
            border-left: 1px solid rgba(255, 255, 255, 0.05);
        }

        .custom-table tr td:last-child {
            border-top-right-radius: 12px;
            border-bottom-right-radius: 12px;
            border-right: 1px solid rgba(255, 255, 255, 0.05);
        }

        .price-badge {
            color: var(--gold-primary);
            font-weight: 700;
        }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: var(--text-muted);
            font-size: 0.95rem;
        }
    </style>
}

<!-- Flash Success Alert -->
@if (TempData["SuccessMessage"] != null)
{
    <div style="background: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.4); border-radius: 16px; padding: 16px 24px; color: #4ade80; font-weight: 600; margin-bottom: 24px; display: flex; align-items: center; gap: 12px; font-size: 1.02rem;">
        <i class="fa-solid fa-circle-check" style="font-size: 1.4rem;"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

<!-- Header Panel -->
<div class="revenue-header-panel">
    <div class="header-title-box">
        <h1><i class="fa-solid fa-vault" style="color: var(--gold-primary);"></i> Total Revenue Vault</h1>
        <p>All-Time Finalized Business Revenue Ledger & Closed Days Records.</p>
    </div>

    <div>
        <a href="/Admin/DayRevenue" class="status-pill" style="text-decoration: none; padding: 10px 20px; font-size: 0.9rem;">
            <i class="fa-solid fa-sun"></i> Go to Day Revenue &rarr;
        </a>
    </div>
</div>

<!-- KPI Metrics Grid -->
<div class="kpi-cards-grid">
    <div class="revenue-kpi-card" style="border-color: var(--teal-glow);">
        <div class="kpi-label" style="color: var(--teal-light);">Grand Total Revenue</div>
        <div class="kpi-value" style="color: var(--teal-light);">PKR @Model.GrandTotalRevenue.ToString("N0")</div>
        <div class="kpi-subtitle">Sum of all finalized closed days revenue</div>
    </div>

    <div class="revenue-kpi-card">
        <div class="kpi-label">Total Closed Days</div>
        <div class="kpi-value">@Model.TotalClosedDaysCount Days</div>
        <div class="kpi-subtitle">Number of business days closed by admin</div>
    </div>

    <div class="revenue-kpi-card">
        <div class="kpi-label">Total Closed Transactions</div>
        <div class="kpi-value">@Model.TotalClosedBillsCount Bills</div>
        <div class="kpi-subtitle">Total paid transactions in closed days ledger</div>
    </div>
</div>

<!-- Finalized Closed Days History Table -->
<div class="table-panel-card">
    <div class="panel-header">
        <h3><i class="fa-solid fa-calendar-days" style="color: var(--gold-primary);"></i> Finalized Closed Days Revenue Log</h3>
        <span class="status-pill"><i class="fa-solid fa-lock"></i> Permanent Revenue Records</span>
    </div>

    @if (Model.ClosedDaysHistory.Any())
    {
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Closing Ref</th>
                    <th>Date & Time Closed</th>
                    <th>Day Name</th>
                    <th>Total Transactions</th>
                    <th>Finalized Total Revenue</th>
                    <th style="text-align: right;">Closed By</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.ClosedDaysHistory)
                {
                    <tr>
                        <td>#LOG-@log.ClosingId</td>
                        <td style="font-weight: 600; color: #ffffff;">@log.ClosingDate.ToString("MMM dd, yyyy - hh:mm tt")</td>
                        <td><span class="status-pill" style="background: rgba(212, 175, 55, 0.15); border-color: rgba(212, 175, 55, 0.3); color: var(--gold-primary);">@log.DayName</span></td>
                        <td>@log.TotalBills Bills</td>
                        <td class="price-badge" style="font-size: 1.05rem;">PKR @log.TotalRevenue.ToString("N0")</td>
                        <td style="text-align: right; color: var(--text-muted);"><i class="fa-solid fa-user-shield" style="color: var(--teal-light);"></i> @log.ClosedBy</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-vault" style="font-size: 2.5rem; color: var(--gold-primary); margin-bottom: 12px; display: block;"></i>
            No closed days recorded yet. Navigate to <strong>Day Revenue</strong> and click <strong>"Close Day & Finalize Revenue"</strong> to add your first day!
        </div>
    }
</div>
