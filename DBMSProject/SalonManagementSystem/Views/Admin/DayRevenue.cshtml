@model DayRevenueViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        .revenue-header-panel {
            background: linear-gradient(135deg, rgba(19, 25, 36, 0.95) 0%, rgba(11, 14, 20, 0.98) 100%);
            border: 1px solid var(--border-gold);
            border-radius: 20px;
            padding: 28px 32px;
            margin-bottom: 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        }

        .header-title-box h1 {
            font-family: 'Playfair Display', serif;
            font-size: 1.85rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-title-box p {
            font-size: 0.9rem;
            color: var(--text-body);
        }

        .status-pill {
            background: rgba(34, 197, 94, 0.15);
            border: 1px solid rgba(34, 197, 94, 0.3);
            color: #4ade80;
            padding: 6px 14px;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .btn-close-day {
            background: linear-gradient(135deg, #e11d48 0%, #be123c 100%);
            color: #ffffff;
            border: none;
            padding: 14px 28px;
            border-radius: 50px;
            font-size: 1rem;
            font-weight: 800;
            letter-spacing: 0.5px;
            cursor: pointer;
            transition: all 0.35s ease;
            box-shadow: 0 8px 24px rgba(225, 29, 72, 0.4);
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .btn-close-day:hover {
            background: linear-gradient(135deg, #f43f5e 0%, #e11d48 100%);
            transform: translateY(-2px);
            box-shadow: 0 12px 32px rgba(244, 63, 94, 0.5);
        }

        /* KPI Grid */
        .kpi-cards-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 32px;
        }

        .revenue-kpi-card {
            background: rgba(19, 25, 36, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(212, 175, 55, 0.25);
            border-radius: 20px;
            padding: 24px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            transition: transform 0.3s ease;
        }

        .revenue-kpi-card:hover {
            transform: translateY(-4px);
            border-color: var(--teal-glow);
        }

        .kpi-label {
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--gold-primary);
            margin-bottom: 8px;
        }

        .kpi-value {
            font-family: 'Playfair Display', serif;
            font-size: 2.2rem;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 4px;
        }

        .kpi-subtitle {
            font-size: 0.82rem;
            color: var(--text-muted);
        }

        /* Tables Panel */
        .table-panel-card {
            background: rgba(19, 25, 36, 0.8);
            border: 1px solid var(--border-gold);
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 32px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            padding-bottom: 14px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .panel-header h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.3rem;
            font-weight: 700;
            color: #ffffff;
        }

        .custom-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 8px;
        }

        .custom-table th {
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--gold-primary);
            padding: 12px 16px;
            text-align: left;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .custom-table td {
            background: rgba(255, 255, 255, 0.03);
            padding: 14px 16px;
            font-size: 0.9rem;
            color: #ffffff;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .custom-table tr td:first-child {
            border-top-left-radius: 12px;
            border-bottom-left-radius: 12px;
            border-left: 1px solid rgba(255, 255, 255, 0.05);
        }

        .custom-table tr td:last-child {
            border-top-right-radius: 12px;
            border-bottom-right-radius: 12px;
            border-right: 1px solid rgba(255, 255, 255, 0.05);
        }

        .price-badge {
            color: var(--gold-primary);
            font-weight: 700;
        }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: var(--text-muted);
            font-size: 0.95rem;
        }
    </style>
}

<!-- Flash Success Alert -->
@if (TempData["SuccessMessage"] != null)
{
    <div style="background: rgba(34, 197, 94, 0.15); border: 1px solid rgba(34, 197, 94, 0.4); border-radius: 16px; padding: 16px 24px; color: #4ade80; font-weight: 600; margin-bottom: 24px; display: flex; align-items: center; gap: 12px; font-size: 1.02rem;">
        <i class="fa-solid fa-circle-check" style="font-size: 1.4rem;"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

<!-- Revenue Header Panel -->
<div class="revenue-header-panel">
    <div class="header-title-box">
        <h1><i class="fa-solid fa-sack-dollar" style="color: var(--gold-primary);"></i> Day Revenue & Day Closing Studio</h1>
        <p>Current Active Day Status: <span class="status-pill"><i class="fa-solid fa-circle-dot"></i> Open Day Active</span>
        @if (Model.LastClosingDate.HasValue)
        {
            <span style="color: var(--text-muted); margin-left: 10px;">(Last Closed: @Model.LastClosingDate.Value.ToString("MMM dd, yyyy - hh:mm tt"))</span>
        }
        </p>
    </div>

    <form method="post" action="/Admin/CloseDay" id="closeDayForm">
        <button type="button" class="btn-close-day" onclick="confirmCloseDay();">
            <i class="fa-solid fa-lock"></i> Close Day & Finalize Revenue
        </button>
    </form>
</div>

<!-- KPI Metrics Grid -->
<div class="kpi-cards-grid">
    <div class="revenue-kpi-card">
        <div class="kpi-label">Active Unclosed Day Revenue</div>
        <div class="kpi-value">PKR @Model.CurrentDayRevenue.ToString("N0")</div>
        <div class="kpi-subtitle">Accumulated live transactions since last closing</div>
    </div>

    <div class="revenue-kpi-card">
        <div class="kpi-label">Active Day Transactions</div>
        <div class="kpi-value">@Model.CurrentDayBillsCount</div>
        <div class="kpi-subtitle">Total Paid Bills waiting to be finalized</div>
    </div>

    <div class="revenue-kpi-card" style="border-color: var(--teal-glow);">
        <div class="kpi-label" style="color: var(--teal-light);">Total Finalized Revenue</div>
        <div class="kpi-value" style="color: var(--teal-light);">PKR @Model.TotalAllTimeClosedRevenue.ToString("N0")</div>
        <div class="kpi-subtitle">All-time finalized revenue across @Model.TotalClosedDaysCount closed days</div>
    </div>
</div>

<!-- Active Day Transactions Table -->
<div class="table-panel-card">
    <div class="panel-header">
        <h3><i class="fa-solid fa-receipt" style="color: var(--gold-primary);"></i> Live Transactions in Current Active Day</h3>
        <span class="status-pill"><i class="fa-solid fa-spinner fa-spin"></i> Live Unclosed Bills</span>
    </div>

    @if (Model.CurrentDayBills.Any())
    {
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Bill ID</th>
                    <th>Client Name</th>
                    <th>Phone</th>
                    <th>Service</th>
                    <th>Staff Member</th>
                    <th>Time Paid</th>
                    <th style="text-align: right;">Amount (PKR)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bill in Model.CurrentDayBills)
                {
                    <tr>
                        <td>#@bill.BillId</td>
                        <td style="font-weight: 600;">@bill.ClientName</td>
                        <td style="color: var(--text-muted);">@bill.Phone</td>
                        <td><span style="color: var(--teal-light); font-weight: 600;">@bill.ServiceName</span></td>
                        <td>@bill.StaffName</td>
                        <td><i class="fa-regular fa-clock" style="color: var(--gold-primary);"></i> @bill.BillDate.ToString("hh:mm tt")</td>
                        <td style="text-align: right;" class="price-badge">PKR @bill.TotalAmount.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-folder-open" style="font-size: 2.5rem; color: var(--gold-primary); margin-bottom: 12px; display: block;"></i>
            No new bills generated in the active open day yet.
        </div>
    }
</div>

<!-- Finalized Closed Days History Log -->
<div class="table-panel-card">
    <div class="panel-header">
        <h3><i class="fa-solid fa-vault" style="color: var(--teal-light);"></i> Finalized Total Revenue History (Closed Days Log)</h3>
    </div>

    @if (Model.ClosedDaysHistory.Any())
    {
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Closing ID</th>
                    <th>Date & Time Closed</th>
                    <th>Day Name</th>
                    <th>Transactions</th>
                    <th>Finalized Total Revenue</th>
                    <th style="text-align: right;">Closed By</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.ClosedDaysHistory)
                {
                    <tr>
                        <td>#LOG-@log.ClosingId</td>
                        <td style="font-weight: 600; color: #ffffff;">@log.ClosingDate.ToString("MMM dd, yyyy - hh:mm tt")</td>
                        <td><span class="status-pill" style="background: rgba(212, 175, 55, 0.15); border-color: rgba(212, 175, 55, 0.3); color: var(--gold-primary);">@log.DayName</span></td>
                        <td>@log.TotalBills Bills</td>
                        <td class="price-badge" style="font-size: 1.05rem;">PKR @log.TotalRevenue.ToString("N0")</td>
                        <td style="text-align: right; color: var(--text-muted);"><i class="fa-solid fa-user-shield" style="color: var(--teal-light);"></i> @log.ClosedBy</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            No closed days recorded yet. Click <strong>"Close Day & Finalize Revenue"</strong> above when your business day finishes!
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmCloseDay() {
            const revenue = "@Model.CurrentDayRevenue.ToString("N0")";
            const bills = "@Model.CurrentDayBillsCount";

            Swal.fire({
                title: 'Close Day & Finalize Revenue?',
                html: `Are you sure you want to close the operational day?<br><br>` +
                      `<b style="color:#d4af37; font-size:1.1rem;">Current Unclosed Revenue: PKR ${revenue}</b><br>` +
                      `<span style="color:#94a3b8;">(${bills} Transactions)</span><br><br>` +
                      `This will finalize this day's sales into Total Revenue history and reset the active counter for new bills.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#334155',
                confirmButtonText: 'Yes, Close Day Now!',
                cancelButtonText: 'Cancel',
                background: '#131924',
                color: '#ffffff'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('closeDayForm').submit();
                }
            });
        }
    </script>
}
