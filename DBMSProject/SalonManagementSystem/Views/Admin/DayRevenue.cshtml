@model DayRevenueViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        .revenue-header-panel {
            background: linear-gradient(135deg, rgba(19, 25, 36, 0.95) 0%, rgba(11, 14, 20, 0.98) 100%);
            border: 1px solid var(--border-gold);
            border-radius: 20px;
            padding: 28px 32px;
            margin-bottom: 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        }

        .header-title-box h1 {
            font-family: 'Playfair Display', serif;
            font-size: 1.85rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-title-box p {
            font-size: 0.9rem;
            color: var(--text-body);
        }

        .status-pill {
            background: rgba(34, 197, 94, 0.15);
            border: 1px solid rgba(34, 197, 94, 0.3);
            color: #4ade80;
            padding: 6px 14px;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        /* ── Exact Red Close Day Pill Button matching screenshot ── */
        .btn-close-day {
            background: linear-gradient(90deg, #e11d48 0%, #be123c 100%);
            color: #ffffff;
            border: none;
            padding: 14px 32px;
            border-radius: 50px;
            font-size: 1.05rem;
            font-weight: 800;
            letter-spacing: 0.03em;
            cursor: pointer;
            transition: all 0.35s ease;
            box-shadow: 0 10px 28px rgba(225, 29, 72, 0.45);
            display: inline-flex;
            align-items: center;
            gap: 12px;
        }

        .btn-close-day:hover {
            background: linear-gradient(90deg, #f43f5e 0%, #e11d48 100%);
            transform: translateY(-2px);
            box-shadow: 0 14px 36px rgba(244, 63, 94, 0.55);
        }

        /* KPI Grid */
        .kpi-cards-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
            margin-bottom: 32px;
        }

        .revenue-kpi-card {
            background: rgba(19, 25, 36, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(212, 175, 55, 0.25);
            border-radius: 20px;
            padding: 24px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            transition: transform 0.3s ease;
        }

        .revenue-kpi-card:hover {
            transform: translateY(-4px);
            border-color: var(--teal-glow);
        }

        .kpi-label {
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--gold-primary);
            margin-bottom: 8px;
        }

        .kpi-value {
            font-family: 'Playfair Display', serif;
            font-size: 2.2rem;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 4px;
        }

        .kpi-subtitle {
            font-size: 0.82rem;
            color: var(--text-muted);
        }

        /* Tables Panel */
        .table-panel-card {
            background: rgba(19, 25, 36, 0.8);
            border: 1px solid var(--border-gold);
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 32px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            padding-bottom: 14px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .panel-header h3 {
            font-family: 'Playfair Display', serif;
        }

        @@media (max-width: 992px) {
            .revenue-header-panel { flex-direction: column !important; align-items: flex-start !important; gap: 16px !important; }
            .kpi-cards-grid { grid-template-columns: 1fr !important; }
            .btn-close-day { width: 100% !important; justify-content: center !important; }
        }

        @@media (max-width: 576px) {
            .revenue-header-panel { padding: 20px 16px !important; }
            .header-title-box h1 { font-size: 1.45rem !important; }
            .table-panel-card { padding: 16px !important; overflow-x: auto !important; }
        }
            font-size: 1.3rem;
            font-weight: 700;
            color: #ffffff;
        }

        .custom-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 8px;
        }

        .custom-table th {
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--gold-primary);
            padding: 12px 16px;
            text-align: left;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .custom-table td {
            background: rgba(255, 255, 255, 0.03);
            padding: 14px 16px;
            font-size: 0.9rem;
            color: #ffffff;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .custom-table tr td:first-child {
            border-top-left-radius: 12px;
            border-bottom-left-radius: 12px;
            border-left: 1px solid rgba(255, 255, 255, 0.05);
        }

        .custom-table tr td:last-child {
            border-top-right-radius: 12px;
            border-bottom-right-radius: 12px;
            border-right: 1px solid rgba(255, 255, 255, 0.05);
        }

        .price-badge {
            color: var(--gold-primary);
            font-weight: 700;
        }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: var(--text-muted);
            font-size: 0.95rem;
        }
    </style>
}

<!-- Revenue Header Panel -->
<div class="revenue-header-panel">
    <div class="header-title-box">
        <h1><i class="fa-solid fa-sun" style="color: var(--gold-primary);"></i> Day Revenue Studio</h1>
        <p>Live active day transaction manager & finalization portal.
        @if (Model.LastClosingDate.HasValue)
        {
            <span style="color: var(--text-muted); margin-left: 6px;">(Last Closed: @Model.LastClosingDate.Value.ToString("MMM dd, yyyy - hh:mm tt"))</span>
        }
        </p>
    </div>

    <form method="post" action="/Admin/CloseDay" id="closeDayForm">
        <button type="button" class="btn-close-day" onclick="confirmCloseDay();">
            <i class="fa-solid fa-lock"></i> Close Day & Finalize Revenue
        </button>
    </form>
</div>

<!-- KPI Metrics Grid -->
<div class="kpi-cards-grid">
    <div class="revenue-kpi-card" style="border-color: var(--gold-primary);">
        <div class="kpi-label">Active Unclosed Day Revenue</div>
        <div class="kpi-value" style="color: var(--gold-primary);">PKR @Model.CurrentDayRevenue.ToString("N0")</div>
        <div class="kpi-subtitle">Accumulated live sales waiting to be closed into Total Revenue</div>
    </div>

    <div class="revenue-kpi-card">
        <div class="kpi-label">Active Day Transactions</div>
        <div class="kpi-value">@Model.CurrentDayBillsCount</div>
        <div class="kpi-subtitle">Total paid bills in current active day</div>
    </div>
</div>

<!-- Active Day Transactions Table -->
<div class="table-panel-card">
    <div class="panel-header">
        <h3><i class="fa-solid fa-receipt" style="color: var(--gold-primary);"></i> Transactions in Current Active Day</h3>
        <span class="status-pill"><i class="fa-solid fa-circle-dot"></i> Live Active Bills</span>
    </div>

    @if (Model.CurrentDayBills.Any())
    {
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Bill ID</th>
                    <th>Client Name</th>
                    <th>Phone</th>
                    <th>Service</th>
                    <th>Staff Member</th>
                    <th>Time Paid</th>
                    <th style="text-align: right;">Amount (PKR)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bill in Model.CurrentDayBills)
                {
                    <tr>
                        <td>#@bill.BillId</td>
                        <td style="font-weight: 600;">@bill.ClientName</td>
                        <td style="color: var(--text-muted);">@bill.Phone</td>
                        <td><span style="color: var(--teal-light); font-weight: 600;">@bill.ServiceName</span></td>
                        <td>@bill.StaffName</td>
                        <td><i class="fa-regular fa-clock" style="color: var(--gold-primary);"></i> @bill.BillDate.ToString("hh:mm tt")</td>
                        <td style="text-align: right;" class="price-badge">PKR @bill.TotalAmount.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-folder-open" style="font-size: 2.5rem; color: var(--gold-primary); margin-bottom: 12px; display: block;"></i>
            No transactions generated in the current active day yet.
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function confirmCloseDay() {
            const revenue = "@Model.CurrentDayRevenue.ToString("N0")";
            const bills = "@Model.CurrentDayBillsCount";

            Swal.fire({
                title: 'Close Day & Finalize Revenue?',
                html: `Are you sure you want to close this day?<br><br>` +
                      `<b style="color:#d4af37; font-size:1.2rem;">Day Revenue: PKR ${revenue}</b><br>` +
                      `<span style="color:#94a3b8;">(${bills} Transactions)</span><br><br>` +
                      `This day's total revenue will be added into <b>Total Revenue</b> logs, and active day counter will reset to PKR 0.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#334155',
                confirmButtonText: 'Yes, Close Day Now!',
                cancelButtonText: 'Cancel',
                background: '#131924',
                color: '#ffffff'
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById('closeDayForm').submit();
                }
            });
        }
    </script>
}
