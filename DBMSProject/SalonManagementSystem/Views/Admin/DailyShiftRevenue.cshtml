@model DailyShiftRevenueViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <style>
        .revenue-header-panel {
            background: linear-gradient(135deg, rgba(19, 25, 36, 0.95) 0%, rgba(11, 14, 20, 0.98) 100%);
            border: 1px solid var(--border-gold);
            border-radius: 20px;
            padding: 28px 32px;
            margin-bottom: 28px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        }

        .header-title-box h1 {
            font-family: 'Playfair Display', serif;
            font-size: 1.85rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-title-box p {
            font-size: 0.9rem;
            color: var(--text-body);
        }

        .shift-badge {
            background: rgba(212, 175, 55, 0.15);
            border: 1px solid rgba(212, 175, 55, 0.3);
            color: var(--gold-primary);
            padding: 6px 14px;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        /* Filter Form */
        .filter-date-form {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .date-picker-input {
            background: rgba(13, 19, 30, 0.9) !important;
            border: 1px solid var(--border-gold) !important;
            color: #ffffff !important;
            padding: 10px 16px !important;
            border-radius: 12px !important;
            font-size: 0.92rem !important;
            outline: none !important;
        }

        .btn-filter-submit {
            background: linear-gradient(135deg, var(--gold-primary) 0%, var(--gold-accent) 100%);
            color: #0b0e14;
            border: none;
            padding: 10px 20px;
            border-radius: 12px;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-filter-submit:hover {
            box-shadow: 0 6px 20px rgba(212, 175, 55, 0.4);
            transform: translateY(-2px);
        }

        /* KPI Grid */
        .kpi-cards-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 32px;
        }

        .revenue-kpi-card {
            background: rgba(19, 25, 36, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(212, 175, 55, 0.25);
            border-radius: 20px;
            padding: 24px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            transition: transform 0.3s ease;
        }

        .revenue-kpi-card:hover {
            transform: translateY(-4px);
            border-color: var(--teal-glow);
        }

        .kpi-label {
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--gold-primary);
            margin-bottom: 8px;
        }

        .kpi-value {
            font-family: 'Playfair Display', serif;
            font-size: 2.2rem;
            font-weight: 800;
            color: #ffffff;
            margin-bottom: 4px;
        }

        .kpi-subtitle {
            font-size: 0.82rem;
            color: var(--text-muted);
        }

        /* Tables Panel */
        .table-panel-card {
            background: rgba(19, 25, 36, 0.8);
            border: 1px solid var(--border-gold);
            border-radius: 20px;
            padding: 24px;
            margin-bottom: 32px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        }

        .panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            padding-bottom: 14px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .panel-header h3 {
            font-family: 'Playfair Display', serif;
            font-size: 1.3rem;
            font-weight: 700;
            color: #ffffff;
        }

        .custom-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 8px;
        }

        .custom-table th {
            font-size: 0.78rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--gold-primary);
            padding: 12px 16px;
            text-align: left;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .custom-table td {
            background: rgba(255, 255, 255, 0.03);
            padding: 14px 16px;
            font-size: 0.9rem;
            color: #ffffff;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .custom-table tr td:first-child {
            border-top-left-radius: 12px;
            border-bottom-left-radius: 12px;
            border-left: 1px solid rgba(255, 255, 255, 0.05);
        }

        .custom-table tr td:last-child {
            border-top-right-radius: 12px;
            border-bottom-right-radius: 12px;
            border-right: 1px solid rgba(255, 255, 255, 0.05);
        }

        .price-badge {
            color: var(--gold-primary);
            font-weight: 700;
            font-family: var(--font-sans);
        }

        .empty-state {
            text-align: center;
            padding: 40px;
            color: var(--text-muted);
            font-size: 0.95rem;
        }
    </style>
}

<!-- Revenue Header Panel -->
<div class="revenue-header-panel">
    <div class="header-title-box">
        <h1><i class="fa-solid fa-sack-dollar" style="color: var(--gold-primary);"></i> Daily Shift Revenue Studio</h1>
        <p>Operational Shift Window: <span class="shift-badge"><i class="fa-solid fa-clock"></i> 12:00 PM (Noon) &rarr; 12:00 AM (Midnight) = 1 Day</span></p>
    </div>

    <form method="get" action="/Admin/DailyShiftRevenue" class="filter-date-form">
        <label style="font-size: 0.88rem; font-weight: 600; color: #ffffff;">Select Shift Date:</label>
        <input type="date" name="targetDate" class="date-picker-input" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" required />
        <button type="submit" class="btn-filter-submit">
            <i class="fa-solid fa-filter"></i> Load Shift
        </button>
    </form>
</div>

<!-- KPI Metrics Grid -->
<div class="kpi-cards-grid">
    <div class="revenue-kpi-card">
        <div class="kpi-label">Selected Shift Revenue</div>
        <div class="kpi-value">PKR @Model.SelectedShiftRevenue.ToString("N0")</div>
        <div class="kpi-subtitle">Shift: @Model.ShiftStart.ToString("MMM dd, yyyy - hh:mm tt") &rarr; @Model.ShiftEnd.ToString("hh:mm tt")</div>
    </div>

    <div class="revenue-kpi-card">
        <div class="kpi-label">Selected Shift Transactions</div>
        <div class="kpi-value">@Model.SelectedShiftBillCount</div>
        <div class="kpi-subtitle">Total Paid Bills during 12 PM - 12 AM</div>
    </div>

    <div class="revenue-kpi-card" style="border-color: var(--teal-glow);">
        <div class="kpi-label" style="color: var(--teal-light);">Today's Live Shift Revenue</div>
        <div class="kpi-value" style="color: var(--teal-light);">PKR @Model.TodayShiftRevenue.ToString("N0")</div>
        <div class="kpi-subtitle">Live Shift: 12:00 PM Today &rarr; 12:00 AM Midnight (@Model.TodayShiftBillCount Bills)</div>
    </div>
</div>

<!-- Selected Shift Transactions Table -->
<div class="table-panel-card">
    <div class="panel-header">
        <h3><i class="fa-solid fa-receipt" style="color: var(--gold-primary);"></i> Bills Paid in Selected Shift (@Model.SelectedDate.ToString("MMM dd, yyyy"))</h3>
        <span class="shift-badge">Window: 12:00 PM &rarr; 12:00 AM</span>
    </div>

    @if (Model.ShiftBills.Any())
    {
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Bill ID</th>
                    <th>Client Name</th>
                    <th>Phone</th>
                    <th>Service</th>
                    <th>Staff Member</th>
                    <th>Time Paid</th>
                    <th style="text-align: right;">Amount (PKR)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var bill in Model.ShiftBills)
                {
                    <tr>
                        <td>#@bill.BillId</td>
                        <td style="font-weight: 600;">@bill.ClientName</td>
                        <td style="color: var(--text-muted);">@bill.Phone</td>
                        <td><span style="color: var(--teal-light); font-weight: 600;">@bill.ServiceName</span></td>
                        <td>@bill.StaffName</td>
                        <td><i class="fa-regular fa-clock" style="color: var(--gold-primary);"></i> @bill.BillDate.ToString("hh:mm tt")</td>
                        <td style="text-align: right;" class="price-badge">PKR @bill.TotalAmount.ToString("N0")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="fa-solid fa-folder-open" style="font-size: 2.5rem; color: var(--gold-primary); margin-bottom: 12px; display: block;"></i>
            No bills recorded during the 12:00 PM to 12:00 AM shift window for @Model.SelectedDate.ToString("MMM dd, yyyy").
        </div>
    }
</div>

<!-- Daily Shift History Breakdown Table -->
<div class="table-panel-card">
    <div class="panel-header">
        <h3><i class="fa-solid fa-calendar-days" style="color: var(--teal-light);"></i> Daily Shift History Log (12 PM - 12 AM Shifts)</h3>
    </div>

    @if (Model.ShiftHistory.Any())
    {
        <table class="custom-table">
            <thead>
                <tr>
                    <th>Shift Date</th>
                    <th>Shift Window</th>
                    <th>Total Paid Bills</th>
                    <th>Total Revenue (PKR)</th>
                    <th style="text-align: right;">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var history in Model.ShiftHistory)
                {
                    <tr>
                        <td style="font-weight: 700; color: #ffffff;">@history.ShiftDate.ToString("ddd, MMM dd, yyyy")</td>
                        <td><span class="shift-badge">12:00 PM &rarr; 12:00 AM</span></td>
                        <td>@history.BillCount Transactions</td>
                        <td class="price-badge">PKR @history.TotalRevenue.ToString("N0")</td>
                        <td style="text-align: right;">
                            <a href="/Admin/DailyShiftRevenue?targetDate=@history.ShiftDate.ToString("yyyy-MM-dd")" class="btn-filter-submit" style="padding: 6px 14px; font-size: 0.78rem; display: inline-flex;">
                                View Shift <i class="fa-solid fa-arrow-right"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            No shift revenue records available in history.
        </div>
    }
</div>
