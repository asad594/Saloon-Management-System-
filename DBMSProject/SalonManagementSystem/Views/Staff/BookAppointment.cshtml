@model SalonManagementSystem.Models.AppointmentViewModel
@{
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<div style="max-width:650px; margin:20px auto; background:linear-gradient(145deg, #131924 0%, #0e1219 100%); padding:28px; border-radius:18px; border:1px solid rgba(212,175,55,0.25); box-shadow:0 12px 36px rgba(0,0,0,0.4); box-sizing:border-box;">

    <h2 style="font-family:'Playfair Display', serif; color:#ffffff; font-size:1.6rem; margin-bottom:20px; text-align:center;">
        <i class="fa-solid fa-calendar-plus" style="color:#d4af37; margin-right:8px;"></i> Book New Appointment
    </h2>

    <form method="post">

        <div style="margin-bottom:14px;">
            <label style="font-size:0.85rem; font-weight:600; color:#e2e8f0; margin-bottom:4px; display:block;">Client Full Name</label>
            <input asp-for="ClientName" placeholder="Client Name" class="form-control" required />
        </div>

        <div style="margin-bottom:14px;">
            <label style="font-size:0.85rem; font-weight:600; color:#e2e8f0; margin-bottom:4px; display:block;">Client Phone</label>
            <input asp-for="ClientPhone" placeholder="03001234567" class="form-control" required />
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:14px;" class="date-time-grid">
            <div>
                <label style="font-size:0.85rem; font-weight:600; color:#e2e8f0; margin-bottom:4px; display:block;">Appointment Date</label>
                <input asp-for="AppDate" type="date" class="form-control" required />
            </div>
            <div>
                <label style="font-size:0.85rem; font-weight:600; color:#e2e8f0; margin-bottom:4px; display:block;">Appointment Time</label>
                <input asp-for="AppTime" type="time" class="form-control" required />
            </div>
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:14px;" class="staff-grid">
            <div>
                <label style="font-size:0.85rem; font-weight:600; color:#e2e8f0; margin-bottom:4px; display:block;">Booked For (Staff)</label>
                <select asp-for="BookedForId" asp-items="Model.StaffList" class="form-control" required>
                    <option value="">Select Staff</option>
                </select>
            </div>
            <div>
                <label style="font-size:0.85rem; font-weight:600; color:#e2e8f0; margin-bottom:4px; display:block;">Booked By (Staff)</label>
                <select asp-for="BookedById" asp-items="Model.StaffList" class="form-control" required>
                    <option value="">Select Staff</option>
                </select>
            </div>
        </div>

        <div style="margin-bottom:18px;">
            <label style="font-size:0.85rem; font-weight:600; color:#e2e8f0; margin-bottom:4px; display:block;">Salon Service</label>
            <select asp-for="SelectedServiceId" asp-items="Model.Services" class="form-control" id="serviceSelect" required>
                <option value="">Select Service</option>
            </select>
        </div>

        <div style="display:flex; align-items:center; justify-content:space-between; background:rgba(212,175,55,0.08); border:1px solid rgba(212,175,55,0.25); padding:14px 18px; border-radius:12px; margin-bottom:20px;">
            <span style="font-weight:700; color:#e2e8f0; font-size:1.05rem;">Estimated Total Amount:</span>
            <span style="font-family:'Playfair Display', serif; font-size:1.5rem; font-weight:800; color:#d4af37;">PKR <span id="total">0</span></span>
        </div>

        <button type="submit" style="width:100%; padding:14px; background:linear-gradient(90deg, #0d9488 0%, #d4af37 100%); border:none; border-radius:50px; color:#ffffff; font-size:1.05rem; font-weight:800; cursor:pointer;">
            <i class="fa-solid fa-receipt"></i> Save & Generate Bill
        </button>

    </form>
</div>

<style>
    @@media (max-width: 600px) {
        .date-time-grid, .staff-grid { grid-template-columns: 1fr !important; gap: 0 !important; }
    }
</style>

<script>
    document.getElementById("serviceSelect").addEventListener("change", function () {
        var serviceId = this.value;
        fetch('/Staff/GetServicePrice?serviceId=' + serviceId)
            .then(response => response.json())
            .then(data => {
                document.getElementById("total").innerText = data;
            });
    });
</script>