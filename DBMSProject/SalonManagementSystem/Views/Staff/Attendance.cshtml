@model List<SalonManagementSystem.Models.AttendanceViewModel>

@{
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="~/css/site.css" />
    <!-- Reuse login page styles here -->
    <style>
        .attendance-wrapper {
            width: 100%;
            max-width: 700px;
            margin: 0 auto;
            box-sizing: border-box;
        }
        .staff-drop, .time-drop {
            width: 100% !important;
            max-width: 100% !important;
            height: 44px;
            border-radius: 12px;
            padding-left: 14px;
            margin-top: 10px;
            box-sizing: border-box;
            background: rgba(255,255,255,0.06);
            color: #fff;
            border: 1px solid rgba(212,175,55,0.3);
        }
        .attendence-labels {
            margin: 10px 0;
            text-align: left;
        }
        .attendance-form {
            border: 1px solid rgba(212,175,55,0.25);
            background: linear-gradient(145deg, #131924 0%, #0e1219 100%);
            padding: 24px 20px;
            border-radius: 16px;
            box-sizing: border-box;
        }
        .btn-attendance {
            width: 100% !important;
            max-width: 100% !important;
            height: 48px;
            margin-top: 20px;
            margin-bottom: 20px;
            border-radius: 50px;
            background: linear-gradient(90deg, #0d9488, #d4af37);
            color: #fff;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            border: none;
            box-shadow: 0 8px 24px rgba(13,148,136,0.3);
        }
            color: #ffffff
        }

        .btn-attendance:hover{
                background: #09174f;
                color: #ffffff
        }

        tr, th {
            border-radius: 5px;
            border: 1px black solid;
            width: 200px;
        }

        .attendance-table{
            width: 850px;
            height: auto;
            border: 1px black solid;
            padding: 10px;
            border-radius: 10px;
        }

        .attendance-card{
            margin-bottom: 30px;
        }
    </style>
</head>
<body>
<div class="">

    <!-- FORM CARD -->
    <div class="attendance-card">
        <h2 class="title">Mark Attendance</h2>

        <form method="post" asp-action="MarkAttendance" class="attendance-form">

            <div class="form-group" class="attendance-card ">
                <label class="attendence-labels">Staff Member</label>
                    <select name="SelectedStaffId" class="form-control staff-drop">
                        @if (ViewBag.StaffList != null)
                    {
                        foreach (var s in ViewBag.StaffList)
                        {
                            <option value="@s.Value">@s.Text</option>
                        }
                    }
                </select>
            </div>

            <div class="form-group">
                    <label class="attendence-labels">Action</label>
                    <select name="Type" class="form-control time-drop">
                        <option value="CheckIn">Arrival</option>
                        <option value="CheckOut">Departure</option>
                </select>
            </div>

            <button type="submit" class="btn-attendance">
                Mark Attendance
            </button>

        </form>
    </div>

    <!-- TABLE CARD -->
    <div class="attendance-table-card">
        <h3>Today's Attendance</h3>

        <table class="attendance-table">
            <thead>
                <tr>
                    <th>Staff</th>
                    <th>Check In</th>
                    <th>Check Out</th>
                </tr>
            </thead>
            <tbody>

                @if (Model != null && Model.Count > 0)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.StaffName</td>
                            <td>@item.CheckIn</td>
                            <td>@(item.CheckOut == null ? "-" : item.CheckOut)</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" style="text-align:center; padding:20px;">
                            No attendance marked today
                        </td>
                    </tr>
                }

            </tbody>
        </table>

            <h3 style="margin-top:40px;">Attendance Chart</h3>

            <canvas id="attendanceChart" height="100"></canvas>
    </div>

</div>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        fetch('/Staff/GetAttendanceChart')
            .then(response => response.json())
            .then(data => {

                const labels = data.map(x => x.date);
                const values = data.map(x => x.total);

                const ctx = document.getElementById('attendanceChart').getContext('2d');

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Attendance Count',
                            data: values,
                            borderWidth: 2,
                            tension: 0.3
                        }]
                    },
                    options: {
                        responsive: true
                    }
                });

            });
    </script>

</body>
</html>