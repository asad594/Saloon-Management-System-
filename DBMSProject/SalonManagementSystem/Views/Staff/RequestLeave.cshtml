@model SalonManagementSystem.Models.StaffLeaveViewModel
@{
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
    ViewData["Title"] = "Staff Availability & Leave Requests";
}

@section Styles {
    <style>
        .leave-card-grid {
            display: grid;
            grid-template-columns: 1fr 2fr;
            gap: 28px;
        }

        .leave-card {
            background: rgba(19, 25, 36, 0.75);
            backdrop-filter: blur(14px);
            border: 1px solid var(--border-gold);
            border-radius: 20px;
            padding: 28px;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.4);
        }

        .custom-leave-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 8px;
        }

        .custom-leave-table th {
            font-size: 0.76rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--gold-accent);
            padding: 12px 18px;
            text-align: left;
            border-bottom: 1px solid rgba(212, 175, 55, 0.2);
        }

        .custom-leave-table tbody tr {
            background: rgba(255, 255, 255, 0.03);
            border-radius: 12px;
        }

        .custom-leave-table td {
            padding: 14px 18px;
            color: #ffffff;
            font-size: 0.9rem;
        }

        .badge-leave-status {
            padding: 4px 12px;
            border-radius: 50px;
            font-size: 0.78rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .status-Pending { background: rgba(212, 175, 55, 0.15); color: var(--gold-primary); border: 1px solid rgba(212, 175, 55, 0.3); }
        .status-Approved { background: rgba(34, 197, 94, 0.15); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3); }
        .status-Rejected { background: rgba(239, 68, 68, 0.15); color: #fca5a5; border: 1px solid rgba(239, 68, 68, 0.3); }

        .btn-submit-leave {
            background: linear-gradient(90deg, var(--teal-primary), var(--gold-primary));
            color: #ffffff;
            border: none;
            padding: 12px 22px;
            border-radius: 12px;
            font-size: 0.9rem;
            font-weight: 700;
            cursor: pointer;
            width: 100%;
            transition: all 0.3s ease;
            box-shadow: 0 6px 20px rgba(13, 148, 136, 0.35);
        }

        .btn-submit-leave:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(212, 175, 55, 0.45);
        }

        @@media (max-width: 992px) {
            .leave-card-grid { grid-template-columns: 1fr; }
        }
    </style>
}

<div style="margin-bottom:28px;">
    <h2 style="font-family:var(--font-display); font-size:1.6rem; color:#ffffff;">
        <i class="fa-solid fa-plane-arrival" style="color:var(--gold-primary);"></i> Staff Availability & Leave Application
    </h2>
    <p style="font-size:0.84rem; color:var(--text-body);">Submit shift leave applications and track management approvals in real-time</p>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div style="background:rgba(34,197,94,0.15); border:1px solid rgba(34,197,94,0.3); color:#4ade80; padding:12px 18px; border-radius:12px; margin-bottom:24px; font-size:0.9rem; font-weight:600;">
        <i class="fa-solid fa-circle-check"></i> @TempData["SuccessMessage"]
    </div>
}

<div class="leave-card-grid">
    <!-- Left Column: Submit Leave Form -->
    <div class="leave-card">
        <h3 style="font-family:var(--font-display); font-size:1.3rem; color:#ffffff; margin-bottom:20px;">
            <i class="fa-solid fa-calendar-plus" style="color:var(--gold-primary);"></i> Request Time Off
        </h3>

        <form method="post" asp-action="RequestLeave">
            <div style="margin-bottom:18px;">
                <label style="font-size:0.82rem; font-weight:700; color:#e2e8f0; margin-bottom:6px; display:block;">Requested Leave Date</label>
                <input type="date" name="NewLeaveDate" value="@Model.NewLeaveDate.ToString("yyyy-MM-dd")" class="form-control" style="background:rgba(11,14,20,0.8); border:1px solid var(--border-gold); color:#ffffff; border-radius:10px; padding:12px; font-size:0.9rem;" required />
            </div>

            <div style="margin-bottom:22px;">
                <label style="font-size:0.82rem; font-weight:700; color:#e2e8f0; margin-bottom:6px; display:block;">Reason for Leave</label>
                <textarea name="NewReason" rows="4" class="form-control" style="background:rgba(11,14,20,0.8); border:1px solid var(--border-gold); color:#ffffff; border-radius:10px; padding:12px; font-size:0.88rem;" placeholder="Specify reason (e.g., Medical appointment, personal family leave)..." required></textarea>
            </div>

            <button type="submit" class="btn-submit-leave">
                <i class="fa-solid fa-paper-plane"></i> Submit Leave Request
            </button>
        </form>
    </div>

    <!-- Right Column: Past Leave Requests -->
    <div class="leave-card">
        <div style="margin-bottom:20px; display:flex; align-items:center; justify-content:space-between;">
            <h3 style="font-family:var(--font-display); font-size:1.3rem; color:#ffffff;">
                <i class="fa-solid fa-clock-rotate-left" style="color:var(--teal-light);"></i> Leave Status History
            </h3>
            <span style="background:rgba(212,175,55,0.15); color:var(--gold-primary); border:1px solid rgba(212,175,55,0.3); padding:4px 12px; border-radius:50px; font-size:0.78rem; font-weight:700;">
                @Model.LeaveHistory.Count Requests Logged
            </span>
        </div>

        <table class="custom-leave-table">
            <thead>
                <tr>
                    <th>Leave Date</th>
                    <th>Reason</th>
                    <th>Submitted On</th>
                    <th style="text-align:right;">Approval Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.LeaveHistory != null && Model.LeaveHistory.Count > 0)
                {
                    foreach (var item in Model.LeaveHistory)
                    {
                        <tr>
                            <td><span style="font-weight:700; color:var(--gold-accent);">@item.LeaveDate.ToString("MMM dd, yyyy")</span></td>
                            <td style="color:#e2e8f0;">@item.Reason</td>
                            <td style="color:var(--text-body); font-size:0.82rem;">@item.RequestedOn.ToString("MMM dd, yyyy")</td>
                            <td style="text-align:right;">
                                <span class="badge-leave-status status-@item.Status">
                                    <i class="fa-solid fa-circle" style="font-size:0.5rem;"></i> @item.Status
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" style="text-align:center; color:var(--text-body); padding:32px;">
                            No leave requests submitted yet.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
