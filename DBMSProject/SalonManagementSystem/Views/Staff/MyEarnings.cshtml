@model SalonManagementSystem.Models.StaffEarningsViewModel
@{
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
    ViewData["Title"] = "My Personal Shift Earnings";
}

@section Styles {
    <style>
        .earnings-grid-3col {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            margin-bottom: 32px;
        }

        .earnings-kpi-card {
            background: rgba(19, 25, 36, 0.75);
            backdrop-filter: blur(14px);
            border: 1px solid var(--border-gold);
            border-radius: 20px;
            padding: 24px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
            position: relative;
            overflow: hidden;
        }

        .earnings-kpi-card::before {
            content: '';
            position: absolute;
            top: -40%; right: -10%;
            width: 160px; height: 160px;
            background: radial-gradient(circle, rgba(212, 175, 55, 0.15) 0%, transparent 70%);
            pointer-events: none;
        }

        .earnings-kpi-title {
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--text-body);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 6px;
        }

        .earnings-kpi-value {
            font-family: var(--font-display);
            font-size: 2rem;
            font-weight: 800;
            color: #ffffff;
        }

        .earnings-history-card {
            background: rgba(19, 25, 36, 0.75);
            backdrop-filter: blur(14px);
            border: 1px solid var(--border-gold);
            border-radius: 20px;
            padding: 28px;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.4);
        }

        .commission-note-banner {
            background: rgba(20, 184, 166, 0.12);
            border: 1px solid rgba(20, 184, 166, 0.3);
            border-radius: 14px;
            padding: 16px 20px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: var(--teal-light);
            font-size: 0.86rem;
        }

        .custom-earnings-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 8px;
        }

        .custom-earnings-table th {
            font-size: 0.76rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            color: var(--gold-accent);
            padding: 12px 20px;
            text-align: left;
            border-bottom: 1px solid rgba(212, 175, 55, 0.2);
        }

        .custom-earnings-table tbody tr {
            background: rgba(255, 255, 255, 0.03);
            border-radius: 12px;
            transition: all 0.3s ease;
        }

        .custom-earnings-table tbody tr:hover {
            background: rgba(212, 175, 55, 0.06);
            transform: translateY(-2px);
        }

        .custom-earnings-table td {
            padding: 16px 20px;
            color: #ffffff;
            font-size: 0.92rem;
        }

        @@media (max-width: 768px) {
            .earnings-grid-3col { grid-template-columns: 1fr; }
        }
    </style>
}

<!-- ── Earnings Summary Cards ── -->
<div class="earnings-grid-3col">
    <div class="earnings-kpi-card">
        <div class="earnings-kpi-title"><i class="fa-solid fa-sun" style="color:var(--gold-primary);"></i> Today's Shift Earnings</div>
        <div class="earnings-kpi-value">PKR @Model.TodayEarnings.ToString("N0")</div>
    </div>

    <div class="earnings-kpi-card">
        <div class="earnings-kpi-title"><i class="fa-solid fa-calendar-week" style="color:var(--teal-light);"></i> This Week's Revenue</div>
        <div class="earnings-kpi-value" style="color:var(--teal-light);">PKR @Model.WeekEarnings.ToString("N0")</div>
    </div>

    <div class="earnings-kpi-card">
        <div class="earnings-kpi-title"><i class="fa-solid fa-vault" style="color:var(--gold-accent);"></i> This Month's Cumulative</div>
        <div class="earnings-kpi-value" style="color:var(--gold-accent);">PKR @Model.MonthEarnings.ToString("N0")</div>
    </div>
</div>

<!-- ── Earnings Itemized History Table ── -->
<div class="earnings-history-card">
    <div class="commission-note-banner">
        <div>
            <i class="fa-solid fa-circle-info" style="margin-right:8px; color:var(--gold-primary);"></i>
            <strong>Commission Policy:</strong> Currently calculating 100% bill value for assigned client appointments (Configurable via Admin portal).
        </div>
        <span style="background:rgba(212,175,55,0.2); color:var(--gold-primary); padding:4px 12px; border-radius:50px; font-size:0.78rem; font-weight:700;">Active Commission: @Model.CommissionPercentage%</span>
    </div>

    <div style="margin-bottom:20px;">
        <h3 style="font-family:var(--font-display); font-size:1.35rem; color:#ffffff;"><i class="fa-solid fa-file-invoice-dollar" style="color:var(--gold-primary);"></i> Completed Service Receipts</h3>
        <p style="font-size:0.82rem; color:var(--text-body);">Itemized log of generated bills linked to your booth sessions</p>
    </div>

    <table class="custom-earnings-table">
        <thead>
            <tr>
                <th>Receipt ID</th>
                <th>Client Name</th>
                <th>Treatment Service</th>
                <th>Bill Date & Time</th>
                <th style="text-align:right;">Amount Earned</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.EarningsHistory != null && Model.EarningsHistory.Count > 0)
            {
                foreach (var item in Model.EarningsHistory)
                {
                    <tr>
                        <td style="font-family:var(--font-display); font-weight:700; color:var(--gold-accent);">#INV-@item.BillId.ToString("D4")</td>
                        <td><span style="font-weight:700;">@item.ClientName</span></td>
                        <td><span style="color:var(--teal-light);">@item.ServiceName</span></td>
                        <td style="color:var(--text-body);">@item.BillDate.ToString("MMM dd, yyyy - hh:mm tt")</td>
                        <td style="text-align:right; font-weight:800; color:#4ade80;">PKR @item.TotalAmount.ToString("N0")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" style="text-align:center; color:var(--text-body); padding:32px;">
                        No billing history recorded for your shift yet.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
