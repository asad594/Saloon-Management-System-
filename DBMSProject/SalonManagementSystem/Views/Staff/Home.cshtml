@model SalonManagementSystem.Models.DashboardModel
@{
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
    var userName = Context.Session.GetString("UserName") ?? "Specialist";
}

@section Styles {
    <style>
        /* ── Staff Hero Welcome Banner ── */
        .staff-hero-banner {
            background: linear-gradient(135deg, rgba(19, 25, 36, 0.95) 0%, rgba(11, 14, 20, 0.98) 100%);
            border: 1px solid var(--border-gold);
            border-radius: 24px;
            padding: 32px;
            margin-bottom: 32px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .staff-hero-banner::before {
            content: '';
            position: absolute;
            top: -40%; right: -5%;
            width: 320px; height: 320px;
            background: radial-gradient(circle, rgba(20, 184, 166, 0.18) 0%, transparent 70%);
            pointer-events: none;
        }

        .staff-hero-banner::after {
            content: '';
            position: absolute;
            bottom: -50%; left: -10%;
            width: 300px; height: 300px;
            background: radial-gradient(circle, rgba(212, 175, 55, 0.15) 0%, transparent 70%);
            pointer-events: none;
        }

        .hero-profile-group {
            display: flex;
            align-items: center;
            gap: 20px;
            z-index: 2;
        }

        .hero-avatar-badge {
            width: 64px;
            height: 64px;
            border-radius: 20px;
            background: linear-gradient(135deg, var(--teal-primary), var(--gold-primary));
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 1.8rem;
            font-weight: 800;
            border: 2px solid var(--gold-primary);
            box-shadow: 0 0 25px rgba(212, 175, 55, 0.35);
        }

        .hero-text-content h1 {
            font-family: var(--font-display);
            font-size: 1.85rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .hero-text-content p {
            font-size: 0.9rem;
            color: var(--text-body);
        }

        .hero-clock-widget {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(212, 175, 55, 0.25);
            padding: 12px 20px;
            border-radius: 50px;
            display: flex;
            align-items: center;
            gap: 14px;
            z-index: 2;
        }

        .clock-time {
            font-family: var(--font-display);
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--gold-accent);
        }

        .clock-date {
            font-size: 0.78rem;
            color: var(--teal-light);
        }

        .btn-action-hero {
            background: linear-gradient(90deg, var(--teal-primary), var(--gold-primary));
            color: #ffffff;
            padding: 10px 22px;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            box-shadow: 0 6px 20px rgba(13, 148, 136, 0.35);
            transition: all 0.3s ease;
        }

        .btn-action-hero:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(212, 175, 55, 0.45);
            color: #ffffff;
        }

        /* ── Metric KPI Cards Grid ── */
        .staff-kpi-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 32px;
        }

        .staff-kpi-card {
            background: rgba(19, 25, 36, 0.75);
            backdrop-filter: blur(14px);
            border: 1px solid var(--border-gold);
            border-radius: 20px;
            padding: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
            transition: all 0.35s ease;
        }

        .staff-kpi-card:hover {
            transform: translateY(-4px);
            border-color: var(--teal-glow);
            box-shadow: 0 14px 35px rgba(20, 184, 166, 0.25);
        }

        .kpi-text-info .kpi-number {
            font-family: var(--font-display);
            font-size: 2rem;
            font-weight: 800;
            color: #ffffff;
            line-height: 1.1;
            margin-bottom: 4px;
        }

        .kpi-text-info .kpi-title {
            font-size: 0.82rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: var(--text-body);
        }

        .kpi-icon-badge {
            width: 52px;
            height: 52px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
            flex-shrink: 0;
        }

        .icon-appts { background: rgba(20, 184, 166, 0.15); color: #2dd4bf; border: 1px solid rgba(20, 184, 166, 0.3); }
        .icon-sales { background: rgba(212, 175, 55, 0.15); color: #d4af37; border: 1px solid rgba(212, 175, 55, 0.3); }
        .icon-scheduled { background: rgba(168, 85, 247, 0.15); color: #c084fc; border: 1px solid rgba(168, 85, 247, 0.3); }
        .icon-services { background: rgba(34, 197, 94, 0.15); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.3); }

        @@media (max-width: 992px) {
            .staff-kpi-grid { grid-template-columns: repeat(2, 1fr); }
        }

        @@media (max-width: 576px) {
            .staff-kpi-grid { grid-template-columns: 1fr; }
        }
    </style>
}

<!-- ── Staff Hero Welcome Banner ── -->
<div class="staff-hero-banner">
    <div class="hero-profile-group">
        <div class="hero-avatar-badge">@userName.Substring(0, 1)</div>
        <div class="hero-text-content">
            <h1>Welcome Back, @userName <i class="fa-solid fa-wand-magic-sparkles" style="color:var(--gold-primary); font-size:1.4rem;"></i></h1>
            <p>StylOnyx Executive Studio &bull; Master Specialist Workstation</p>
        </div>
    </div>

    <div class="hero-clock-widget">
        <div>
            <div class="clock-time" id="liveClockTime">12:00:00 PM</div>
            <div class="clock-date" id="liveClockDate">Saturday, August 8, 2026</div>
        </div>
        <a href="/Staff/BookAppointment" class="btn-action-hero">
            <i class="fa-solid fa-plus"></i> New Booking
        </a>
    </div>
</div>

<!-- ── Staff KPI Metric Cards Grid ── -->
<div class="staff-kpi-grid">
    <div class="staff-kpi-card">
        <div class="kpi-text-info">
            <div class="kpi-number">@Model.TodayAppointments</div>
            <div class="kpi-title">Today's Appointments</div>
        </div>
        <div class="kpi-icon-badge icon-appts"><i class="fa-solid fa-calendar-check"></i></div>
    </div>

    <div class="staff-kpi-card">
        <div class="kpi-text-info">
            <div class="kpi-number">PKR @Model.TodaySales.ToString("N0")</div>
            <div class="kpi-title">Today's Shift Revenue</div>
        </div>
        <div class="kpi-icon-badge icon-sales"><i class="fa-solid fa-sack-dollar"></i></div>
    </div>

    <div class="staff-kpi-card">
        <div class="kpi-text-info">
            <div class="kpi-number">@Model.TotalAppointments</div>
            <div class="kpi-title">Total Scheduled</div>
        </div>
        <div class="kpi-icon-badge icon-scheduled"><i class="fa-solid fa-clock-history"></i></div>
    </div>

    <div class="staff-kpi-card">
        <div class="kpi-text-info">
            <div class="kpi-number">@Model.TotalServices</div>
            <div class="kpi-title">Catalog Services</div>
        </div>
        <div class="kpi-icon-badge icon-services"><i class="fa-solid fa-spa"></i></div>
    </div>
</div>

<div>
    <h3 style="margin-top:40px; color:#fff;">Today's Appointments Chart</h3>
    <canvas id="appointmentChart" height="100"></canvas>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        function updateLiveClock() {
            const now = new Date();
            const timeStr = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            const dateStr = now.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
            const clockTimeEl = document.getElementById('liveClockTime');
            const clockDateEl = document.getElementById('liveClockDate');
            if (clockTimeEl) clockTimeEl.innerText = timeStr;
            if (clockDateEl) clockDateEl.innerText = dateStr;
        }
        setInterval(updateLiveClock, 1000);
        updateLiveClock();

        fetch('/Staff/GetTodayAppointmentsChart')
        .then(res => res.json())
        .then(data => {
            const labels = data.map(x => x.time);
            const values = data.map(x => x.total);
            const ctx = document.getElementById('appointmentChart').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Appointments Today',
                        data: values,
                        backgroundColor: 'rgba(20, 184, 166, 0.6)',
                        borderColor: '#2dd4bf',
                        borderWidth: 1
                    }]
                }
            });
        });
    </script>
}