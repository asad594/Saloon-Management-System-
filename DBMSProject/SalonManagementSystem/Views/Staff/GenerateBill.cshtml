@using SalonManagementSystem.Models
@model object
@{
    Layout = "~/Views/Shared/_StaffLayout.cshtml";
}

@if (Model is BillViewModel bill)
{
    <div style="max-width:650px; margin:20px auto; background:linear-gradient(145deg, #131924 0%, #0e1219 100%); padding:32px; border-radius:20px; border:1px solid rgba(212,175,55,0.3); box-shadow:0 12px 36px rgba(0,0,0,0.4); box-sizing:border-box;">
        <h2 style="font-family:'Playfair Display', serif; color:#ffffff; font-size:1.7rem; margin-bottom:6px; text-align:center;">
            <i class="fa-solid fa-circle-check" style="color:#2dd4bf; margin-right:8px;"></i> Bill Generated Successfully
        </h2>
        <p style="text-align:center; color:#94a3b8; font-size:0.88rem; margin-bottom:24px;">StylOnyx Executive Salon & Spa Receipt</p>
        <hr style="border:0; border-top:1px solid rgba(212,175,55,0.2); margin-bottom:20px;" />

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:20px; font-size:0.95rem;">
            <div><strong style="color:#d4af37;">Client Name:</strong> <span style="color:#fff;">@bill.ClientName</span></div>
            <div><strong style="color:#d4af37;">Phone Number:</strong> <span style="color:#fff;">@bill.Phone</span></div>
            <div><strong style="color:#d4af37;">Assigned Staff:</strong> <span style="color:#fff;">@bill.StaffName</span></div>
            <div><strong style="color:#d4af37;">Service booked:</strong> <span style="color:#2dd4bf; font-weight:700;">@bill.ServiceName</span></div>
            <div><strong style="color:#d4af37;">Date:</strong> <span style="color:#fff;">@bill.AppDate.ToString("yyyy-MM-dd")</span></div>
            <div><strong style="color:#d4af37;">Time Slot:</strong> <span style="color:#fff;">@bill.AppTime</span></div>
        </div>

        <div style="background:rgba(212,175,55,0.1); border:1px solid rgba(212,175,55,0.3); padding:16px; border-radius:14px; text-align:center; margin-bottom:24px;">
            <span style="font-size:0.9rem; color:#94a3b8; text-transform:uppercase; letter-spacing:1px; display:block; margin-bottom:4px;">Total Bill Amount</span>
            <span style="font-family:'Playfair Display', serif; font-size:1.8rem; font-weight:800; color:#d4af37;">PKR @bill.Total.ToString("N0")</span>
        </div>

        <a class="btn" href="/Staff/BookAppointment" style="display:block; text-align:center; padding:14px; background:linear-gradient(90deg, #0d9488, #d4af37); border-radius:50px; text-decoration:none; font-weight:800; font-size:1.02rem;">
            <i class="fa-solid fa-calendar-plus"></i> Book Another Appointment
        </a>
    </div>
}
else if (Model is List<SalonService> services)
{
    <div style="max-width:800px; margin:20px auto; background:linear-gradient(145deg, #131924 0%, #0e1219 100%); padding:28px; border-radius:20px; border:1px solid rgba(212,175,55,0.25); box-sizing:border-box; overflow-x:auto;">
        <h2 style="font-family:'Playfair Display', serif; color:#fff; font-size:1.6rem; margin-bottom:16px;">Available Salon Services</h2>
        <table style="width:100%; border-collapse:collapse;">
            <thead>
                <tr>
                    <th style="text-align:left; padding:12px; border-bottom:1px solid rgba(212,175,55,0.2); color:#d4af37;">Service Name</th>
                    <th style="text-align:right; padding:12px; border-bottom:1px solid rgba(212,175,55,0.2); color:#d4af37;">Price (PKR)</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var service in services)
            {
                <tr>
                    <td style="padding:12px; border-bottom:1px solid rgba(255,255,255,0.06); font-weight:600; color:#fff;">@service.ServiceName</td>
                    <td style="padding:12px; border-bottom:1px solid rgba(255,255,255,0.06); text-align:right; color:#2dd4bf; font-weight:700;">PKR @service.ServicePrice.ToString("N0")</td>
                </tr>
            }
            </tbody>
        </table>
        <p style="margin-top:20px; color:#94a3b8; font-size:0.88rem;">To generate a bill, use <strong>Book Appointment</strong> and select a service.</p>
    </div>
}
else
{
    <div style="background:#131924; padding:30px; border-radius:15px; border:1px solid rgba(212,175,55,0.2); text-align:center; color:#94a3b8;">No bill data available.</div>
}
