@model SalonManagementSystem.Models.RegisterViewModel
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

@section Styles {
    <style>
        /* ── Fullscreen 50/50 Split Container ── */
        .login-split-container {
            display: flex;
            flex-direction: row;
            width: 100vw;
            height: 100vh;
            min-height: 100vh;
            background: #0b0e14;
            overflow: hidden;
            position: relative;
        }

        /* ── Left Side: Register Form Panel (50% Width) ── */
        .login-form-panel {
            width: 50%;
            height: 100vh;
            background: linear-gradient(145deg, #131924 0%, #0e1219 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 40px;
            position: relative;
            z-index: 5;
            box-shadow: 20px 0 50px rgba(0, 0, 0, 0.5);
            border-right: 1px solid var(--border-gold);
            overflow-y: auto;
        }

        /* Gold Geometric Frame Lines */
        .login-form-panel::before {
            content: '';
            position: absolute;
            top: 20px; left: 20px; bottom: 20px; right: 20px;
            border: 1px solid rgba(212, 175, 55, 0.15);
            border-radius: 24px;
            pointer-events: none;
        }

        .login-form-content {
            width: 100%;
            max-width: 440px;
            position: relative;
            z-index: 2;
        }

        /* Brand Logo Header */
        .brand-logo-wrapper {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

        .brand-logo-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: linear-gradient(135deg, #d4af37 0%, #0d9488 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            color: #ffffff;
            box-shadow: 0 8px 20px rgba(212, 175, 55, 0.3);
        }

        .brand-logo-text {
            font-family: 'Playfair Display', serif;
            font-size: 1.7rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.01em;
        }

        .brand-logo-text span {
            color: #d4af37;
        }

        /* Titles */
        .login-title {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 4px;
            line-height: 1.2;
        }

        .login-subtitle {
            font-size: 0.84rem;
            color: var(--text-body);
            margin-bottom: 24px;
        }

        /* Input Grid for Registration */
        .form-grid-two-col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .form-field-group {
            margin-bottom: 16px;
        }

        .field-label {
            font-size: 0.78rem;
            font-weight: 600;
            color: #e2e8f0;
            margin-bottom: 6px;
            display: block;
        }

        .field-input-wrapper {
            position: relative;
        }

        .form-control-custom {
            width: 100%;
            padding: 13px 16px 13px 44px;
            background: rgba(255, 255, 255, 0.04);
            border: 1.5px solid rgba(255, 255, 255, 0.1);
            border-radius: 12px;
            color: #ffffff;
            font-size: 0.9rem;
            outline: none;
            transition: all 0.3s ease;
        }

        .form-control-custom:focus {
            border-color: #d4af37;
            background: rgba(212, 175, 55, 0.05);
            box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.15);
        }

        .field-icon-left {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #d4af37;
            font-size: 0.95rem;
            pointer-events: none;
        }

        /* ── Submit Button ── */
        .btn-gradient-submit {
            width: 100%;
            padding: 15px;
            background: linear-gradient(90deg, #0d9488 0%, #14b8a6 40%, #d4af37 100%);
            border: none;
            border-radius: 50px;
            color: #ffffff;
            font-size: 0.95rem;
            font-weight: 700;
            letter-spacing: 0.02em;
            cursor: pointer;
            transition: all 0.35s ease;
            box-shadow: 0 10px 28px rgba(13, 148, 136, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 8px;
        }

        .btn-gradient-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 36px rgba(212, 175, 55, 0.45);
        }

        /* Footer Link */
        .register-footer-text {
            margin-top: 18px;
            text-align: center;
            font-size: 0.85rem;
            color: var(--text-body);
        }

        .register-footer-text a {
            color: #d4af37;
            font-weight: 700;
            text-decoration: none;
            margin-left: 4px;
        }

        .register-footer-text a:hover {
            text-decoration: underline;
        }

        /* Error Banner */
        .error-banner {
            background: rgba(244, 63, 94, 0.15);
            border: 1px solid rgba(244, 63, 94, 0.4);
            border-radius: 12px;
            padding: 10px 14px;
            color: #fca5a5;
            font-size: 0.82rem;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 16px;
            animation: shake 0.4s ease;
        }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-6px); }
            40% { transform: translateX(6px); }
            60% { transform: translateX(-4px); }
            80% { transform: translateX(4px); }
        }

        /* ── Right Side: Women's Luxury Salon Showcase (50% Width) ── */
        .salon-showcase-panel {
            width: 50%;
            height: 100vh;
            position: relative;
            background: url('/images/salon_showcase.png') center center / cover no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 50px;
            overflow: hidden;
        }

        .salon-showcase-panel::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(11, 14, 20, 0.7) 0%, rgba(11, 14, 20, 0.2) 50%, rgba(11, 14, 20, 0.8) 100%);
            z-index: 1;
        }

        .showcase-top-headline {
            position: relative;
            z-index: 2;
            text-align: center;
            margin-top: 10px;
        }

        .showcase-heading-text {
            font-size: 2.2rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            text-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
        }

        .floating-badges-container {
            position: relative;
            z-index: 2;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 16px;
            margin-bottom: 20px;
        }

        .floating-badge-item {
            background: rgba(19, 25, 36, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(45, 212, 191, 0.4);
            border-radius: 50px;
            padding: 10px 22px;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 10px 30px rgba(13, 148, 136, 0.3);
            animation: floatBadge 4s ease-in-out infinite alternate;
        }

        @@keyframes floatBadge {
            0% { transform: translateY(0); }
            100% { transform: translateY(-10px); }
        }

        .badge-circle-icon {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #14b8a6, #d4af37);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 0.9rem;
        }

        .badge-text-title {
            font-size: 0.84rem;
            font-weight: 700;
            color: #ffffff;
        }

        #sparkle-canvas {
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
        }

        @@media (max-width: 900px) {
            .salon-showcase-panel { display: none; }
            .login-form-panel { width: 100%; border-right: none; }
        }
    </style>
}

<div class="login-split-container">

    <!-- ── Left Side: Registration Form ── -->
    <div class="login-form-panel">
        <div class="login-form-content">

            <!-- Brand Logo -->
            <div class="brand-logo-wrapper">
                <div class="brand-logo-icon">
                    <i class="fa-solid fa-scissors"></i>
                </div>
                <div class="brand-logo-text">Salon <span>Management</span></div>
            </div>

            <!-- Welcome Title -->
            <h1 class="login-title">Create Account</h1>
            <p class="login-subtitle">Join Salon Management System</p>

            <!-- Error Alert -->
            @if (!string.IsNullOrEmpty(ViewBag.Error as string))
            {
                <div class="error-banner">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <!-- Registration Form -->
            <form method="post" id="registerForm">

                <!-- Full Name -->
                <div class="form-field-group">
                    <label class="field-label" for="fullNameInput">Full Name</label>
                    <div class="field-input-wrapper">
                        <input type="text" id="fullNameInput" name="FullName" class="form-control-custom"
                               value="@Model?.FullName" placeholder="Enter your full name..." required />
                        <i class="fa-solid fa-id-card field-icon-left"></i>
                    </div>
                </div>

                <!-- Username & Phone in 2 Columns -->
                <div class="form-grid-two-col">
                    <div class="form-field-group">
                        <label class="field-label" for="regUsernameInput">Username</label>
                        <div class="field-input-wrapper">
                            <input type="text" id="regUsernameInput" name="UserName" class="form-control-custom"
                                   value="@Model?.UserName" placeholder="Username..." required />
                            <i class="fa-solid fa-user field-icon-left"></i>
                        </div>
                    </div>

                    <div class="form-field-group">
                        <label class="field-label" for="phoneInput">Phone Number</label>
                        <div class="field-input-wrapper">
                            <input type="tel" id="phoneInput" name="Phone" class="form-control-custom"
                                   value="@Model?.Phone" placeholder="03001234567" />
                            <i class="fa-solid fa-phone field-icon-left"></i>
                        </div>
                    </div>
                </div>

                <!-- Email -->
                <div class="form-field-group">
                    <label class="field-label" for="emailInput">Email Address</label>
                    <div class="field-input-wrapper">
                        <input type="email" id="emailInput" name="Email" class="form-control-custom"
                               value="@Model?.Email" placeholder="name@example.com" />
                        <i class="fa-solid fa-envelope field-icon-left"></i>
                    </div>
                </div>

                <!-- Password -->
                <div class="form-field-group">
                    <label class="field-label" for="regPasswordInput">Password</label>
                    <div class="field-input-wrapper">
                        <input type="password" id="regPasswordInput" name="Password" class="form-control-custom"
                               placeholder="Choose a strong password..." required />
                        <i class="fa-solid fa-lock field-icon-left"></i>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-gradient-submit" id="regSubmitBtn">
                    <span id="regBtnText">Create User Account</span>
                    <i class="fa-solid fa-user-plus" id="regBtnIcon"></i>
                </button>

            </form>

            <!-- Navigation back to Login -->
            <div class="register-footer-text">
                Already have an account? <a href="/Login/Index">Log In Here</a>
            </div>

        </div>
    </div>

    <!-- ── Right Side: Women's Luxury Salon Showcase ── -->
    <div class="salon-showcase-panel">
        <canvas id="sparkle-canvas"></canvas>

        <div class="showcase-top-headline">
            <div class="showcase-heading-text">MANAGE . GROW . SHINE.</div>
        </div>

        <div class="floating-badges-container">
            <div class="floating-badge-item">
                <div class="badge-circle-icon">
                    <i class="fa-solid fa-spray-can-sparkles"></i>
                </div>
                <div class="badge-text-title">Luxury Hair & Styling</div>
            </div>

            <div class="floating-badge-item">
                <div class="badge-circle-icon">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
                <div class="badge-text-title">Smart Appointments</div>
            </div>

            <div class="floating-badge-item">
                <div class="badge-circle-icon">
                    <i class="fa-solid fa-gem"></i>
                </div>
                <div class="badge-text-title">VIP Client Experience</div>
            </div>
        </div>
    </div>

</div>

<script>
    const regForm = document.getElementById('registerForm');
    const regSubmitBtn = document.getElementById('regSubmitBtn');

    regForm.addEventListener('submit', () => {
        document.getElementById('regBtnText').textContent = 'Creating Account...';
        document.getElementById('regBtnIcon').className = 'fa-solid fa-circle-notch fa-spin';
        regSubmitBtn.style.opacity = '0.85';
    });

    const canvas = document.getElementById('sparkle-canvas');
    if (canvas) {
        const ctx = canvas.getContext('2d');
        let W = canvas.width = canvas.parentElement.clientWidth;
        let H = canvas.height = canvas.parentElement.clientHeight;

        window.addEventListener('resize', () => {
            if (!canvas.parentElement) return;
            W = canvas.width = canvas.parentElement.clientWidth;
            H = canvas.height = canvas.parentElement.clientHeight;
        });

        const sparkles = [];
        for (let i = 0; i < 40; i++) {
            sparkles.push({
                x: Math.random() * W,
                y: Math.random() * H,
                size: Math.random() * 3 + 1,
                alpha: Math.random(),
                speed: Math.random() * 0.02 + 0.005,
                color: Math.random() > 0.5 ? '#d4af37' : '#2dd4bf'
            });
        }

        function drawSparkles() {
            ctx.clearRect(0, 0, W, H);
            for (let s of sparkles) {
                ctx.beginPath();
                ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
                ctx.fillStyle = s.color;
                ctx.globalAlpha = Math.abs(Math.sin(s.alpha));
                ctx.fill();
                s.alpha += s.speed;
            }
            requestAnimationFrame(drawSparkles);
        }
        drawSparkles();
    }
</script>
