@model SalonManagementSystem.Models.RegisterViewModel
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    string defaultRole = string.Equals(Model?.Role, "Staff", StringComparison.OrdinalIgnoreCase) ? "Staff" : "User";
}

@section Styles {
    <style>
        .login-split-container {
            display: flex;
            flex-direction: row;
            width: 100vw;
            height: 100vh;
            min-height: 100vh;
            background: #0b0e14;
            overflow: hidden;
            position: relative;
        }

        .login-form-panel {
            width: 50%;
            height: 100vh;
            background: linear-gradient(145deg, #131924 0%, #0e1219 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 30px 40px;
            position: relative;
            z-index: 5;
            box-shadow: 20px 0 50px rgba(0, 0, 0, 0.5);
            border-right: 1px solid var(--border-gold);
            overflow-y: auto;
        }

        .login-form-panel::before {
            content: '';
            position: absolute;
            top: 20px; left: 20px; bottom: 20px; right: 20px;
            border: 1px solid rgba(212, 175, 55, 0.15);
            border-radius: 24px;
            pointer-events: none;
        }

        .login-form-content {
            width: 100%;
            max-width: 440px;
            position: relative;
            z-index: 2;
        }

        .brand-logo-wrapper {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
        }

        .brand-logo-icon {
            width: 42px;
            height: 42px;
            border-radius: 12px;
            background: linear-gradient(135deg, #d4af37 0%, #0d9488 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            color: #ffffff;
            box-shadow: 0 8px 20px rgba(212, 175, 55, 0.3);
        }

        .brand-logo-text {
            font-family: 'Playfair Display', serif;
            font-size: 1.7rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.01em;
        }

        .brand-logo-text span {
            color: #d4af37;
        }

        .login-title {
            font-family: 'Playfair Display', serif;
            font-size: 1.95rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 4px;
            line-height: 1.2;
        }

        .login-subtitle {
            font-size: 0.86rem;
            color: var(--text-body);
            margin-bottom: 20px;
        }

        /* Role Selector Cards */
        .role-switch-container {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(212, 175, 55, 0.25);
            border-radius: 50px;
            padding: 4px;
            display: flex;
            gap: 4px;
            margin-bottom: 20px;
        }

        .role-tab-btn {
            flex: 1;
            padding: 10px 14px;
            border-radius: 50px;
            border: none;
            background: transparent;
            color: var(--text-body);
            font-family: var(--font-sans);
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

        .role-tab-btn.active {
            background: linear-gradient(135deg, #0d9488 0%, #14b8a6 100%);
            color: #ffffff;
            box-shadow: 0 4px 16px rgba(13, 148, 136, 0.4);
        }

        .role-tab-btn.active.staff-active {
            background: linear-gradient(135deg, #d4af37 0%, #f2ca50 100%);
            color: #0b0e14;
            box-shadow: 0 4px 16px rgba(212, 175, 55, 0.4);
        }

        .form-grid-two-col {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .form-field-group {
            margin-bottom: 16px;
        }

        .field-label {
            font-size: 0.88rem;
            font-weight: 700;
            color: #f1f5f9;
            margin-bottom: 6px;
            display: block;
            letter-spacing: 0.3px;
        }

        .field-input-wrapper {
            position: relative;
        }

        .form-control-custom {
            width: 100%;
            padding: 13px 14px 13px 44px;
            background: rgba(255, 255, 255, 0.05);
            border: 1.5px solid rgba(255, 255, 255, 0.15);
            border-radius: 12px;
            color: #ffffff !important;
            font-size: 1.05rem !important;
            font-weight: 600 !important;
            letter-spacing: 0.5px;
            outline: none;
            transition: all 0.3s ease;
        }

        .form-control-custom::placeholder {
            color: rgba(255, 255, 255, 0.45) !important;
            font-size: 0.95rem !important;
            font-weight: 400 !important;
        }

        .form-control-custom:focus {
            border-color: #d4af37;
            background: rgba(212, 175, 55, 0.08);
            box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.2);
        }

        .field-icon-left {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #d4af37;
            font-size: 1.05rem;
            pointer-events: none;
        }

        .btn-gradient-submit {
            width: 100%;
            padding: 15px;
            background: linear-gradient(90deg, #0d9488 0%, #14b8a6 40%, #d4af37 100%);
            border: none;
            border-radius: 50px;
            color: #ffffff;
            font-size: 1.05rem;
            font-weight: 800;
            letter-spacing: 0.03em;
            cursor: pointer;
            transition: all 0.35s ease;
            box-shadow: 0 10px 28px rgba(13, 148, 136, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 6px;
        }

        .btn-gradient-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 36px rgba(212, 175, 55, 0.45);
        }

        .register-footer-text {
            margin-top: 18px;
            text-align: center;
            font-size: 0.88rem;
            color: var(--text-body);
        }

        .register-footer-text a {
            color: #d4af37;
            font-weight: 700;
            text-decoration: none;
            margin-left: 4px;
        }

        .error-banner {
            background: rgba(244, 63, 94, 0.15);
            border: 1px solid rgba(244, 63, 94, 0.4);
            border-radius: 12px;
            padding: 10px 14px;
            color: #fca5a5;
            font-size: 0.82rem;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 16px;
        }

        .salon-showcase-panel {
            width: 50%;
            height: 100vh;
            position: relative;
            background: url('/images/salon_showcase.png') center center / cover no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 50px;
            overflow: hidden;
        }

        .salon-showcase-panel::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(11, 14, 20, 0.7) 0%, rgba(11, 14, 20, 0.2) 50%, rgba(11, 14, 20, 0.8) 100%);
            z-index: 1;
        }

        .showcase-top-headline {
            position: relative;
            z-index: 2;
            text-align: center;
            margin-top: 10px;
        }

        .showcase-heading-text {
            font-size: 2.1rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            text-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
        }

        @@media (max-width: 900px) {
            .salon-showcase-panel { display: none; }
            .login-form-panel { width: 100%; border-right: none; }
        }
    </style>
}

<div class="login-split-container">

    <!-- ── Left Side: Registration Form ── -->
    <div class="login-form-panel">
        <div class="login-form-content">

            <!-- Brand Logo -->
            <div class="brand-logo-wrapper">
                <div class="brand-logo-icon">
                    <i class="fa-solid fa-scissors"></i>
                </div>
                <div class="brand-logo-text">Styl<span>Onyx</span></div>
            </div>

            <!-- Welcome Title -->
            <h1 class="login-title">Create Account</h1>
            <p class="login-subtitle" id="regSubtitle">Register a new account to join StylOnyx</p>

            <!-- Role Selector Tabs -->
            <div class="role-switch-container">
                <button type="button" class="role-tab-btn @(defaultRole == "User" ? "active" : "")" id="regTabUser" onclick="setRegisterRole('User')">
                    <i class="fa-solid fa-circle-user"></i>
                    <span>Register as User</span>
                </button>
                <button type="button" class="role-tab-btn @(defaultRole == "Staff" ? "active staff-active" : "")" id="regTabStaff" onclick="setRegisterRole('Staff')">
                    <i class="fa-solid fa-scissors"></i>
                    <span>Register as Staff</span>
                </button>
            </div>

            <!-- Error Alert -->
            @if (!string.IsNullOrEmpty(ViewBag.Error as string))
            {
                <div class="error-banner">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <!-- Registration Form -->
            <form method="post" id="registerForm" novalidate>
                <input type="hidden" name="Role" id="regRoleInput" value="@defaultRole" />

                <!-- Full Name Input -->
                <div class="form-field-group">
                    <label class="field-label">Full Name</label>
                    <div class="field-input-wrapper">
                        <input type="text" name="FullName" class="form-control-custom"
                               value="@Model?.FullName" placeholder="e.g. Ayesha Khan" required />
                        <i class="fa-solid fa-user-check field-icon-left"></i>
                    </div>
                </div>

                <div class="form-grid-two-col">
                    <!-- Username Input -->
                    <div class="form-field-group">
                        <label class="field-label">Username</label>
                        <div class="field-input-wrapper">
                            <input type="text" name="UserName" class="form-control-custom"
                                   value="@Model?.UserName" placeholder="Username" required />
                            <i class="fa-solid fa-user field-icon-left"></i>
                        </div>
                    </div>

                    <!-- Phone Input -->
                    <div class="form-field-group">
                        <label class="field-label">Phone</label>
                        <div class="field-input-wrapper">
                            <input type="text" name="Phone" class="form-control-custom"
                                   value="@Model?.Phone" placeholder="03001234567" required />
                            <i class="fa-solid fa-phone field-icon-left"></i>
                        </div>
                    </div>
                </div>

                <div class="form-grid-two-col">
                    <!-- Email Input -->
                    <div class="form-field-group">
                        <label class="field-label">Email</label>
                        <div class="field-input-wrapper">
                            <input type="email" name="Email" class="form-control-custom"
                                   value="@Model?.Email" placeholder="ayesha@salon.com" required />
                            <i class="fa-solid fa-envelope field-icon-left"></i>
                        </div>
                    </div>

                    <!-- Password Input -->
                    <div class="form-field-group">
                        <label class="field-label">Password</label>
                        <div class="field-input-wrapper">
                            <input type="password" name="Password" class="form-control-custom"
                                   placeholder="Create password" required />
                            <i class="fa-solid fa-lock field-icon-left"></i>
                        </div>
                    </div>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-gradient-submit" id="regSubmitBtn">
                    <span id="regBtnText">Complete Registration</span>
                    <i class="fa-solid fa-user-plus"></i>
                </button>
            </form>

            <!-- Login Navigation Link -->
            <div class="register-footer-text">
                Already have an account? <a href="/Login/Index" id="loginBackLink">Log in here</a>
            </div>

        </div>
    </div>

    <!-- ── Right Side Showcase ── -->
    <div class="salon-showcase-panel">
        <div class="showcase-top-headline">
            <div class="showcase-heading-text">JOIN STYLONYX TODAY.</div>
        </div>
    </div>

</div>

<script>
    function setRegisterRole(role) {
        document.getElementById('regRoleInput').value = role;
        const tabUser = document.getElementById('regTabUser');
        const tabStaff = document.getElementById('regTabStaff');
        const subtitle = document.getElementById('regSubtitle');
        const btnText = document.getElementById('regBtnText');
        const loginBackLink = document.getElementById('loginBackLink');

        if (role === 'Staff') {
            tabStaff.className = 'role-tab-btn active staff-active';
            tabUser.className = 'role-tab-btn';
            subtitle.textContent = 'Register as a Staff Member / Salon Specialist';
            btnText.textContent = 'Register as Staff Specialist';
            loginBackLink.href = '/Login/Index?role=Staff';
        } else {
            tabUser.className = 'role-tab-btn active';
            tabStaff.className = 'role-tab-btn';
            subtitle.textContent = 'Register as a VIP User / Client';
            btnText.textContent = 'Register as VIP User';
            loginBackLink.href = '/Login/Index?role=User';
        }
    }

    setRegisterRole('@defaultRole');
</script>
