@model SalonManagementSystem.Models.Login
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

@section Styles {
    <style>
        /* ── Split Layout Container ── */
        .login-grid-wrapper {
            display: grid;
            grid-template-columns: 1.1fr 1fr;
            gap: 32px;
            width: 100%;
            align-items: center;
        }

        /* ── Left Panel: Brand & Feature Showcase ── */
        .brand-showcase-card {
            background: rgba(18, 12, 38, 0.45);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
            border: 1px solid var(--glass-border);
            border-radius: 32px;
            padding: 48px;
            position: relative;
            overflow: hidden;
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 580px;
        }

        .brand-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(236, 72, 153, 0.12);
            border: 1px solid rgba(236, 72, 153, 0.3);
            border-radius: 50px;
            padding: 8px 18px;
            font-size: 0.78rem;
            font-weight: 700;
            color: #f472b6;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            width: fit-content;
        }

        .brand-badge i {
            font-size: 0.9rem;
            color: #ec4899;
        }

        .brand-title-group {
            margin-top: 24px;
        }

        .brand-main-heading {
            font-family: 'Playfair Display', serif;
            font-size: 2.8rem;
            font-weight: 700;
            line-height: 1.15;
            background: linear-gradient(135deg, #ffffff 0%, #cbd5e1 50%, #f472b6 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            letter-spacing: -0.02em;
        }

        .brand-subtext {
            color: var(--text-sub);
            font-size: 0.98rem;
            line-height: 1.6;
            margin-top: 14px;
            max-width: 440px;
        }

        /* Feature Cards Grid */
        .feature-cards-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-top: 36px;
        }

        .feature-item-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 20px;
            transition: all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
            position: relative;
            overflow: hidden;
        }

        .feature-item-card:hover {
            background: rgba(236, 72, 153, 0.08);
            border-color: rgba(236, 72, 153, 0.35);
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(236, 72, 153, 0.15);
        }

        .feature-icon-wrapper {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            margin-bottom: 14px;
        }

        .icon-pink { background: linear-gradient(135deg, rgba(236,72,153,0.2), rgba(219,39,119,0.4)); color: #f472b6; }
        .icon-purple { background: linear-gradient(135deg, rgba(139,92,246,0.2), rgba(124,58,237,0.4)); color: #a78bfa; }
        .icon-gold { background: linear-gradient(135deg, rgba(245,158,11,0.2), rgba(217,119,6,0.4)); color: #fbbf24; }
        .icon-green { background: linear-gradient(135deg, rgba(16,185,129,0.2), rgba(5,150,105,0.4)); color: #34d399; }

        .feature-item-title {
            font-size: 0.92rem;
            font-weight: 700;
            color: var(--text-main);
            margin-bottom: 4px;
        }

        .feature-item-desc {
            font-size: 0.76rem;
            color: var(--text-sub);
            line-height: 1.4;
        }

        /* Stats Bar */
        .showcase-stats-bar {
            display: flex;
            align-items: center;
            gap: 24px;
            margin-top: 36px;
            padding-top: 24px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .stat-badge {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .stat-number {
            font-size: 1.25rem;
            font-weight: 800;
            color: var(--text-main);
        }

        .stat-label {
            font-size: 0.72rem;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* ── Right Panel: Interactive Login Form Card ── */
        .login-card-interactive {
            background: rgba(18, 12, 38, 0.75);
            backdrop-filter: blur(28px) saturate(200%);
            -webkit-backdrop-filter: blur(28px) saturate(200%);
            border: 1px solid var(--glass-border);
            border-radius: 32px;
            padding: 44px 40px;
            box-shadow: 
                0 30px 80px rgba(0, 0, 0, 0.7),
                0 0 0 1px rgba(255, 255, 255, 0.05) inset;
            position: relative;
            transition: transform 0.2s cubic-bezier(0.2, 0, 0.2, 1), box-shadow 0.3s ease;
        }

        .card-header-group {
            text-align: center;
            margin-bottom: 28px;
        }

        /* Dynamic Avatar Badge */
        .avatar-dynamic-badge {
            width: 72px;
            height: 72px;
            border-radius: 24px;
            margin: 0 auto 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            background: linear-gradient(135deg, #ec4899, #8b5cf6);
            box-shadow: 0 10px 30px var(--brand-primary-glow);
            transition: all 0.4s ease;
        }

        .avatar-dynamic-badge.staff-theme {
            background: linear-gradient(135deg, #6366f1, #06b6d4);
            box-shadow: 0 10px 30px rgba(99, 102, 241, 0.4);
        }

        .login-card-title {
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--text-main);
            letter-spacing: -0.01em;
        }

        .login-card-subtitle {
            font-size: 0.82rem;
            color: var(--text-sub);
            margin-top: 4px;
        }

        /* ── Role Selector Cards ── */
        .role-section-label {
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--text-muted);
            margin-bottom: 12px;
            display: block;
        }

        .role-cards-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            margin-bottom: 24px;
        }

        .role-card-option {
            position: relative;
            cursor: pointer;
        }

        .role-card-option input[type="radio"] {
            position: absolute;
            opacity: 0;
            width: 0; height: 0;
        }

        .role-card-box {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 14px;
            background: rgba(255, 255, 255, 0.03);
            border: 1.5px solid var(--glass-border);
            border-radius: 18px;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            user-select: none;
        }

        .role-card-option:hover .role-card-box {
            border-color: rgba(236, 72, 153, 0.4);
            background: rgba(236, 72, 153, 0.06);
            transform: translateY(-2px);
        }

        .role-card-option input[type="radio"]:checked + .role-card-box {
            border-color: #ec4899;
            background: linear-gradient(135deg, rgba(236, 72, 153, 0.18), rgba(139, 92, 246, 0.12));
            box-shadow: 
                0 0 0 3px rgba(236, 72, 153, 0.25),
                0 8px 24px rgba(236, 72, 153, 0.2);
            transform: translateY(-2px);
        }

        .role-icon-pill {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            color: #fff;
            flex-shrink: 0;
            transition: transform 0.3s ease;
        }

        .role-icon-pill.admin-bg { background: linear-gradient(135deg, #ec4899, #f59e0b); }
        .role-icon-pill.staff-bg { background: linear-gradient(135deg, #6366f1, #06b6d4); }

        .role-card-option input[type="radio"]:checked + .role-card-box .role-icon-pill {
            transform: scale(1.1);
        }

        .role-details {
            display: flex;
            flex-direction: column;
        }

        .role-name {
            font-size: 0.88rem;
            font-weight: 700;
            color: var(--text-main);
        }

        .role-desc {
            font-size: 0.7rem;
            color: var(--text-muted);
        }

        /* ── Input Styling ── */
        .form-group-custom {
            position: relative;
            margin-bottom: 22px;
        }

        .input-floating-wrapper {
            position: relative;
        }

        .custom-input {
            width: 100%;
            padding: 18px 48px 18px 48px;
            background: rgba(255, 255, 255, 0.04);
            border: 1.5px solid var(--glass-border);
            border-radius: 16px;
            color: var(--text-main);
            font-size: 0.95rem;
            font-family: inherit;
            outline: none;
            transition: all 0.3s ease;
        }

        .custom-input:focus {
            border-color: #ec4899;
            background: rgba(236, 72, 153, 0.06);
            box-shadow: 0 0 0 4px rgba(236, 72, 153, 0.15);
        }

        .input-icon-left {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 1rem;
            transition: color 0.3s ease;
            pointer-events: none;
        }

        .custom-input:focus ~ .input-icon-left {
            color: #ec4899;
        }

        .toggle-pw-btn {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--text-muted);
            cursor: pointer;
            font-size: 1rem;
            padding: 4px;
            transition: color 0.2s ease;
        }

        .toggle-pw-btn:hover {
            color: #ec4899;
        }

        /* Password Strength Bar */
        .pw-strength-container {
            display: flex;
            gap: 4px;
            margin-top: 8px;
            height: 4px;
            border-radius: 2px;
            overflow: hidden;
            background: rgba(255, 255, 255, 0.08);
        }

        .pw-strength-bar {
            height: 100%;
            width: 0%;
            border-radius: 2px;
            transition: width 0.3s ease, background-color 0.3s ease;
        }

        /* ── Submit Button ── */
        .btn-submit-login {
            width: 100%;
            padding: 18px;
            background: linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%);
            border: none;
            border-radius: 16px;
            color: #ffffff;
            font-size: 1rem;
            font-weight: 700;
            letter-spacing: 0.03em;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 10px 32px var(--brand-primary-glow);
            margin-top: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn-submit-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 40px rgba(236, 72, 153, 0.5);
        }

        .btn-submit-login:active {
            transform: translateY(0);
        }

        /* Ripple effect */
        .btn-submit-login .ripple {
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.35);
            transform: scale(0);
            animation: ripple-anim 0.6s linear;
            pointer-events: none;
        }

        @@keyframes ripple-anim {
            to {
                transform: scale(4);
                opacity: 0;
            }
        }

        /* ── One-Click Quick Login Pills ── */
        .quick-autofill-section {
            margin-top: 24px;
            padding-top: 20px;
            border-top: 1px dashed rgba(255, 255, 255, 0.1);
            text-align: center;
        }

        .quick-autofill-title {
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 12px;
        }

        .quick-autofill-pills {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .autofill-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--glass-border);
            border-radius: 50px;
            padding: 6px 14px;
            font-size: 0.76rem;
            font-weight: 600;
            color: var(--text-sub);
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .autofill-pill:hover {
            background: rgba(236, 72, 153, 0.15);
            border-color: rgba(236, 72, 153, 0.4);
            color: var(--text-main);
            transform: translateY(-2px);
        }

        .autofill-pill i {
            color: #f59e0b;
        }

        /* Error Box Animation */
        .error-alert-card {
            background: rgba(244, 63, 94, 0.12);
            border: 1px solid rgba(244, 63, 94, 0.3);
            border-radius: 14px;
            padding: 12px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
            color: #fca5a5;
            font-size: 0.84rem;
            animation: shake 0.4s ease;
        }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-8px); }
            40% { transform: translateX(8px); }
            60% { transform: translateX(-4px); }
            80% { transform: translateX(4px); }
        }

        /* Responsive Breakpoints */
        @@media (max-width: 992px) {
            .login-grid-wrapper {
                grid-template-columns: 1fr;
                max-width: 480px;
            }
            .brand-showcase-card {
                display: none; /* Mobile focuses cleanly on login card */
            }
        }
    </style>
}

<div class="login-grid-wrapper">

    <!-- ── Left Column: Feature Showcase ── -->
    <div class="brand-showcase-card">
        <div>
            <div class="brand-badge">
                <i class="fa-solid fa-scissors"></i> Enterprise Suite v2.4
            </div>

            <div class="brand-title-group">
                <h1 class="brand-main-heading">Salon Pro Management</h1>
                <p class="brand-subtext">
                    Streamline client appointments, staff schedules, and billing operations with real-time intelligence.
                </p>
            </div>

            <!-- Interactive Feature Cards -->
            <div class="feature-cards-container">
                <div class="feature-item-card">
                    <div class="feature-icon-wrapper icon-pink">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>
                    <div class="feature-item-title">Smart Booking</div>
                    <div class="feature-item-desc">Effortless appointment scheduling & client queues.</div>
                </div>

                <div class="feature-item-card">
                    <div class="feature-icon-wrapper icon-purple">
                        <i class="fa-solid fa-file-invoice-dollar"></i>
                    </div>
                    <div class="feature-item-title">Instant Billing</div>
                    <div class="feature-item-desc">Automated invoicing & payment tracking.</div>
                </div>

                <div class="feature-item-card">
                    <div class="feature-icon-wrapper icon-gold">
                        <i class="fa-solid fa-user-gear"></i>
                    </div>
                    <div class="feature-item-title">Staff Rosters</div>
                    <div class="feature-item-desc">Attendance logs & staff commission management.</div>
                </div>

                <div class="feature-item-card">
                    <div class="feature-icon-wrapper icon-green">
                        <i class="fa-solid fa-chart-line"></i>
                    </div>
                    <div class="feature-item-title">Live Analytics</div>
                    <div class="feature-item-desc">Revenue reports & inventory stock alerts.</div>
                </div>
            </div>
        </div>

        <!-- Stats Bar -->
        <div class="showcase-stats-bar">
            <div class="stat-badge">
                <div>
                    <div class="stat-number">99.9%</div>
                    <div class="stat-label">Uptime Reliability</div>
                </div>
            </div>
            <div class="stat-badge">
                <div>
                    <div class="stat-number">500+</div>
                    <div class="stat-label">Clients Served</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Right Column: Interactive Login Card ── -->
    <div class="login-card-interactive" id="loginCardContainer">
        
        <!-- Avatar & Header -->
        <div class="card-header-group">
            <div class="avatar-dynamic-badge" id="avatarBadge">
                <i class="fa-solid fa-crown" id="avatarIcon"></i>
            </div>
            <h2 class="login-card-title" id="welcomeTitle">Welcome Back</h2>
            <p class="login-card-subtitle" id="welcomeSubtitle">Sign in to access your dashboard portal</p>
        </div>

        <!-- Login Form -->
        <form method="post" id="loginForm" novalidate>

            <!-- Role Selector Cards -->
            <span class="role-section-label">Select Access Role</span>
            <div class="role-cards-grid">
                <label class="role-card-option">
                    <input type="radio" name="UserRole" value="Admin" id="roleAdmin"
                           @(ViewBag.Error == null ? "checked" : (Model?.UserRole == "Admin" ? "checked" : "")) />
                    <div class="role-card-box">
                        <div class="role-icon-pill admin-bg">
                            <i class="fa-solid fa-crown"></i>
                        </div>
                        <div class="role-details">
                            <span class="role-name">Admin</span>
                            <span class="role-desc">Full Control</span>
                        </div>
                    </div>
                </label>

                <label class="role-card-option">
                    <input type="radio" name="UserRole" value="Staff" id="roleStaff"
                           @(Model?.UserRole == "Staff" ? "checked" : "") />
                    <div class="role-card-box">
                        <div class="role-icon-pill staff-bg">
                            <i class="fa-solid fa-scissors"></i>
                        </div>
                        <div class="role-details">
                            <span class="role-name">Staff</span>
                            <span class="role-desc">Appointments</span>
                        </div>
                    </div>
                </label>
            </div>

            <!-- Error Notification -->
            @if (!string.IsNullOrEmpty(ViewBag.Error as string))
            {
                <div class="error-alert-card">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <!-- Password Input -->
            <div class="form-group-custom">
                <div class="input-floating-wrapper">
                    <input type="password" id="passwordInput" name="UserPassword" class="custom-input"
                           placeholder="Enter password..." required autocomplete="current-password" />
                    <i class="fa-solid fa-lock input-icon-left"></i>
                    <button type="button" class="toggle-pw-btn" id="togglePwBtn" title="Toggle password visibility">
                        <i class="fa-solid fa-eye" id="eyeIcon"></i>
                    </button>
                </div>
                <!-- Password Strength Visualizer -->
                <div class="pw-strength-container">
                    <div class="pw-strength-bar" id="pwStrengthBar"></div>
                </div>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-submit-login" id="submitBtn">
                <span id="btnText">Sign In to Portal</span>
                <i class="fa-solid fa-arrow-right-to-bracket" id="btnIcon"></i>
            </button>

        </form>

        <!-- One-Click Quick Login Pills -->
        <div class="quick-autofill-section">
            <div class="quick-autofill-title">⚡ Quick Demo Login</div>
            <div class="quick-autofill-pills">
                <button type="button" class="autofill-pill" onclick="quickFill('Admin', '123')">
                    <i class="fa-solid fa-key"></i> Admin (Pass: 123)
                </button>
                <button type="button" class="autofill-pill" onclick="quickFill('Staff', '987')">
                    <i class="fa-solid fa-key"></i> Staff (Pass: 987)
                </button>
            </div>
        </div>

    </div>
</div>

<script>
    // ── Dynamic Avatar & Theme Updates on Role Change ──
    const roleAdmin = document.getElementById('roleAdmin');
    const roleStaff = document.getElementById('roleStaff');
    const avatarBadge = document.getElementById('avatarBadge');
    const avatarIcon = document.getElementById('avatarIcon');
    const welcomeTitle = document.getElementById('welcomeTitle');
    const welcomeSubtitle = document.getElementById('welcomeSubtitle');

    function updateRoleUI() {
        if (roleStaff.checked) {
            avatarBadge.classList.add('staff-theme');
            avatarIcon.className = 'fa-solid fa-scissors';
            welcomeTitle.textContent = 'Staff Workspace';
            welcomeSubtitle.textContent = 'Ready for your shift? Sign in to view appointments';
        } else {
            avatarBadge.classList.remove('staff-theme');
            avatarIcon.className = 'fa-solid fa-crown';
            welcomeTitle.textContent = 'Admin Portal';
            welcomeSubtitle.textContent = 'Full management control dashboard';
        }
    }

    roleAdmin.addEventListener('change', updateRoleUI);
    roleStaff.addEventListener('change', updateRoleUI);
    updateRoleUI();

    // ── Password Visibility Toggle ──
    const pwInput = document.getElementById('passwordInput');
    const togglePwBtn = document.getElementById('togglePwBtn');
    const eyeIcon = document.getElementById('eyeIcon');

    togglePwBtn.addEventListener('click', () => {
        const isPw = pwInput.type === 'password';
        pwInput.type = isPw ? 'text' : 'password';
        eyeIcon.className = isPw ? 'fa-solid fa-eye-slash' : 'fa-solid fa-eye';
    });

    // ── Password Strength Bar ──
    const pwStrengthBar = document.getElementById('pwStrengthBar');
    pwInput.addEventListener('input', () => {
        const val = pwInput.value;
        if (val.length === 0) {
            pwStrengthBar.style.width = '0%';
        } else if (val.length < 3) {
            pwStrengthBar.style.width = '33%';
            pwStrengthBar.style.backgroundColor = '#f43f5e';
        } else if (val.length < 6) {
            pwStrengthBar.style.width = '66%';
            pwStrengthBar.style.backgroundColor = '#f59e0b';
        } else {
            pwStrengthBar.style.width = '100%';
            pwStrengthBar.style.backgroundColor = '#10b981';
        }
    });

    // ── Quick Demo Autofill Function ──
    function quickFill(role, pass) {
        if (role === 'Admin') {
            roleAdmin.checked = true;
        } else {
            roleStaff.checked = true;
        }
        updateRoleUI();
        
        // Typewriter animation into password box
        pwInput.value = '';
        let i = 0;
        const interval = setInterval(() => {
            if (i < pass.length) {
                pwInput.value += pass.charAt(i);
                pwInput.dispatchEvent(new Event('input'));
                i++;
            } else {
                clearInterval(interval);
                pwInput.focus();
            }
        }, 80);
    }

    // ── Button Ripple & Loading State ──
    const submitBtn = document.getElementById('submitBtn');
    const loginForm = document.getElementById('loginForm');

    submitBtn.addEventListener('click', function(e) {
        const rect = submitBtn.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;

        const ripple = document.createElement('span');
        ripple.className = 'ripple';
        ripple.style.left = `${x}px`;
        ripple.style.top = `${y}px`;
        submitBtn.appendChild(ripple);

        setTimeout(() => ripple.remove(), 600);
    });

    loginForm.addEventListener('submit', function(e) {
        if (!pwInput.value.trim()) {
            e.preventDefault();
            pwInput.focus();
            return;
        }
        document.getElementById('btnText').textContent = 'Authenticating...';
        document.getElementById('btnIcon').className = 'fa-solid fa-spinner fa-spin';
        submitBtn.style.opacity = '0.85';
    });

    // ── 3D Card Tilt Effect on Mouse Move ──
    const card = document.getElementById('loginCardContainer');
    document.addEventListener('mousemove', (e) => {
        if (window.innerWidth < 992) return;
        const xAxis = (window.innerWidth / 2 - e.pageX) / 45;
        const yAxis = (window.innerHeight / 2 - e.pageY) / 45;
        card.style.transform = `perspective(1000px) rotateY(${xAxis}deg) rotateX(${yAxis}deg)`;
    });
</script>