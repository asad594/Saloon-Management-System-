@model SalonManagementSystem.Models.Login
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

@section Styles {
    <style>
        /* ── Fullscreen 50/50 Split Container ── */
        .login-split-container {
            display: flex;
            flex-direction: row;
            width: 100vw;
            height: 100vh;
            min-height: 100vh;
            background: #0b0e14;
            overflow: hidden;
            position: relative;
        }

        /* ── Left Side: Login Form Panel (50% Width) ── */
        .login-form-panel {
            width: 50%;
            height: 100vh;
            background: linear-gradient(145deg, #131924 0%, #0e1219 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 40px;
            position: relative;
            z-index: 5;
            box-shadow: 20px 0 50px rgba(0, 0, 0, 0.5);
            border-right: 1px solid var(--border-gold);
            overflow-y: auto;
        }

        /* Gold Geometric Frame Lines */
        .login-form-panel::before {
            content: '';
            position: absolute;
            top: 20px; left: 20px; bottom: 20px; right: 20px;
            border: 1px solid rgba(212, 175, 55, 0.15);
            border-radius: 24px;
            pointer-events: none;
        }

        .login-form-content {
            width: 100%;
            max-width: 420px;
            position: relative;
            z-index: 2;
        }

        /* Brand Logo Header */
        .brand-logo-wrapper {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 24px;
        }

        .brand-logo-icon {
            width: 46px;
            height: 46px;
            border-radius: 14px;
            background: linear-gradient(135deg, #d4af37 0%, #0d9488 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            color: #ffffff;
            box-shadow: 0 8px 20px rgba(212, 175, 55, 0.3);
        }

        .brand-logo-text {
            font-family: 'Playfair Display', serif;
            font-size: 1.85rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.01em;
        }

        .brand-logo-text span {
            color: #d4af37;
        }

        /* Titles */
        .login-title {
            font-family: 'Playfair Display', serif;
            font-size: 2.2rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 6px;
            line-height: 1.2;
        }

        .login-subtitle {
            font-size: 0.88rem;
            color: var(--text-body);
            margin-bottom: 32px;
        }

        /* ── Input Fields ── */
        .form-field-group {
            margin-bottom: 22px;
        }

        .field-label {
            font-size: 0.82rem;
            font-weight: 600;
            color: #e2e8f0;
            margin-bottom: 8px;
            display: block;
        }

        .field-input-wrapper {
            position: relative;
        }

        .form-control-custom {
            width: 100%;
            padding: 16px 48px 16px 48px;
            background: rgba(255, 255, 255, 0.04);
            border: 1.5px solid rgba(255, 255, 255, 0.1);
            border-radius: 14px;
            color: #ffffff;
            font-size: 0.95rem;
            outline: none;
            transition: all 0.3s ease;
        }

        .form-control-custom:focus {
            border-color: #d4af37;
            background: rgba(212, 175, 55, 0.05);
            box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.15);
        }

        .field-icon-left {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #d4af37;
            font-size: 1rem;
            pointer-events: none;
        }

        .field-icon-right-btn {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--text-body);
            cursor: pointer;
            font-size: 1rem;
            padding: 4px;
            transition: color 0.2s ease;
        }

        .field-icon-right-btn:hover {
            color: #d4af37;
        }

        /* Remember & Forgot Password */
        .form-utility-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 28px;
            font-size: 0.82rem;
        }

        .remember-checkbox {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--text-body);
            cursor: pointer;
        }

        .remember-checkbox input {
            accent-color: #d4af37;
            width: 16px;
            height: 16px;
        }

        .forgot-link {
            color: #d4af37;
            text-decoration: none;
            font-weight: 600;
            transition: opacity 0.2s ease;
        }

        .forgot-link:hover {
            opacity: 0.8;
            text-decoration: underline;
        }

        /* ── Submit Button (Teal-to-Gold Gradient like Screenshot) ── */
        .btn-gradient-submit {
            width: 100%;
            padding: 16px;
            background: linear-gradient(90deg, #0d9488 0%, #14b8a6 40%, #d4af37 100%);
            border: none;
            border-radius: 50px;
            color: #ffffff;
            font-size: 1rem;
            font-weight: 700;
            letter-spacing: 0.02em;
            cursor: pointer;
            transition: all 0.35s ease;
            box-shadow: 0 10px 28px rgba(13, 148, 136, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            position: relative;
            overflow: hidden;
        }

        .btn-gradient-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 36px rgba(212, 175, 55, 0.45);
        }

        .btn-gradient-submit:active {
            transform: translateY(0);
        }

        /* Register Footer Link */
        .register-footer-text {
            margin-top: 24px;
            text-align: center;
            font-size: 0.88rem;
            color: var(--text-body);
        }

        .register-footer-text a {
            color: #d4af37;
            font-weight: 700;
            text-decoration: none;
            margin-left: 4px;
            transition: opacity 0.2s ease;
        }

        .register-footer-text a:hover {
            text-decoration: underline;
            opacity: 0.9;
        }

        /* One-Click Quick Pills */
        .quick-pills-row {
            margin-top: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .demo-pill-btn {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(212, 175, 55, 0.3);
            border-radius: 50px;
            padding: 6px 14px;
            font-size: 0.76rem;
            font-weight: 600;
            color: var(--text-body);
            cursor: pointer;
            transition: all 0.25s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .demo-pill-btn:hover {
            background: rgba(212, 175, 55, 0.15);
            color: #ffffff;
            transform: translateY(-2px);
        }

        .demo-pill-btn i {
            color: #d4af37;
        }

        /* Error Banner */
        .error-banner {
            background: rgba(244, 63, 94, 0.15);
            border: 1px solid rgba(244, 63, 94, 0.4);
            border-radius: 12px;
            padding: 12px 16px;
            color: #fca5a5;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            animation: shake 0.4s ease;
        }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-6px); }
            40% { transform: translateX(6px); }
            60% { transform: translateX(-4px); }
            80% { transform: translateX(4px); }
        }

        /* ── Right Side: Women's Luxury Salon Showcase (50% Width) ── */
        .salon-showcase-panel {
            width: 50%;
            height: 100vh;
            position: relative;
            background: url('/images/salon_showcase.png') center center / cover no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 50px;
            overflow: hidden;
        }

        /* Dark Vignette Overlay */
        .salon-showcase-panel::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(11, 14, 20, 0.7) 0%, rgba(11, 14, 20, 0.2) 50%, rgba(11, 14, 20, 0.8) 100%);
            z-index: 1;
        }

        /* Overlay Headline */
        .showcase-top-headline {
            position: relative;
            z-index: 2;
            text-align: center;
            margin-top: 10px;
        }

        .showcase-heading-text {
            font-size: 2.2rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            text-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
        }

        /* Floating Feature Badges Overlaid over Salon Image */
        .floating-badges-container {
            position: relative;
            z-index: 2;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 16px;
            margin-bottom: 20px;
        }

        .floating-badge-item {
            background: rgba(19, 25, 36, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(45, 212, 191, 0.4);
            border-radius: 50px;
            padding: 10px 22px;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 10px 30px rgba(13, 148, 136, 0.3);
            animation: floatBadge 4s ease-in-out infinite alternate;
        }

        .floating-badge-item:nth-child(2) { animation-delay: -1.5s; }
        .floating-badge-item:nth-child(3) { animation-delay: -3s; }

        @@keyframes floatBadge {
            0% { transform: translateY(0); }
            100% { transform: translateY(-10px); }
        }

        .badge-circle-icon {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #14b8a6, #d4af37);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 0.9rem;
            box-shadow: 0 0 15px rgba(20, 184, 166, 0.6);
        }

        .badge-text-title {
            font-size: 0.84rem;
            font-weight: 700;
            color: #ffffff;
        }

        /* Sparkle Canvas Overlay */
        #sparkle-canvas {
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
        }

        /* Responsive Breakpoint for Mobile Screens */
        @@media (max-width: 900px) {
            .login-split-container {
                flex-direction: column;
            }
            .salon-showcase-panel {
                display: none;
            }
            .login-form-panel {
                width: 100%;
                border-right: none;
            }
        }
    </style>
}

<div class="login-split-container">

    <!-- ── Left Side: Single Unified Login Form ── -->
    <div class="login-form-panel">
        <div class="login-form-content">

            <!-- Brand Logo -->
            <div class="brand-logo-wrapper">
                <div class="brand-logo-icon">
                    <i class="fa-solid fa-scissors"></i>
                </div>
                <div class="brand-logo-text">Glamour<span>Sync</span></div>
            </div>

            <!-- Welcome Title -->
            <h1 class="login-title">Welcome to GlamourSync</h1>
            <p class="login-subtitle">Login to your Management Portal</p>

            <!-- Error Alert -->
            @if (!string.IsNullOrEmpty(ViewBag.Error as string))
            {
                <div class="error-banner">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <!-- Single Unified Login Form -->
            <form method="post" id="loginForm" novalidate>

                <!-- Username Input -->
                <div class="form-field-group">
                    <label class="field-label" for="usernameInput">Username</label>
                    <div class="field-input-wrapper">
                        <input type="text" id="usernameInput" name="UserName" class="form-control-custom"
                               value="@Model?.UserName" placeholder="Enter your username..." required />
                        <i class="fa-solid fa-user field-icon-left"></i>
                    </div>
                </div>

                <!-- Password Input -->
                <div class="form-field-group">
                    <label class="field-label" for="passwordInput">Password</label>
                    <div class="field-input-wrapper">
                        <input type="password" id="passwordInput" name="UserPassword" class="form-control-custom"
                               placeholder="Enter your password..." required autocomplete="current-password" />
                        <i class="fa-solid fa-lock field-icon-left"></i>
                        <button type="button" class="field-icon-right-btn" id="togglePwBtn" title="Show/Hide password">
                            <i class="fa-solid fa-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                </div>

                <!-- Remember & Forgot Password -->
                <div class="form-utility-row">
                    <label class="remember-checkbox">
                        <input type="checkbox" checked /> Remember Me
                    </label>
                    <a href="#" class="forgot-link" onclick="Swal.fire({icon:'info', title:'Password Reset', text:'Please contact system administrator to reset credentials.', background:'#131924', color:'#fff', iconColor:'#d4af37'}); return false;">Forgot Password?</a>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-gradient-submit" id="submitBtn">
                    <span id="btnText">Log In</span>
                    <i class="fa-solid fa-arrow-right" id="btnIcon"></i>
                </button>

            </form>

            <!-- Register Navigation Link -->
            <div class="register-footer-text">
                Don't have an account? <a href="/Login/Register">Register Here</a>
            </div>

        </div>
    </div>

    <!-- ── Right Side: Luxury Women's Salon Showcase ── -->
    <div class="salon-showcase-panel">
        <canvas id="sparkle-canvas"></canvas>

        <!-- Top Headline -->
        <div class="showcase-top-headline">
            <div class="showcase-heading-text">MANAGE . GROW . SHINE.</div>
        </div>

        <!-- Floating Feature Badges Overlaid over Salon Image -->
        <div class="floating-badges-container">
            <div class="floating-badge-item">
                <div class="badge-circle-icon">
                    <i class="fa-solid fa-spray-can-sparkles"></i>
                </div>
                <div class="badge-text-title">Luxury Hair & Styling</div>
            </div>

            <div class="floating-badge-item">
                <div class="badge-circle-icon">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
                <div class="badge-text-title">Smart Appointments</div>
            </div>

            <div class="floating-badge-item">
                <div class="badge-circle-icon">
                    <i class="fa-solid fa-gem"></i>
                </div>
                <div class="badge-text-title">VIP Client Experience</div>
            </div>
        </div>
    </div>

</div>

<script>
    // ── Password Visibility Toggle ──
    const pwInput = document.getElementById('passwordInput');
    const togglePwBtn = document.getElementById('togglePwBtn');
    const eyeIcon = document.getElementById('eyeIcon');
    const userInput = document.getElementById('usernameInput');

    togglePwBtn.addEventListener('click', () => {
        const isPw = pwInput.type === 'password';
        pwInput.type = isPw ? 'text' : 'password';
        eyeIcon.className = isPw ? 'fa-solid fa-eye-slash' : 'fa-solid fa-eye';
    });

    // ── Loading state on Submit ──
    const submitBtn = document.getElementById('submitBtn');
    const loginForm = document.getElementById('loginForm');

    loginForm.addEventListener('submit', (e) => {
        if (!userInput.value.trim() || !pwInput.value.trim()) {
            e.preventDefault();
            if (!userInput.value.trim()) userInput.focus();
            else pwInput.focus();
            return;
        }
        document.getElementById('btnText').textContent = 'Logging in...';
        document.getElementById('btnIcon').className = 'fa-solid fa-circle-notch fa-spin';
        submitBtn.style.opacity = '0.85';
    });

    // ── Sparkle Particle Effects on Right Panel ──
    const canvas = document.getElementById('sparkle-canvas');
    if (canvas) {
        const ctx = canvas.getContext('2d');
        let W = canvas.width = canvas.parentElement.clientWidth;
        let H = canvas.height = canvas.parentElement.clientHeight;

        window.addEventListener('resize', () => {
            if (!canvas.parentElement) return;
            W = canvas.width = canvas.parentElement.clientWidth;
            H = canvas.height = canvas.parentElement.clientHeight;
        });

        const sparkles = [];
        for (let i = 0; i < 40; i++) {
            sparkles.push({
                x: Math.random() * W,
                y: Math.random() * H,
                size: Math.random() * 3 + 1,
                alpha: Math.random(),
                speed: Math.random() * 0.02 + 0.005,
                color: Math.random() > 0.5 ? '#d4af37' : '#2dd4bf'
            });
        }

        function drawSparkles() {
            ctx.clearRect(0, 0, W, H);
            for (let s of sparkles) {
                ctx.beginPath();
                ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
                ctx.fillStyle = s.color;
                ctx.globalAlpha = Math.abs(Math.sin(s.alpha));
                ctx.fill();
                s.alpha += s.speed;
            }
            requestAnimationFrame(drawSparkles);
        }
        drawSparkles();
    }
</script>