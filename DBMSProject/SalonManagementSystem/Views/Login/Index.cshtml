@model SalonManagementSystem.Models.Login
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    string defaultRole = string.Equals(Model?.UserRole, "Staff", StringComparison.OrdinalIgnoreCase) ? "Staff" : "User";
}

@section Styles {
    <style>
        /* ── Fullscreen 50/50 Split Container ── */
        .login-split-container {
            display: flex;
            flex-direction: row;
            width: 100vw;
            height: 100vh;
            min-height: 100vh;
            background: #0b0e14;
            overflow: hidden;
            position: relative;
        }

        /* ── Left Side: Login Form Panel (50% Width) ── */
        .login-form-panel {
            width: 50%;
            height: 100vh;
            background: linear-gradient(145deg, #131924 0%, #0e1219 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 40px;
            position: relative;
            z-index: 5;
            box-shadow: 20px 0 50px rgba(0, 0, 0, 0.5);
            border-right: 1px solid var(--border-gold);
            overflow-y: auto;
        }

        /* Gold Geometric Frame Lines */
        .login-form-panel::before {
            content: '';
            position: absolute;
            top: 20px; left: 20px; bottom: 20px; right: 20px;
            border: 1px solid rgba(212, 175, 55, 0.15);
            border-radius: 24px;
            pointer-events: none;
        }

        .login-form-content {
            width: 100%;
            max-width: 440px;
            position: relative;
            z-index: 2;
        }

        /* Brand Logo Header */
        .brand-logo-wrapper {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

        .brand-logo-icon {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: linear-gradient(135deg, #d4af37 0%, #0d9488 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            color: #ffffff;
            box-shadow: 0 8px 20px rgba(212, 175, 55, 0.3);
        }

        .brand-logo-text {
            font-family: 'Playfair Display', serif;
            font-size: 1.85rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.01em;
        }

        .brand-logo-text span {
            color: #d4af37;
        }

        /* Titles */
        .login-title {
            font-family: 'Playfair Display', serif;
            font-size: 2.1rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 4px;
            line-height: 1.2;
        }

        .login-subtitle {
            font-size: 0.95rem;
            color: var(--text-body);
            margin-bottom: 24px;
        }

        /* ── Role Selector Tabs ── */
        .role-switch-container {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(212, 175, 55, 0.25);
            border-radius: 50px;
            padding: 4px;
            display: flex;
            gap: 4px;
            margin-bottom: 24px;
        }

        .role-tab-btn {
            flex: 1;
            padding: 10px 16px;
            border-radius: 50px;
            border: none;
            background: transparent;
            color: var(--text-body);
            font-family: var(--font-sans);
            font-size: 0.88rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: all 0.3s ease;
        }

        .role-tab-btn.active {
            background: linear-gradient(135deg, #0d9488 0%, #14b8a6 100%);
            color: #ffffff;
            box-shadow: 0 4px 16px rgba(13, 148, 136, 0.4);
        }

        .role-tab-btn.active.staff-active {
            background: linear-gradient(135deg, #d4af37 0%, #f2ca50 100%);
            color: #0b0e14;
            box-shadow: 0 4px 16px rgba(212, 175, 55, 0.4);
        }

        /* ── Input Fields ── */
        .form-field-group {
            margin-bottom: 20px;
        }

        .field-label {
            font-size: 0.92rem;
            font-weight: 700;
            color: #f1f5f9;
            margin-bottom: 8px;
            display: block;
            letter-spacing: 0.3px;
        }

        .field-input-wrapper {
            position: relative;
        }

        .form-control-custom {
            width: 100%;
            padding: 15px 48px 15px 50px;
            background: rgba(255, 255, 255, 0.05);
            border: 1.5px solid rgba(255, 255, 255, 0.15);
            border-radius: 14px;
            color: #ffffff !important;
            font-size: 1.1rem !important;
            font-weight: 600 !important;
            letter-spacing: 0.5px;
            outline: none;
            transition: all 0.3s ease;
        }

        .form-control-custom::placeholder {
            color: rgba(255, 255, 255, 0.45) !important;
            font-size: 0.98rem !important;
            font-weight: 400 !important;
        }

        .form-control-custom:focus {
            border-color: #d4af37;
            background: rgba(212, 175, 55, 0.08);
            box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.2);
        }

        .field-icon-left {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #d4af37;
            font-size: 1.15rem;
            pointer-events: none;
        }

        .field-icon-right-btn {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--text-body);
            cursor: pointer;
            font-size: 1.15rem;
            padding: 4px;
            transition: color 0.2s ease;
        }

        .field-icon-right-btn:hover {
            color: #d4af37;
        }

        /* Utility Row */
        .form-utility-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            font-size: 0.9rem;
        }

        .remember-checkbox {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #e2e8f0;
            font-size: 0.9rem;
            font-weight: 500;
            cursor: pointer;
        }

        .remember-checkbox input {
            accent-color: #d4af37;
            width: 17px;
            height: 17px;
        }

        .forgot-link {
            color: #d4af37;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 600;
            transition: opacity 0.2s ease;
        }

        .forgot-link:hover {
            opacity: 0.8;
            text-decoration: underline;
        }

        /* Submit Button */
        .btn-gradient-submit {
            width: 100%;
            padding: 15px;
            background: linear-gradient(90deg, #0d9488 0%, #14b8a6 40%, #d4af37 100%);
            border: none;
            border-radius: 50px;
            color: #ffffff;
            font-size: 1.08rem;
            font-weight: 800;
            letter-spacing: 0.03em;
            cursor: pointer;
            transition: all 0.35s ease;
            box-shadow: 0 10px 28px rgba(13, 148, 136, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn-gradient-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 36px rgba(212, 175, 55, 0.45);
        }

        /* Register Footer Link */
        .register-footer-text {
            margin-top: 22px;
            text-align: center;
            font-size: 0.92rem;
            color: var(--text-body);
        }

        .register-footer-text a {
            color: #d4af37;
            font-weight: 700;
            text-decoration: none;
            margin-left: 4px;
            transition: opacity 0.2s ease;
        }

        .register-footer-text a:hover {
            text-decoration: underline;
        }

        /* Demo Pills */
        .demo-pills-label {
            text-align: center;
            font-size: 0.76rem;
            color: var(--text-muted);
            margin-top: 20px;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .quick-pills-row {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            flex-wrap: wrap;
        }

        .demo-pill-btn {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(212, 175, 55, 0.3);
            border-radius: 50px;
            padding: 6px 14px;
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--text-body);
            cursor: pointer;
            transition: all 0.25s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .demo-pill-btn:hover {
            background: rgba(212, 175, 55, 0.18);
            color: #ffffff;
            border-color: #d4af37;
            transform: translateY(-2px);
        }

        /* Error Banner */
        .error-banner {
            background: rgba(244, 63, 94, 0.15);
            border: 1px solid rgba(244, 63, 94, 0.4);
            border-radius: 12px;
            padding: 12px 16px;
            color: #fca5a5;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            animation: shake 0.4s ease;
        }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-6px); }
            40% { transform: translateX(6px); }
            60% { transform: translateX(-4px); }
            80% { transform: translateX(4px); }
        }

        /* ── Right Side Showcase ── */
        .salon-showcase-panel {
            width: 50%;
            height: 100vh;
            position: relative;
            background: url('/images/salon_showcase.png') center center / cover no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 50px;
            overflow: hidden;
        }

        .salon-showcase-panel::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(11, 14, 20, 0.7) 0%, rgba(11, 14, 20, 0.25) 50%, rgba(11, 14, 20, 0.85) 100%);
            z-index: 1;
        }

        .showcase-top-headline {
            position: relative;
            z-index: 2;
            text-align: center;
            margin-top: 10px;
        }

        .showcase-heading-text {
            font-size: 2.1rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            text-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
        }

        .floating-badges-container {
            position: relative;
            z-index: 2;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 14px;
            margin-bottom: 20px;
        }

        .floating-badge-item {
            background: rgba(19, 25, 36, 0.85);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(45, 212, 191, 0.4);
            border-radius: 50px;
            padding: 10px 22px;
            display: flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 10px 30px rgba(13, 148, 136, 0.3);
            animation: floatBadge 4s ease-in-out infinite alternate;
        }

        .floating-badge-item:nth-child(2) { animation-delay: -1.5s; }
        .floating-badge-item:nth-child(3) { animation-delay: -3s; }

        @@keyframes floatBadge {
            0% { transform: translateY(0); }
            100% { transform: translateY(-10px); }
        }

        .badge-circle-icon {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #14b8a6, #d4af37);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 0.9rem;
            box-shadow: 0 0 15px rgba(20, 184, 166, 0.6);
        }

        .badge-text-title {
            font-size: 0.84rem;
            font-weight: 700;
            color: #ffffff;
        }

        #sparkle-canvas {
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
        }

        @@media (max-width: 900px) {
            .login-split-container { flex-direction: column; height: auto; min-height: 100vh; overflow-y: auto; }
            .salon-showcase-panel { display: none; }
            .login-form-panel { width: 100%; height: auto; min-height: 100vh; border-right: none; padding: 28px 20px; }
            .login-form-content { max-width: 100%; }
        }

        @@media (max-width: 480px) {
            .login-title { font-size: 1.65rem !important; }
            .login-subtitle { font-size: 0.85rem !important; }
            .role-tab-btn { padding: 8px 10px !important; font-size: 0.8rem !important; }
            .form-control-custom { padding: 13px 40px 13px 44px !important; font-size: 1rem !important; }
        }
    </style>
}

<div class="login-split-container">

    <!-- ── Left Side: Login Form ── -->
    <div class="login-form-panel">
        <div class="login-form-content">

            <!-- Brand Logo -->
            <div class="brand-logo-wrapper">
                <div class="brand-logo-icon">
                    <i class="fa-solid fa-scissors"></i>
                </div>
                <div class="brand-logo-text">Styl<span>Onyx</span></div>
            </div>

            <!-- Welcome Title -->
            <h1 class="login-title">Welcome Back</h1>
            <p class="login-subtitle">Sign in to your StylOnyx Executive account</p>

            <!-- Error Alert -->
            @if (!string.IsNullOrEmpty(ViewBag.Error as string))
            {
                <div class="error-banner">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span>@ViewBag.Error</span>
                </div>
            }

            <!-- Login Form -->
            <form method="post" id="loginForm" novalidate>
                <!-- Username Input -->
                <div class="form-field-group">
                    <label class="field-label" for="usernameInput">Username</label>
                    <div class="field-input-wrapper">
                        <input type="text" id="usernameInput" name="UserName" class="form-control-custom"
                               value="@Model?.UserName" placeholder="Enter username..." required />
                        <i class="fa-solid fa-user field-icon-left"></i>
                    </div>
                </div>

                <!-- Password Input -->
                <div class="form-field-group">
                    <label class="field-label" for="passwordInput">Password</label>
                    <div class="field-input-wrapper">
                        <input type="password" id="passwordInput" name="UserPassword" class="form-control-custom"
                               placeholder="Enter password..." required autocomplete="current-password" />
                        <i class="fa-solid fa-lock field-icon-left"></i>
                        <button type="button" class="field-icon-right-btn" id="togglePwBtn" title="Show/Hide password">
                            <i class="fa-solid fa-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                </div>

                <!-- Remember & Forgot Password -->
                <div class="form-utility-row">
                    <label class="remember-checkbox">
                        <input type="checkbox" checked /> Remember Me
                    </label>
                    <a href="#" class="forgot-link" onclick="Swal.fire({icon:'info', title:'Password Reset', text:'Please contact system administrator to reset credentials.', background:'#131924', color:'#fff', iconColor:'#d4af37'}); return false;">Forgot Password?</a>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-gradient-submit" id="submitBtn">
                    <span id="btnText">Log In as User</span>
                    <i class="fa-solid fa-arrow-right" id="btnIcon"></i>
                </button>
            </form>


            <!-- Register Navigation Link -->
            <div class="register-footer-text">
                Don't have an account? <a href="/Login/Register?role=User" id="registerLink">Register as User</a>
            </div>

        </div>
    </div>

    <!-- ── Right Side: Luxury Salon Showcase ── -->
    <div class="salon-showcase-panel">
        <canvas id="sparkle-canvas"></canvas>

        <div class="showcase-top-headline">
            <div class="showcase-heading-text">MANAGE . GROW . SHINE.</div>
        </div>

        <div class="floating-badges-container">
            <div class="floating-badge-item">
                <div class="badge-circle-icon"><i class="fa-solid fa-spray-can-sparkles"></i></div>
                <div class="badge-text-title">Luxury Hair & Spa</div>
            </div>
            <div class="floating-badge-item">
                <div class="badge-circle-icon"><i class="fa-solid fa-calendar-check"></i></div>
                <div class="badge-text-title">Smart VIP Bookings</div>
            </div>
            <div class="floating-badge-item">
                <div class="badge-circle-icon"><i class="fa-solid fa-gem"></i></div>
                <div class="badge-text-title">Executive Salon Portal</div>
            </div>
        </div>
    </div>

</div>

<script>
    let currentRole = '@defaultRole';

    function setRole(role) {
        currentRole = role;
        document.getElementById('userRoleInput').value = role;

        const tabUser = document.getElementById('tabUser');
        const tabStaff = document.getElementById('tabStaff');
        const btnText = document.getElementById('btnText');
        const registerLink = document.getElementById('registerLink');
        const loginSubtitleText = document.getElementById('loginSubtitleText');

        if (role === 'Staff') {
            tabStaff.className = 'role-tab-btn active staff-active';
            tabUser.className = 'role-tab-btn';
            btnText.textContent = 'Log In as Staff';
            loginSubtitleText.textContent = 'Access staff roster, client orders & shift management';
            registerLink.href = '/Login/Register?role=Staff';
            registerLink.textContent = 'Register as Staff';
        } else {
            tabUser.className = 'role-tab-btn active';
            tabStaff.className = 'role-tab-btn';
            btnText.textContent = 'Log In as User';
            loginSubtitleText.textContent = 'Access your VIP salon bookings, appointments & rewards';
            registerLink.href = '/Login/Register?role=User';
            registerLink.textContent = 'Register as User';
        }
    }


    // Initialize UI on load
    setRole(currentRole);

    // Password Visibility Toggle
    const pwInput = document.getElementById('passwordInput');
    const togglePwBtn = document.getElementById('togglePwBtn');
    const eyeIcon = document.getElementById('eyeIcon');
    const userInput = document.getElementById('usernameInput');

    togglePwBtn.addEventListener('click', () => {
        const isPw = pwInput.type === 'password';
        pwInput.type = isPw ? 'text' : 'password';
        eyeIcon.className = isPw ? 'fa-solid fa-eye-slash' : 'fa-solid fa-eye';
    });

    // Loading State
    const submitBtn = document.getElementById('submitBtn');
    const loginForm = document.getElementById('loginForm');

    loginForm.addEventListener('submit', (e) => {
        if (!userInput.value.trim() || !pwInput.value.trim()) {
            e.preventDefault();
            if (!userInput.value.trim()) userInput.focus();
            else pwInput.focus();
            return;
        }
        document.getElementById('btnText').textContent = 'Logging in as ' + currentRole + '...';
        document.getElementById('btnIcon').className = 'fa-solid fa-circle-notch fa-spin';
        submitBtn.style.opacity = '0.85';
    });

    // Sparkle Canvas
    const canvas = document.getElementById('sparkle-canvas');
    if (canvas) {
        const ctx = canvas.getContext('2d');
        let W = canvas.width = canvas.parentElement.clientWidth;
        let H = canvas.height = canvas.parentElement.clientHeight;

        window.addEventListener('resize', () => {
            if (!canvas.parentElement) return;
            W = canvas.width = canvas.parentElement.clientWidth;
            H = canvas.height = canvas.parentElement.clientHeight;
        });

        const sparkles = [];
        for (let i = 0; i < 35; i++) {
            sparkles.push({
                x: Math.random() * W,
                y: Math.random() * H,
                size: Math.random() * 3 + 1,
                alpha: Math.random(),
                speed: Math.random() * 0.02 + 0.005,
                color: Math.random() > 0.5 ? '#d4af37' : '#2dd4bf'
            });
        }

        function drawSparkles() {
            ctx.clearRect(0, 0, W, H);
            for (let s of sparkles) {
                ctx.beginPath();
                ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
                ctx.fillStyle = s.color;
                ctx.globalAlpha = Math.abs(Math.sin(s.alpha));
                ctx.fill();
                s.alpha += s.speed;
            }
            requestAnimationFrame(drawSparkles);
        }
        drawSparkles();
    }
</script>