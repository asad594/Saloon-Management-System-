@model SalonManagementSystem.Models.Login
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

@section Styles {
    <style>
        /* ── Fullscreen Split Layout ── */
        .login-split-container {
            display: flex;
            width: 100vw;
            min-height: 100vh;
            background: #0b0e14;
            overflow: hidden;
        }

        /* ── Left Side: Login Form Panel ── */
        .login-form-panel {
            width: 48%;
            min-width: 520px;
            background: linear-gradient(145deg, #131924 0%, #0e1219 100%);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 60px;
            position: relative;
            z-index: 5;
            box-shadow: 20px 0 50px rgba(0, 0, 0, 0.5);
            border-right: 1px solid var(--border-gold);
        }

        /* Gold Geometric Frame Highlights */
        .login-form-panel::before {
            content: '';
            position: absolute;
            top: 20px; left: 20px; bottom: 20px; right: 20px;
            border: 1px solid rgba(212, 175, 55, 0.12);
            border-radius: 24px;
            pointer-events: none;
        }

        .login-form-content {
            width: 100%;
            max-width: 420px;
            position: relative;
            z-index: 2;
        }

        /* Brand Logo Header */
        .brand-logo-wrapper {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 32px;
        }

        .brand-logo-icon {
            width: 44px;
            height: 44px;
            border-radius: 14px;
            background: linear-gradient(135deg, #d4af37 0%, #0d9488 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            color: #ffffff;
            box-shadow: 0 8px 20px rgba(212, 175, 55, 0.3);
        }

        .brand-logo-text {
            font-family: 'Playfair Display', serif;
            font-size: 1.75rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: -0.01em;
        }

        .brand-logo-text span {
            color: #d4af37;
        }

        /* Titles */
        .login-title {
            font-family: 'Playfair Display', serif;
            font-size: 2.2rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 8px;
            line-height: 1.2;
        }

        .login-subtitle {
            font-size: 0.9rem;
            color: var(--text-body);
            margin-bottom: 32px;
        }

        /* ── Role Selector Tabs ── */
        .role-selector-label {
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: var(--gold-accent);
            margin-bottom: 12px;
            display: block;
        }

        .role-tab-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
            margin-bottom: 28px;
        }

        .role-tab-item {
            position: relative;
            cursor: pointer;
        }

        .role-tab-item input[type="radio"] {
            position: absolute;
            opacity: 0;
            width: 0; height: 0;
        }

        .role-tab-box {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 16px;
            background: rgba(255, 255, 255, 0.03);
            border: 1.5px solid rgba(255, 255, 255, 0.08);
            border-radius: 16px;
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            user-select: none;
        }

        .role-tab-item:hover .role-tab-box {
            border-color: var(--border-gold);
            background: rgba(212, 175, 55, 0.05);
        }

        .role-tab-item input[type="radio"]:checked + .role-tab-box {
            border-color: #d4af37;
            background: linear-gradient(135deg, rgba(212, 175, 55, 0.15), rgba(13, 148, 136, 0.1));
            box-shadow: 0 0 20px rgba(212, 175, 55, 0.25);
            transform: translateY(-2px);
        }

        .role-tab-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.08);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            color: #d4af37;
            transition: transform 0.3s ease;
        }

        .role-tab-item input[type="radio"]:checked + .role-tab-box .role-tab-icon {
            background: #d4af37;
            color: #0b0e14;
            transform: scale(1.1);
        }

        .role-tab-title {
            font-size: 0.88rem;
            font-weight: 700;
            color: #ffffff;
        }

        .role-tab-sub {
            font-size: 0.7rem;
            color: var(--text-body);
        }

        /* ── Input Fields ── */
        .form-field-group {
            margin-bottom: 22px;
        }

        .field-label {
            font-size: 0.8rem;
            font-weight: 600;
            color: #e2e8f0;
            margin-bottom: 8px;
            display: block;
        }

        .field-input-wrapper {
            position: relative;
        }

        .form-control-custom {
            width: 100%;
            padding: 16px 48px 16px 48px;
            background: rgba(255, 255, 255, 0.04);
            border: 1.5px solid rgba(255, 255, 255, 0.1);
            border-radius: 14px;
            color: #ffffff;
            font-size: 0.95rem;
            outline: none;
            transition: all 0.3s ease;
        }

        .form-control-custom:focus {
            border-color: #d4af37;
            background: rgba(212, 175, 55, 0.05);
            box-shadow: 0 0 0 4px rgba(212, 175, 55, 0.15);
        }

        .field-icon-left {
            position: absolute;
            left: 18px;
            top: 50%;
            transform: translateY(-50%);
            color: #d4af37;
            font-size: 1rem;
            pointer-events: none;
        }

        .field-icon-right-btn {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: var(--text-body);
            cursor: pointer;
            font-size: 1rem;
            padding: 4px;
            transition: color 0.2s ease;
        }

        .field-icon-right-btn:hover {
            color: #d4af37;
        }

        /* Remember & Forgot Password */
        .form-utility-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 28px;
            font-size: 0.82rem;
        }

        .remember-checkbox {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--text-body);
            cursor: pointer;
        }

        .remember-checkbox input {
            accent-color: #d4af37;
            width: 16px;
            height: 16px;
        }

        .forgot-link {
            color: #d4af37;
            text-decoration: none;
            font-weight: 600;
            transition: opacity 0.2s ease;
        }

        .forgot-link:hover {
            opacity: 0.8;
            text-decoration: underline;
        }

        /* ── Submit Button (Teal-to-Gold Gradient like Screenshot) ── */
        .btn-gradient-submit {
            width: 100%;
            padding: 16px;
            background: linear-gradient(90deg, #0d9488 0%, #14b8a6 40%, #d4af37 100%);
            border: none;
            border-radius: 50px;
            color: #ffffff;
            font-size: 1rem;
            font-weight: 700;
            letter-spacing: 0.02em;
            cursor: pointer;
            transition: all 0.35s ease;
            box-shadow: 0 10px 28px rgba(13, 148, 136, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            position: relative;
            overflow: hidden;
        }

        .btn-gradient-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 36px rgba(212, 175, 55, 0.45);
        }

        .btn-gradient-submit:active {
            transform: translateY(0);
        }

        /* One-Click Quick Pills */
        .quick-pills-row {
            margin-top: 24px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .demo-pill-btn {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(212, 175, 55, 0.3);
            border-radius: 50px;
            padding: 6px 14px;
            font-size: 0.76rem;
            font-weight: 600;
            color: var(--text-body);
            cursor: pointer;
            transition: all 0.25s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .demo-pill-btn:hover {
            background: rgba(212, 175, 55, 0.15);
            color: #ffffff;
            transform: translateY(-2px);
        }

        .demo-pill-btn i {
            color: #d4af37;
        }

        /* Error Banner */
        .error-banner {
            background: rgba(244, 63, 94, 0.15);
            border: 1px solid rgba(244, 63, 94, 0.4);
            border-radius: 12px;
            padding: 12px 16px;
            color: #fca5a5;
            font-size: 0.85rem;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 20px;
            animation: shake 0.4s ease;
        }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-6px); }
            40% { transform: translateX(6px); }
            60% { transform: translateX(-4px); }
            80% { transform: translateX(4px); }
        }

        /* ── Right Side: Women's Luxury Salon Showcase ── */
        .salon-showcase-panel {
            width: 52%;
            position: relative;
            background: url('/images/salon_showcase.png') center center / cover no-repeat;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 60px;
            overflow: hidden;
        }

        /* Dark Vignette Overlay */
        .salon-showcase-panel::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(180deg, rgba(11, 14, 20, 0.75) 0%, rgba(11, 14, 20, 0.25) 50%, rgba(11, 14, 20, 0.85) 100%);
            z-index: 1;
        }

        /* Overlay Animated Headline */
        .showcase-top-headline {
            position: relative;
            z-index: 2;
            text-align: center;
        }

        .showcase-heading-text {
            font-size: 2.2rem;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            text-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
        }

        /* Floating Glowing Feature Badges */
        .floating-badges-container {
            position: relative;
            z-index: 2;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
            margin-bottom: 40px;
        }

        .floating-badge-item {
            background: rgba(19, 25, 36, 0.75);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(45, 212, 191, 0.4);
            border-radius: 50px;
            padding: 12px 24px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 10px 30px rgba(13, 148, 136, 0.3);
            animation: floatBadge 4s ease-in-out infinite alternate;
        }

        .floating-badge-item:nth-child(2) { animation-delay: -1.5s; }
        .floating-badge-item:nth-child(3) { animation-delay: -3s; }

        @@keyframes floatBadge {
            0% { transform: translateY(0); }
            100% { transform: translateY(-10px); }
        }

        .badge-circle-icon {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg, #14b8a6, #d4af37);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 1rem;
            box-shadow: 0 0 15px rgba(20, 184, 166, 0.6);
        }

        .badge-text-title {
            font-size: 0.88rem;
            font-weight: 700;
            color: #ffffff;
        }

        /* Sparkle Canvas Overlay */
        #sparkle-canvas {
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
        }

        /* Responsive Breakpoint */
        @@media (max-width: 1024px) {
            .salon-showcase-panel {
                display: none; /* Mobile view cleanly focuses on the login form */
            }
            .login-form-panel {
                width: 100%;
                min-width: 100%;
                border-right: none;
            }
        }
    </style>
}

<div class="login-split-container">

    <!-- ── Left Side: Login Form ── -->
    <div class="login-form-panel">
        <div class="login-form-content">

            <!-- Brand Logo -->
            <div class="brand-logo-wrapper">
                <div class="brand-logo-icon">
                    <i class="fa-solid fa-scissors"></i>
                </div>
                <div class="brand-logo-text">Glamour<span>Sync</span></div>
            </div>

            <!-- Welcome Title -->
            <h1 class="login-title" id="welcomeTitle">Welcome to GlamourSync</h1>
            <p class="login-subtitle" id="welcomeSubtitle">Login to your Luxury Management Portal</p>

            <!-- Login Form -->
            <form method="post" id="loginForm" novalidate>

                <!-- Role Selector Tabs -->
                <span class="role-selector-label">Select Portal Access</span>
                <div class="role-tab-grid">
                    <label class="role-tab-item">
                        <input type="radio" name="UserRole" value="Admin" id="roleAdmin"
                               @(ViewBag.Error == null ? "checked" : (Model?.UserRole == "Admin" ? "checked" : "")) />
                        <div class="role-tab-box">
                            <div class="role-tab-icon">
                                <i class="fa-solid fa-crown"></i>
                            </div>
                            <div>
                                <div class="role-tab-title">Admin</div>
                                <div class="role-tab-sub">Full Portal</div>
                            </div>
                        </div>
                    </label>

                    <label class="role-tab-item">
                        <input type="radio" name="UserRole" value="Staff" id="roleStaff"
                               @(Model?.UserRole == "Staff" ? "checked" : "") />
                        <div class="role-tab-box">
                            <div class="role-tab-icon">
                                <i class="fa-solid fa-wand-magic-sparkles"></i>
                            </div>
                            <div>
                                <div class="role-tab-title">Staff</div>
                                <div class="role-tab-sub">Appointments</div>
                            </div>
                        </div>
                    </label>
                </div>

                <!-- Error Alert -->
                @if (!string.IsNullOrEmpty(ViewBag.Error as string))
                {
                    <div class="error-banner">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        <span>@ViewBag.Error</span>
                    </div>
                }

                <!-- Password Input -->
                <div class="form-field-group">
                    <label class="field-label" for="passwordInput">Password</label>
                    <div class="field-input-wrapper">
                        <input type="password" id="passwordInput" name="UserPassword" class="form-control-custom"
                               placeholder="Enter your security password..." required autocomplete="current-password" />
                        <i class="fa-solid fa-lock field-icon-left"></i>
                        <button type="button" class="field-icon-right-btn" id="togglePwBtn" title="Show/Hide password">
                            <i class="fa-solid fa-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                </div>

                <!-- Remember & Forgot Password -->
                <div class="form-utility-row">
                    <label class="remember-checkbox">
                        <input type="checkbox" checked /> Remember Me
                    </label>
                    <a href="#" class="forgot-link" onclick="Swal.fire({icon:'info', title:'Password Reset', text:'Please contact system administrator to reset password credentials.', background:'#131924', color:'#fff', iconColor:'#d4af37'}); return false;">Forgot Password?</a>
                </div>

                <!-- Submit Button (Teal-to-Gold Gradient) -->
                <button type="submit" class="btn-gradient-submit" id="submitBtn">
                    <span id="btnText">Log In</span>
                    <i class="fa-solid fa-arrow-right" id="btnIcon"></i>
                </button>

            </form>

            <!-- Quick Demo Credentials Pills -->
            <div class="quick-pills-row">
                <button type="button" class="demo-pill-btn" onclick="quickFill('Admin', '123')">
                    <i class="fa-solid fa-crown"></i> Admin (123)
                </button>
                <button type="button" class="demo-pill-btn" onclick="quickFill('Staff', '987')">
                    <i class="fa-solid fa-wand-magic-sparkles"></i> Staff (987)
                </button>
            </div>

        </div>
    </div>

    <!-- ── Right Side: Luxury Women's Salon Showcase ── -->
    <div class="salon-showcase-panel">
        <canvas id="sparkle-canvas"></canvas>

        <!-- Top Headline -->
        <div class="showcase-top-headline">
            <div class="showcase-heading-text">MANAGE . GROW . SHINE.</div>
        </div>

        <!-- Floating Feature Badges Overlaid over Salon Image -->
        <div class="floating-badges-container">
            <div class="floating-badge-item">
                <div class="badge-circle-icon">
                    <i class="fa-solid fa-spray-can-sparkles"></i>
                </div>
                <div class="badge-text-title">Luxury Hair & Styling</div>
            </div>

            <div class="floating-badge-item">
                <div class="badge-circle-icon">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
                <div class="badge-text-title">Smart Appointments</div>
            </div>

            <div class="floating-badge-item">
                <div class="badge-circle-icon">
                    <i class="fa-solid fa-gem"></i>
                </div>
                <div class="badge-text-title">VIP Client Experience</div>
            </div>
        </div>
    </div>

</div>

<script>
    // ── Role UI Updates ──
    const roleAdmin = document.getElementById('roleAdmin');
    const roleStaff = document.getElementById('roleStaff');
    const welcomeTitle = document.getElementById('welcomeTitle');
    const welcomeSubtitle = document.getElementById('welcomeSubtitle');

    function updateRoleText() {
        if (roleStaff.checked) {
            welcomeTitle.textContent = 'Welcome to GlamourSync';
            welcomeSubtitle.textContent = 'Staff Shift & Appointment Portal';
        } else {
            welcomeTitle.textContent = 'Welcome to GlamourSync';
            welcomeSubtitle.textContent = 'Login to your Luxury Management Portal';
        }
    }

    roleAdmin.addEventListener('change', updateRoleText);
    roleStaff.addEventListener('change', updateRoleText);

    // ── Password Visibility Toggle ──
    const pwInput = document.getElementById('passwordInput');
    const togglePwBtn = document.getElementById('togglePwBtn');
    const eyeIcon = document.getElementById('eyeIcon');

    togglePwBtn.addEventListener('click', () => {
        const isPw = pwInput.type === 'password';
        pwInput.type = isPw ? 'text' : 'password';
        eyeIcon.className = isPw ? 'fa-solid fa-eye-slash' : 'fa-solid fa-eye';
    });

    // ── Quick Autofill ──
    function quickFill(role, pass) {
        if (role === 'Admin') roleAdmin.checked = true;
        else roleStaff.checked = true;
        updateRoleText();

        pwInput.value = '';
        let i = 0;
        const interval = setInterval(() => {
            if (i < pass.length) {
                pwInput.value += pass.charAt(i);
                i++;
            } else {
                clearInterval(interval);
                pwInput.focus();
            }
        }, 80);
    }

    // ── Loading state on Submit ──
    const submitBtn = document.getElementById('submitBtn');
    const loginForm = document.getElementById('loginForm');

    loginForm.addEventListener('submit', (e) => {
        if (!pwInput.value.trim()) {
            e.preventDefault();
            pwInput.focus();
            return;
        }
        document.getElementById('btnText').textContent = 'Logging in...';
        document.getElementById('btnIcon').className = 'fa-solid fa-circle-notch fa-spin';
        submitBtn.style.opacity = '0.85';
    });

    // ── Sparkle Particle Effects on Right Panel ──
    const canvas = document.getElementById('sparkle-canvas');
    if (canvas) {
        const ctx = canvas.getContext('2d');
        let W = canvas.width = canvas.parentElement.clientWidth;
        let H = canvas.height = canvas.parentElement.clientHeight;

        window.addEventListener('resize', () => {
            if (!canvas.parentElement) return;
            W = canvas.width = canvas.parentElement.clientWidth;
            H = canvas.height = canvas.parentElement.clientHeight;
        });

        const sparkles = [];
        for (let i = 0; i < 40; i++) {
            sparkles.push({
                x: Math.random() * W,
                y: Math.random() * H,
                size: Math.random() * 3 + 1,
                alpha: Math.random(),
                speed: Math.random() * 0.02 + 0.005,
                color: Math.random() > 0.5 ? '#d4af37' : '#2dd4bf'
            });
        }

        function drawSparkles() {
            ctx.clearRect(0, 0, W, H);
            for (let s of sparkles) {
                ctx.beginPath();
                ctx.arc(s.x, s.y, s.size, 0, Math.PI * 2);
                ctx.fillStyle = s.color;
                ctx.globalAlpha = Math.abs(Math.sin(s.alpha));
                ctx.fill();
                s.alpha += s.speed;
            }
            requestAnimationFrame(drawSparkles);
        }
        drawSparkles();
    }
</script>